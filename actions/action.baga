// actions/action.baga — помощници за хендлъри (JSON изход, автентикация, права).

import "../http.baga"
import "fmrbaga/respond.baga"
import "fmrbaga/jsonx.baga"
import "fmrbaga/deps.baga"
import "fmrbaga/ctx.baga"
import "../model_user.baga"
import "../model_company.baga"
import "std/json/json.baga"
import "std/str/str.baga"

struct BnActAuth {
    ok: i64,
    ctx: FmrCtx,
    out: BnOut
}

fn bn_act_ok(db: DrokDB, o: JObj) -> BnOut {
    return bn_out(fmr_ok_obj(o), db)
}

fn bn_act_created(db: DrokDB, o: JObj) -> BnOut {
    return bn_out(fmr_created_obj(o), db)
}

fn bn_act_no_content(db: DrokDB) -> BnOut {
    return bn_out(fmr_no_content(), db)
}

fn bn_act_err(db: DrokDB, status: i64, detail: str) -> BnOut {
    return bn_out(fmr_error(status, detail), db)
}

fn bn_act_404(db: DrokDB, detail: str) -> BnOut {
    return bn_act_err(db, 404, detail)
}

fn bn_act_msg(db: DrokDB, msg: str) -> BnOut {
    let mut o = jobj_new()
    o = jobj_str(o, "message", msg)
    return bn_act_ok(db, o)
}

// Bearer JWT → ctx.user_sub.
fn bn_act_auth(ctx: FmrCtx, db: DrokDB) -> BnActAuth {
    let d = deps_bearer(ctx)
    if d.ok == 0 {
        return BnActAuth { ok: 0, ctx: ctx, out: bn_out(d.resp, db) }
    }
    return BnActAuth { ok: 1, ctx: d.ctx, out: bn_out(fmr_json(200, "{}"), db) }
}

// Активна фирма за потребителя: bn:act:<email>, иначе първата фирма.
fn bn_act_company(db: DrokDB, ctx: FmrCtx) -> BnCompany !Net !IO {
    let co = bn_act_get(db, ctx.user_sub)?
    if co > 0 {
        return bn_co_load(db, co)?
    }
    return bn_co_first(db)?
}

// Автентикация + права (1=четене 2=проводки 3=управление 4=админ).
fn bn_act_require(ctx: FmrCtx, db: DrokDB, need: i64) -> BnActAuth !Net !IO {
    let a = bn_act_auth(ctx, db)
    if a.ok == 0 {
        return a
    }
    let u = bn_user_load(db, a.ctx.user_sub)?
    if u.email == "" {
        return BnActAuth { ok: 0, ctx: a.ctx, out: bn_act_err(db, 401, "непознат потребител") }
    }
    let co = bn_act_company(db, a.ctx)?
    if co.id <= 0 {
        return BnActAuth { ok: 0, ctx: a.ctx, out: bn_act_err(db, 409, "няма фирма — създай с POST /v1/companies") }
    }
    let role = bn_role_effective(db, co.id, u)?
    if bn_role_can(role, need) == 0 {
        return BnActAuth { ok: 0, ctx: a.ctx, out: bn_act_err(db, 403, "недостатъчни права") }
    }
    return BnActAuth { ok: 1, ctx: a.ctx, out: bn_out(fmr_json(200, "{}"), db) }
}

struct BnActPage {
    limit: i64,
    offset: i64
}

fn bn_act_page(ctx: FmrCtx, default_limit: i64, max_limit: i64) -> BnActPage {
    let mut lim = default_limit
    let mut off: i64 = 0
    let ls = fmr_query(ctx, "limit")
    if ls != "" {
        lim = parse_int(ls)
    }
    let os = fmr_query(ctx, "offset")
    if os != "" {
        off = parse_int(os)
    }
    if lim < 1 {
        lim = default_limit
    }
    if lim > max_limit {
        lim = max_limit
    }
    if off < 0 {
        off = 0
    }
    return BnActPage { limit: lim, offset: off }
}

// Списък с пагинация в тялото на отговора.
fn bn_act_page_wrap(items: JArr, count: i64, page: BnActPage) -> JObj {
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(items))
    o = jobj_i64(o, "count", count)
    o = jobj_i64(o, "limit", page.limit)
    o = jobj_i64(o, "offset", page.offset)
    return o
}

fn bn_act_body(ctx: FmrCtx) -> JsonDoc {
    return bn_j_body(fmr_body(ctx))
}

// 422 по поле (jsonx формат).
fn bn_act_422(db: DrokDB, field: str, f: JField) -> BnOut {
    return bn_out(fmr_422_jfield(field, f), db)
}
