// actions/system.baga — health, ready, meta.

import "action.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"

fn act_health(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let mut o = jobj_new()
    o = jobj_str(o, "status", "ok")
    o = jobj_str(o, "app", "buchnative")
    return bn_act_ok(db, o)
}

fn act_ready(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    if bn_ok(db) == 0 {
        return bn_act_err(db, 503, bn_err(db))
    }
    if bn_ping(db)? == 0 {
        return bn_act_err(db, 503, "rocksbaga не отговаря")
    }
    return bn_act_msg(db, "ready")
}

fn act_meta(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let mut o = jobj_new()
    o = jobj_str(o, "app", "buchnative")
    o = jobj_str(o, "version", fmr_version(ctx))
    o = jobj_str(o, "title", fmr_title(ctx))
    return bn_act_ok(db, o)
}
