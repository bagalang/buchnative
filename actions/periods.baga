// actions/periods.baga — периоди: списък, затваряне, отваряне.

import "action.baga"
import "fmrbaga/jsonx.baga"
import "../model_period.baga"
import "std/json/json.baga"
import "std/str/str.baga"

fn act_periods_index(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let a = bn_act_require(ctx, db, BN_R_READ())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let ps = bn_per_all(db, co.id)?
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < vec_len(ps) {
        arr = jarr_obj(arr, bn_per_to_json(vec_get(ps, i)))
        i = i + 1
    }
    let o = bn_act_page_wrap(arr, vec_len(ps), bn_act_page(ctx, 24, 60))
    return bn_act_ok(db, o)
}

fn act_periods_close(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let a = bn_act_require(ctx, db, BN_R_MANAGE())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let period = fmr_param(ctx, "period")
    if period == "" {
        return bn_act_err(db, 400, "невалиден период")
    }
    bn_per_close(db, co.id, period)?
    return bn_act_ok(db, bn_per_to_json(bn_per_load(db, co.id, period)?))
}

fn act_periods_reopen(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let a = bn_act_require(ctx, db, BN_R_MANAGE())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let period = fmr_param(ctx, "period")
    if period == "" {
        return bn_act_err(db, 400, "невалиден период")
    }
    bn_per_reopen(db, co.id, period)?
    return bn_act_ok(db, bn_per_to_json(bn_per_load(db, co.id, period)?))
}
