// actions/opening.baga — начални салда за фискална година.

import "action.baga"
import "fmrbaga/jsonx.baga"
import "../model_opening.baga"
import "../model_account.baga"
import "../json.baga"
import "../time.baga"
import "std/json/json.baga"
import "std/str/str.baga"

fn act_opening_index(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net !Time {
    let a = bn_act_require(ctx, db, BN_R_READ())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let mut year = fmr_query(ctx, "year")
    if year == "" {
        year = substr(bn_today()?, 0, 4)
    }
    let obs = bn_ob_all(db, co.id, year)?
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < vec_len(obs) {
        arr = jarr_obj(arr, bn_ob_to_json(vec_get(obs, i)))
        i = i + 1
    }
    let mut o = bn_act_page_wrap(arr, vec_len(obs), bn_act_page(ctx, 200, 1000))
    o = jobj_str(o, "year", year)
    return bn_act_ok(db, o)
}

fn act_opening_upsert(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let a = bn_act_require(ctx, db, BN_R_MANAGE())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let d = bn_act_body(ctx)
    let b = bn_j_root(d)
    let year = bn_j_str(d, b, "year")
    let account = bn_j_str(d, b, "account")
    if year == "" || account == "" {
        return bn_act_err(db, 422, "year и account са задължителни")
    }
    if bn_ac_exists(db, co.id, account)? == 0 {
        return bn_act_404(db, concat("няма сметка ", account))
    }
    let o = BnOpening { company: co.id, year: year, account: account, debit: bn_money_round2(bn_j_str(d, b, "debit")), credit: bn_money_round2(bn_j_str(d, b, "credit")) }
    bn_ob_save(db, o)?
    return bn_act_ok(db, bn_ob_to_json(o))
}

fn act_opening_delete(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net !Time {
    let a = bn_act_require(ctx, db, BN_R_MANAGE())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let mut year = fmr_query(ctx, "year")
    if year == "" {
        year = substr(bn_today()?, 0, 4)
    }
    let account = fmr_param(ctx, "account")
    if bn_exists(db, bn_k_ob(co.id, account, year))? == 0 {
        return bn_act_404(db, "няма такова начално салдо")
    }
    bn_ob_delete(db, co.id, account, year)?
    return bn_act_no_content(db)
}
