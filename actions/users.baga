// actions/users.baga — потребители и роли в активната фирма.

import "action.baga"
import "fmrbaga/jsonx.baga"
import "../model_user.baga"
import "../model_company.baga"
import "../json.baga"
import "../time.baga"
import "std/json/json.baga"
import "std/random/random.baga"
import "std/str/str.baga"

fn act_users_index(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let a = bn_act_require(ctx, db, BN_R_ADMIN())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let users = bn_user_all(db)?
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < vec_len(users) {
        let u = vec_get(users, i)
        let role = bn_role_effective(db, co.id, u)?
        let mut o = jobj_new()
        o = jobj_str(o, "email", u.email)
        o = jobj_str(o, "name", u.name)
        o = jobj_i64(o, "is_active", u.is_active)
        o = jobj_i64(o, "is_super_admin", u.is_super_admin)
        o = jobj_str(o, "role", role)
        o = jobj_str(o, "created_at", u.created_at)
        arr = jarr_obj(arr, o)
        i = i + 1
    }
    let mut o = bn_act_page_wrap(arr, vec_len(users), bn_act_page(ctx, 100, 500))
    o = jobj_i64(o, "company", co.id)
    return bn_act_ok(db, o)
}

fn act_users_create(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net !Time !Random {
    let a = bn_act_require(ctx, db, BN_R_ADMIN())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let d = bn_act_body(ctx)
    let b = bn_j_root(d)
    let email = bn_j_str(d, b, "email")
    let password = bn_j_str(d, b, "password")
    if email == "" || password == "" {
        return bn_act_err(db, 422, "email и password са задължителни")
    }
    if bn_user_exists(db, email)? == 1 {
        return bn_act_err(db, 409, "потребителят вече съществува")
    }
    let hash = bn_user_new_hash(password)?
    let u = BnUser { email: email, name: bn_j_str(d, b, "name"), pass_hash: hash, is_active: 1, is_super_admin: 0, created_at: bn_now_iso()? }
    bn_user_save(db, u)?
    let role = bn_j_str(d, b, "role")
    if role == "" {
        bn_role_set(db, co.id, email, "accountant")?
    } else {
        bn_role_set(db, co.id, email, role)?
    }
    let mut o = jobj_new()
    o = jobj_str(o, "email", u.email)
    o = jobj_str(o, "name", u.name)
    o = jobj_str(o, "role", bn_role_get(db, co.id, email)?)
    o = jobj_str(o, "created_at", u.created_at)
    return bn_act_created(db, o)
}

fn act_users_role(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let a = bn_act_require(ctx, db, BN_R_ADMIN())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let email = fmr_param(ctx, "email")
    if bn_user_exists(db, email)? == 0 {
        return bn_act_404(db, "няма такъв потребител")
    }
    let d = bn_act_body(ctx)
    let b = bn_j_root(d)
    let role = bn_j_str(d, b, "role")
    if bn_role_rank(role) < 1 {
        return bn_act_err(db, 422, "role трябва да е viewer/accountant/admin/super_admin")
    }
    bn_role_set(db, co.id, email, role)?
    let mut o = jobj_new()
    o = jobj_str(o, "email", email)
    o = jobj_str(o, "role", role)
    o = jobj_i64(o, "company", co.id)
    return bn_act_ok(db, o)
}

fn act_roles_index(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net {
    let a = bn_act_require(ctx, db, BN_R_ADMIN())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let keys = bn_scan_key_strs(db, concat("bn:role:", int_to_str(co.id)))?
    let prefix = concat("bn:role:", int_to_str(co.id))
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < vec_len(keys) {
        let key = vec_get(keys, i)
        let email = substr(key, len(prefix) + 1, len(key))
        let mut o = jobj_new()
        o = jobj_str(o, "email", email)
        o = jobj_str(o, "role", bn_get_str(db, key)?)
        arr = jarr_obj(arr, o)
        i = i + 1
    }
    let mut o = bn_act_page_wrap(arr, vec_len(keys), bn_act_page(ctx, 100, 500))
    o = jobj_i64(o, "company", co.id)
    return bn_act_ok(db, o)
}
