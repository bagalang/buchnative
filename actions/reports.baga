// actions/reports.baga — счетоводни отчети: оборотна ведомост, главна книга,
// НСС1 (резултат) и НСС2 (баланс).

import "action.baga"
import "fmrbaga/jsonx.baga"
import "../report_trial.baga"
import "../report_ledger.baga"
import "../report_fs.baga"
import "../model_account.baga"
import "../time.baga"
import "std/json/json.baga"
import "std/str/str.baga"

fn bn_rep_period(ctx: FmrCtx, db: DrokDB) -> str !Net !IO !Time {
    let p = fmr_query(ctx, "period")
    if p != "" {
        return p
    }
    return bn_today_period()?
}

fn act_report_trial(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net !Time {
    let a = bn_act_require(ctx, db, BN_R_READ())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let period = bn_rep_period(ctx, db)?
    return bn_act_ok(db, bn_trial_json(db, co.id, period)?)
}

fn act_report_trial_year(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net !Time {
    let a = bn_act_require(ctx, db, BN_R_READ())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let mut year = fmr_query(ctx, "year")
    if year == "" {
        year = substr(bn_today()?, 0, 4)
    }
    return bn_act_ok(db, bn_trial_year_json(db, co.id, year)?)
}

fn act_report_ledger(ctx: FmrCtx, db: DrokDB) -> BnOut !IO !Net !Time {
    let a = bn_act_require(ctx, db, BN_R_READ())
    if a.ok == 0 {
        return a.out
    }
    let co = bn_act_company(db, ctx)?
    let account = fmr_query(ctx, "account")
    if account == "" {
        return bn_act_err(db, 422, "account е задължителен")
    }
    if bn_ac_exists(db, co.id, account)? == 0 {
        return bn_act_404(db, concat("няма сметка ", account))
    }
    let period = bn_rep_period(ctx, db)?
    return bn_act_ok(db, bn_ledger_json(db, co.id, account, period)?)
}

