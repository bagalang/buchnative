// model_journal_query.baga — четене на записи и сторниране.
//
// Записът е непроменим. Корекция става с обратна проводка (стorno), която е
// нов запис — хронологията остава пълна.

import "store.baga"
import "store_scan.baga"
import "json.baga"
import "model_journal.baga"
import "model_period.baga"
import "std/json/json.baga"
import "std/str/str.baga"

fn bn_je_get(db: DrokDB, co: i64, period: str, number: i64) -> BnEntry !Net !IO {
    let s = bn_get_str(db, bn_k_je(co, period, number))?
    if s == "" {
        return bn_entry_zero()
    }
    let d = json_parse(s)
    return bn_entry_from_json(d, bn_j_root(d))
}

// Записи в период, подредени по номер (zero-padded ключ).
fn bn_je_list(db: DrokDB, co: i64, period: str) -> Vec<BnEntry> !Net !IO {
    let keys = bn_scan_key_strs(db, bn_k_je_prefix(co, period))?
    let out: Vec<BnEntry> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(keys) {
        let suffix = substr(vec_get(keys, i), len(bn_k_je_prefix(co, period)), len(vec_get(keys, i)))
        let e = bn_je_get(db, co, period, parse_int(suffix))?
        if e.number > 0 {
            vec_push(out, e)
        }
        i = i + 1
    }
    return out
}

fn bn_je_count(db: DrokDB, co: i64, period: str) -> i64 !Net !IO {
    return vec_len(bn_je_list(db, co, period)?)
}

// Сторнира: нов запис с разменени дебит/кредит.
fn bn_je_reverse(db: DrokDB, co: i64, period: str, number: i64, created_by: str, created_at: str) -> BnResult !Net !IO !Par {
    let e = bn_je_get(db, co, period, number)?
    if e.number <= 0 {
        return bn_res_err("няма такъв запис")
    }
    if bn_per_is_open(db, co, period)? == 0 {
        return bn_res_err(concat("период ", concat(period, " е затворен")))
    }
    let inv: Vec<BnLine> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(e.lines) {
        let l = vec_get(e.lines, i)
        let nl = bn_line_zero()
        nl.account = l.account
        nl.debit = l.credit
        nl.credit = l.debit
        nl.counterpart = l.counterpart
        nl.note = "стorno"
        vec_push(inv, nl)
        i = i + 1
    }
    return bn_je_post(db, co, e.date, "storno", int_to_str(number), concat("Сторно на запис ", int_to_str(number)), inv, created_by, created_at)?
}
