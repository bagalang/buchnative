// model_invoice.baga — фактури (продажби и доставки) с автопроводка.
//
// Сумата на ред е количество × цена (без ДДС); ДДС се начислява по процент
// и се добавя в общата сума. Проводката се генерира от фактурата:
//   продажба:  Дт 211 вземания / Кт 701 приходи + Кт 521 ДДС
//   доставка:  Дт 601 разходи + Дт 521 ДДС / Кт 501 задължения

import "store.baga"
import "json.baga"
import "money.baga"
import "fmrbaga/jsonx.baga"
import "model_counterpart.baga"
import "model_journal.baga"
import "std/json/json.baga"
import "std/str/str.baga"

// Сметки по подразбиране (могат да се сменят от настройки на фирмата).
fn BN_ACC_RECEIVABLE() -> str { return "211" }
fn BN_ACC_PAYABLE() -> str { return "501" }
fn BN_ACC_INCOME() -> str { return "701" }
fn BN_ACC_EXPENSE() -> str { return "601" }
fn BN_ACC_VAT() -> str { return "521" }

struct BnInvoiceLine {
    name: str,
    qty: str,
    unit: str,
    price: str,
    vat_pct: str,
    amount: str,
    vat: str,
    total: str
}

struct BnInvoice {
    id: i64,
    company: i64,
    number: str,
    kind: str,
    date: str,
    period: str,
    counterpart: i64,
    counterpart_name: str,
    lines: Vec<BnInvoiceLine>,
    net: str,
    vat: str,
    total: str,
    journal_entry: i64,
    status: str,
    created_at: str
}

fn bn_inv_line_zero() -> BnInvoiceLine {
    return BnInvoiceLine { name: "", qty: "0.00", unit: "бр", price: "0.00", vat_pct: "20.00", amount: "0.00", vat: "0.00", total: "0.00" }
}

fn bn_inv_line_from_json(d: JsonDoc, root: i64) -> BnInvoiceLine {
    let l = bn_inv_line_zero()
    l.name = bn_j_str(d, root, "name")
    l.qty = bn_money_round2(bn_j_str(d, root, "qty"))
    l.unit = bn_j_str(d, root, "unit")
    l.price = bn_money_round2(bn_j_str(d, root, "price"))
    l.vat_pct = bn_money_round2(bn_j_str(d, root, "vat_pct"))
    return l
}

fn bn_inv_line_to_json(l: BnInvoiceLine) -> JObj {
    let mut o = jobj_new()
    o = jobj_str(o, "name", l.name)
    o = jobj_str(o, "qty", l.qty)
    o = jobj_str(o, "unit", l.unit)
    o = jobj_str(o, "price", l.price)
    o = jobj_str(o, "vat_pct", l.vat_pct)
    o = jobj_str(o, "amount", bn_money_round2(l.amount))
    o = jobj_str(o, "vat", bn_money_round2(l.vat))
    o = jobj_str(o, "total", bn_money_round2(l.total))
    return o
}

fn bn_inv_lines_to_json(lines: Vec<BnInvoiceLine>) -> JArr {
    let mut a = jarr_new()
    let mut i: i64 = 0
    while i < vec_len(lines) {
        a = jarr_obj(a, bn_inv_line_to_json(vec_get(lines, i)))
        i = i + 1
    }
    return a
}

fn bn_inv_lines_from_json(d: JsonDoc, arr: i64) -> Vec<BnInvoiceLine> {
    let out: Vec<BnInvoiceLine> = vec_new()
    if arr < 0 {
        return out
    }
    let n = bn_j_count(d, arr)
    let mut i: i64 = 0
    while i < n {
        let node = bn_j_item(d, arr, i)
        if node >= 0 && json_tag(d, node) == 6 {
            vec_push(out, bn_inv_line_from_json(d, node))
        }
        i = i + 1
    }
    return out
}

fn bn_inv_zero() -> BnInvoice {
    return BnInvoice { id: 0, company: 0, number: "", kind: "sale", date: "", period: "", counterpart: 0, counterpart_name: "", lines: vec_new(), net: "0.00", vat: "0.00", total: "0.00", journal_entry: 0, status: "draft", created_at: "" }
}

fn bn_inv_from_json(d: JsonDoc, root: i64) -> BnInvoice {
    let v = bn_inv_zero()
    v.id = bn_j_i64(d, root, "id")
    v.company = bn_j_i64(d, root, "company")
    v.number = bn_j_str(d, root, "number")
    v.kind = bn_j_str(d, root, "kind")
    v.date = bn_j_str(d, root, "date")
    v.period = bn_j_str(d, root, "period")
    v.counterpart = bn_j_i64(d, root, "counterpart")
    v.counterpart_name = bn_j_str(d, root, "counterpart_name")
    v.lines = bn_inv_lines_from_json(d, bn_j_child(d, root, "lines"))
    v.net = bn_money_round2(bn_j_str(d, root, "net"))
    v.vat = bn_money_round2(bn_j_str(d, root, "vat"))
    v.total = bn_money_round2(bn_j_str(d, root, "total"))
    v.journal_entry = bn_j_i64(d, root, "journal_entry")
    let st = bn_j_str(d, root, "status")
    if st == "" {
        v.status = "draft"
    } else {
        v.status = st
    }
    v.created_at = bn_j_str(d, root, "created_at")
    return v
}

fn bn_inv_to_json(v: BnInvoice) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", v.id)
    o = jobj_i64(o, "company", v.company)
    o = jobj_str(o, "number", v.number)
    o = jobj_str(o, "kind", v.kind)
    o = jobj_str(o, "date", v.date)
    o = jobj_str(o, "period", v.period)
    o = jobj_i64(o, "counterpart", v.counterpart)
    o = jobj_str(o, "counterpart_name", v.counterpart_name)
    o = jobj_arr(o, "lines", bn_inv_lines_to_json(v.lines))
    o = jobj_str(o, "net", v.net)
    o = jobj_str(o, "vat", v.vat)
    o = jobj_str(o, "total", v.total)
    o = jobj_i64(o, "journal_entry", v.journal_entry)
    o = jobj_str(o, "status", v.status)
    o = jobj_str(o, "created_at", v.created_at)
    return o
}

fn bn_inv_json_str(v: BnInvoice) -> str {
    return jobj_encode(bn_inv_to_json(v))
}

// Преизчислява редовете и общите суми на локално копие.
fn bn_inv_recompute(v: BnInvoice) -> BnInvoice {
    let mut i: i64 = 0
    while i < vec_len(v.lines) {
        let l = vec_get(v.lines, i)
        let amount = bn_money_mul(l.qty, l.price)
        let vat = bn_money_percent(amount, l.vat_pct)
        l.amount = bn_money_round2(amount)
        l.vat = bn_money_round2(vat)
        l.total = bn_money_add(l.amount, l.vat)
        vec_set(v.lines, i, l)
        i = i + 1
    }
    let amounts: Vec<str> = vec_new()
    let vats: Vec<str> = vec_new()
    let mut j: i64 = 0
    while j < vec_len(v.lines) {
        let l = vec_get(v.lines, j)
        vec_push(amounts, l.amount)
        vec_push(vats, l.vat)
        j = j + 1
    }
    v.net = bn_money_round2(bn_money_sum(amounts))
    v.vat = bn_money_round2(bn_money_sum(vats))
    v.total = bn_money_add(v.net, v.vat)
    return v
}

fn bn_inv_load(db: DrokDB, co: i64, id: i64) -> BnInvoice !Net !IO {
    let s = bn_get_str(db, bn_k_inv(co, id))?
    if s == "" {
        return bn_inv_zero()
    }
    let d = json_parse(s)
    return bn_inv_from_json(d, bn_j_root(d))
}

fn bn_inv_exists(db: DrokDB, co: i64, id: i64) -> i64 !Net !IO {
    return bn_exists(db, bn_k_inv(co, id))?
}

fn bn_inv_load_by_number(db: DrokDB, co: i64, number: str) -> BnInvoice !Net !IO {
    let raw = bn_get_str(db, bn_k_inv_num(co, number))?
    if raw == "" {
        return bn_inv_zero()
    }
    return bn_inv_load(db, co, parse_int(raw))?
}

fn bn_inv_save(db: DrokDB, co: i64, v: BnInvoice) -> i64 !Net !IO {
    let ids = bn_list_parse(bn_get_str(db, bn_k_inv_all(co))?)
    let n = bn_list_add(ids, int_to_str(v.id))
    let ks: Vec<str> = vec_new()
    let vs: Vec<str> = vec_new()
    vec_push(ks, bn_k_inv(co, v.id))
    vec_push(vs, bn_inv_json_str(v))
    vec_push(ks, bn_k_inv_all(co))
    vec_push(vs, bn_list_encode(n))
    if v.number != "" {
        vec_push(ks, bn_k_inv_num(co, v.number))
        vec_push(vs, int_to_str(v.id))
    }
    return bn_mset(db, ks, vs)?
}

fn bn_inv_list(db: DrokDB, co: i64) -> Vec<BnInvoice> !Net !IO {
    let ids = bn_list_parse(bn_get_str(db, bn_k_inv_all(co))?)
    let out: Vec<BnInvoice> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(ids) {
        let v = bn_inv_load(db, co, parse_int(vec_get(ids, i)))?
        if v.id > 0 {
            vec_push(out, v)
        }
        i = i + 1
    }
    return out
}

fn bn_inv_delete(db: DrokDB, co: i64, id: i64) -> i64 !Net !IO {
    let v = bn_inv_load(db, co, id)?
    if v.id <= 0 {
        return 0
    }
    if v.journal_entry > 0 {
        return 0 - 1
    }
    bn_del(db, bn_k_inv(co, id))?
    bn_del(db, bn_k_inv_num(co, v.number))?
    let ids = bn_list_parse(bn_get_str(db, bn_k_inv_all(co))?)
    let n = bn_list_del(ids, int_to_str(id))
    return bn_put_str(db, bn_k_inv_all(co), bn_list_encode(n))?
}

// ── автопроводка ──────────────────────────────────────────────────────────

fn bn_inv_journal_lines(v: BnInvoice) -> Vec<BnLine> {
    let out: Vec<BnLine> = vec_new()
    if v.kind == "sale" {
        let l1 = bn_line_zero()
        l1.account = BN_ACC_RECEIVABLE()
        l1.debit = v.total
        l1.counterpart = v.counterpart
        l1.note = v.counterpart_name
        vec_push(out, l1)
        let l2 = bn_line_zero()
        l2.account = BN_ACC_INCOME()
        l2.credit = v.net
        vec_push(out, l2)
        if bn_money_gt(v.vat, bn_money_zero()) == 1 {
            let l3 = bn_line_zero()
            l3.account = BN_ACC_VAT()
            l3.credit = v.vat
            vec_push(out, l3)
        }
        return out
    }
    let l1 = bn_line_zero()
    l1.account = BN_ACC_EXPENSE()
    l1.debit = v.net
    vec_push(out, l1)
    if bn_money_gt(v.vat, bn_money_zero()) == 1 {
        let l2 = bn_line_zero()
        l2.account = BN_ACC_VAT()
        l2.debit = v.vat
        vec_push(out, l2)
    }
    let l3 = bn_line_zero()
    l3.account = BN_ACC_PAYABLE()
    l3.credit = v.total
    l3.counterpart = v.counterpart
    l3.note = v.counterpart_name
    vec_push(out, l3)
    return out
}

// Проводва фактурата: нов дневников запис + фактурата става "posted".
fn bn_inv_post(db: DrokDB, co: i64, id: i64, created_by: str, created_at: str) -> BnResult !Net !IO !Par {
    let v = bn_inv_load(db, co, id)?
    if v.id <= 0 {
        return bn_res_err("няма такава фактура")
    }
    if v.journal_entry > 0 {
        return bn_res_err("фактурата вече е проводена")
    }
    if vec_len(v.lines) == 0 {
        return bn_res_err("фактурата няма редове")
    }
    let lines = bn_inv_journal_lines(v)
    let r = bn_je_post(db, co, v.date, "invoice", v.number, concat(concat(v.kind, ": "), concat(v.number, concat(" ", v.counterpart_name))), lines, created_by, created_at)?
    if r.ok == 0 {
        return r
    }
    v.journal_entry = r.number
    v.status = "posted"
    bn_inv_save(db, co, v)?
    return bn_res_ok(v.id, r.number)
}
