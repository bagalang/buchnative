# syntax=docker/dockerfile:1
FROM node:22-trixie-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG BUCHNATIVE_API_PROXY=http://backend:8080
ENV BUCHNATIVE_API_PROXY=$BUCHNATIVE_API_PROXY
RUN npm run build

FROM node:22-trixie-slim
WORKDIR /app
ENV NODE_ENV=production
ARG BUCHNATIVE_API_PROXY=http://127.0.0.1:8080
ENV BUCHNATIVE_API_PROXY=$BUCHNATIVE_API_PROXY
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--port", "3000", "--hostname", "0.0.0.0"]
