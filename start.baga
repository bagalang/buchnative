// start.baga — входна точка на buchnative: CLI команда или HTTP сървър.
//
// HTTP режимът гради app-а на всеки работник (от env), защото go_bg/cell2
// носят само i64 — структури не прескочат нишка. Рутърът е имUTABLE, така
// че това е безопасно и не пълно излишество.

import "routes.baga"
import "http.baga"
import "cli.baga"
import "cli_cmd.baga"
import "store.baga"
import "fmrbaga/respond.baga"
import "std/net/tcp.baga"
import "std/os/os.baga"
import "std/random/random.baga"
import "std/str/str.baga"

fn bn_conn_bg(ctx: i64) -> i64 !IO !Net !Random {
    let fd = cell2_0(ctx)
    let port = cell2_1(ctx)
    tcp_set_nodelay(fd)?
    let app = bn_build_app()?
    let db = drock_open(app.db_host, app.db_port)?
    if drock_ok(db) == 0 {
        let detail = concat("rocksbaga недостъпна: ", drock_last_error(db))
        http_respond(fd, fmr_json(503, concat("{\"detail\":\"", concat(detail, "\"}"))))?
        tcp_close(fd)?
        return 0
    }
    bn_h1_conn(fd, http_reader(fd), app, db)?
    drock_close(db)?
    tcp_close(fd)?
    return 0
}

fn bn_accept(port: i64) -> i64 !Net !IO !Par !Random {
    let listener = tcp_listen(port)?
    let msg = concat("buchnative listening on :", int_to_str(port))
    print(msg)
    while true {
        if signal_check() != 0 {
            break
        }
        let fd = tcp_accept(listener)?
        go_bg(bn_conn_bg, cell2(fd, port))
    }
    return 0
}

fn main() -> i64 !Net !IO !Par !Random !Time {
    let cmd = bn_cli_command()
    if cmd == "serve" {
        let app = bn_build_app()?
        return bn_accept(app.port)?
    }
    if cmd == "" {
        return bn_cli_help()?
    }
    return bn_cli_run(cmd)?
}
