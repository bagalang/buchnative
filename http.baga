// http.baga — нативен HTTP/JSON слой върху httpdbaga.
//
// fmrbaga е привързан към OrmDb (fmr_dispatch(ctx, db: OrmDb) -> FmrOut), а
// buchnative държи DrokDB. Този слой преизползва само чистите части — рутера,
// отговорите, JSON строительите и Bearer-JWT зависимостта — и сам пише
// accept цикъла и dispatch-а.
//
// Една DrokDB връзка на TCP конекция: HTTP/1.1 keep-alive означава, че
// браузърът държи малко връзки и всяка си има своя конекция към rocksbaga.

import "httpdbaga/http.baga"
import "fmrbaga/route.baga"
import "fmrbaga/respond.baga"
import "fmrbaga/jsonx.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/deps.baga"
import "drockb/drockb.baga"
import "std/bytes/bytes.baga"
import "std/net/tcp.baga"
import "std/os/os.baga"
import "std/random/random.baga"
import "std/str/str.baga"

struct BnOut {
    resp: Response,
    db: DrokDB
}

fn bn_out(resp: Response, db: DrokDB) -> BnOut {
    return BnOut { resp: resp, db: db }
}

struct BnHandlers {
    ids: Vec<i64>,
    fns: Vec<fn(FmrCtx, DrokDB) -> BnOut !IO !Net>
}

fn bn_handlers_new() -> BnHandlers {
    return BnHandlers { ids: vec_new(), fns: vec_new() }
}

fn bn_handlers_add(h: BnHandlers, id: i64, f: fn(FmrCtx, DrokDB) -> BnOut !IO !Net) -> BnHandlers {
    let mut i: i64 = 0
    while i < vec_len(h.ids) {
        if vec_get(h.ids, i) == id {
            vec_set(h.fns, i, f)
            return h
        }
        i = i + 1
    }
    vec_push(h.ids, id)
    vec_push(h.fns, f)
    return h
}

fn bn_handlers_find(h: BnHandlers, id: i64) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(h.ids) {
        if vec_get(h.ids, i) == id {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

struct BnApp {
    router: Router,
    jwt_secret: str,
    title: str,
    version: str,
    cors_origin: str,
    log_requests: i64,
    db_host: str,
    db_port: i64,
    port: i64,
    handlers: BnHandlers
}

fn bn_app_new(title: str, version: str) -> BnApp {
    return BnApp {
        router: router_new(),
        jwt_secret: "baga-secret",
        title: title,
        version: version,
        cors_origin: "",
        log_requests: 0,
        db_host: "127.0.0.1",
        db_port: 16579,
        port: 8090,
        handlers: bn_handlers_new()
    }
}

fn bn_app_copy(app: BnApp, router: Router, jwt_secret: str, title: str, version: str, cors_origin: str, log_requests: i64, db_host: str, db_port: i64, port: i64) -> BnApp {
    return BnApp {
        router: router,
        jwt_secret: jwt_secret,
        title: title,
        version: version,
        cors_origin: cors_origin,
        log_requests: log_requests,
        db_host: db_host,
        db_port: db_port,
        port: port,
        handlers: app.handlers
    }
}

fn bn_app_jwt(app: BnApp, secret: str) -> BnApp {
    return bn_app_copy(app, app.router, secret, app.title, app.version, app.cors_origin, app.log_requests, app.db_host, app.db_port, app.port)
}

fn bn_app_cors(app: BnApp, origin: str) -> BnApp {
    return bn_app_copy(app, app.router, app.jwt_secret, app.title, app.version, origin, app.log_requests, app.db_host, app.db_port, app.port)
}

fn bn_app_log(app: BnApp, on: i64) -> BnApp {
    return bn_app_copy(app, app.router, app.jwt_secret, app.title, app.version, app.cors_origin, on, app.db_host, app.db_port, app.port)
}

fn bn_app_db(app: BnApp, db_host: str, db_port: i64) -> BnApp {
    return bn_app_copy(app, app.router, app.jwt_secret, app.title, app.version, app.cors_origin, app.log_requests, db_host, db_port, app.port)
}

fn bn_app_http_port(app: BnApp, port: i64) -> BnApp {
    return bn_app_copy(app, app.router, app.jwt_secret, app.title, app.version, app.cors_origin, app.log_requests, app.db_host, app.db_port, port)
}

fn bn_route(app: BnApp, method: str, pattern: str, id: i64) -> BnApp {
    return bn_app_copy(app, router_add(app.router, method, pattern, id), app.jwt_secret, app.title, app.version, app.cors_origin, app.log_requests, app.db_host, app.db_port, app.port)
}

fn bn_route_meta(app: BnApp, method: str, pattern: str, id: i64, summary: str, tag: str, public: i64, body: str, ok: str, code: str, query: str) -> BnApp {
    return bn_app_copy(app, router_add_meta(app.router, method, pattern, id, summary, tag, public, body, ok, code, query), app.jwt_secret, app.title, app.version, app.cors_origin, app.log_requests, app.db_host, app.db_port, app.port)
}

fn bn_route_fn(app: BnApp, method: str, pattern: str, id: i64, h: fn(FmrCtx, DrokDB) -> BnOut !IO !Net) -> BnApp {
    let mut a = bn_route(app, method, pattern, id)
    a.handlers = bn_handlers_add(a.handlers, id, h)
    return a
}

fn bn_route_fn_meta(app: BnApp, method: str, pattern: str, id: i64, h: fn(FmrCtx, DrokDB) -> BnOut !IO !Net, summary: str, tag: str, public: i64, body: str, ok: str, code: str, query: str) -> BnApp {
    let mut a = bn_route_meta(app, method, pattern, id, summary, tag, public, body, ok, code, query)
    a.handlers = bn_handlers_add(a.handlers, id, h)
    return a
}

fn bn_make_request_id(req: Request) -> str !Random {
    let h = http_header(req, "X-Request-Id")
    if h != "" {
        return h
    }
    let raw = random_bytes(8)?
    return bytes_to_hex(raw)
}

fn bn_finish(app: BnApp, resp: Response, rid: str) -> Response {
    let mut r = resp
    if rid != "" {
        r = http_set_header(r, "X-Request-Id", rid)
    }
    if app.cors_origin != "" {
        r = fmr_cors(r, app.cors_origin)
    }
    return r
}

// Един запит: рутер → хендлер → отговор. 404/405 също минават през CORS.
fn bn_handle(app: BnApp, req: Request, db: DrokDB) -> Response !IO !Net !Random {
    let method = http_method(req)
    let path = http_path_only(req)
    let rid = bn_make_request_id(req)?
    if method == "OPTIONS" {
        if http_header(req, "Access-Control-Request-Method") != "" {
            return bn_finish(app, fmr_no_content(), rid)
        }
    }
    let m = router_match(app.router, method, path)
    if m.ok == 0 {
        if router_path_exists(app.router, path) == 1 {
            return bn_finish(app, fmr_405("Method not allowed"), rid)
        }
        return bn_finish(app, fmr_404("Not found"), rid)
    }
    let ctx = fmr_ctx_new_app(req, m, app.jwt_secret, app.title, app.version, app.router)
    let hi = bn_handlers_find(app.handlers, m.id)
    if hi < 0 {
        return bn_finish(app, fmr_500("unhandled route id"), rid)
    }
    let h = vec_get(app.handlers.fns, hi)
    let out = h(ctx, db)?
    if app.log_requests == 1 {
        eprintln(concat(concat(concat(method, " "), path), concat(" -> ", int_to_str(out.resp.status))))
    }
    return bn_finish(app, out.resp, rid)
}

// ── конекция и сървър ─────────────────────────────────────────────────────

// Без таймаут на четене забравена keep-alive конекция държи нишката си
// завинаги (същият проблем, който fmrbaga решава с FMR_IDLE_S).
fn bn_idle_s() -> i64 !IO {
    let v = env("BN_IDLE_S")?
    if v == "" {
        return 30
    }
    let n = parse_int(v)
    if n < 0 {
        return 0
    }
    if n > 600 {
        return 600
    }
    return n
}

fn bn_h1_conn(fd: i64, r0: HttpReader, app: BnApp, db: DrokDB) -> i64 !IO !Net !Random {
    let idle = bn_idle_s()?
    if idle > 0 {
        tcp_set_timeouts(fd, idle)?
    }
    let mut r = r0
    let mut keep = true
    while keep {
        let out = http_read_request_r(r)?
        r = out.reader
        if out.err != 0 {
            keep = false
        } else {
            if http_method(out.req) == "" {
                keep = false
            } else {
                let resp = bn_handle(app, out.req, db)?
                http_respond_keepalive(fd, resp, 1)?
            }
        }
    }
    return 0
}

// Accept-цикълът и работника са в start.baga: работникът гради app-а от env,
// защото cell2/go_bg носят само i64 (структури не могат да прескочат нишка).
