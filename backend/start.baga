// start.baga — buchnative backend entrypoint: migrate → fmr_run.
// Схемата и routes принадлежат на buchnative; fmrbaga/ormbaga остават универсални.

import "routes.baga"
import "schema.baga"
import "schema_kv.baga"
import "fmrbaga/app.baga"
import "ormbaga/orm.baga"
import "ormbaga/migrate.baga"
import "drockb/drockb.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn boot_migrate() -> i64 !Net !IO !Random !Time {
    let app = fmr_build_app()?
    let db = fmr_open_db(app)?
    if orm_ok_db(db) == 0 {
        print(concat("migrate: db connect failed: ", orm_err_db(db)))
        return 1
    }
    // KV backend-ът е безсхематичен: редовете са JSON, колоните се появяват
    // при първия запис. Няма DDL, значи няма и миграции — само проверка, че
    // rocksbaga отговаря.
    if orm_is_drock(db) == 1 {
        let p = drock_ping(db.kv)?
        if p.ok == 0 {
            print(concat("migrate: rocksbaga не отговаря: ", p.err))
            orm_close(db)?
            return 1
        }
        // KV е безсхематичен, но законовите промени искат преизчисляване на
        // стари редове — това е buchnative_kv_migrate (виж schema_kv.baga).
        let n = buchnative_kv_migrate(db)?
        if n < 0 {
            print("migrate: KV миграцията се провали")
            orm_close(db)?
            return 1
        }
        print(concat("migrate: ORM_BACKEND=drock — KV backend, приложени миграции ", int_to_str(n)))
        orm_close(db)?
        return 0
    }
    // Миграциите са само за PostgreSQL. На rocksbaga (ORM_BACKEND=drock) този
    // път не се изпълнява — там се пуска buchnative_kv_migrate по-горе.
    let set = buchnative_migrations()?
    let up = migrate_up(db, set)?
    if migrate_is_ok(up) == 0 {
        print(concat("migrate failed: ", migrate_err_str(up)))
        orm_close(migrate_db(up))?
        return 1
    }
    print(concat("migrate applied=", int_to_str(migrate_applied_n(up))))
    orm_close(migrate_db(up))?
    return 0
}

fn main() -> i64 !Net !IO !Par !Random !Time {
    // Ефективният secret е като в fmr_config_load: FMR_JWT_SECRET, а JWT_SECRET го override-ва.
    let mut secret = env("FMR_JWT_SECRET")?
    if secret == "" {
        secret = "baga-secret"
    }
    let j2 = env("JWT_SECRET")?
    if j2 != "" {
        secret = j2
    }
    let allow_weak = env("FMR_ALLOW_WEAK_SECRET")?
    if (secret == "dev-secret" || secret == "baga-secret") && allow_weak != "1" {
        print("ERROR: FMR_JWT_SECRET/JWT_SECRET is a known default — anyone can forge tokens.")
        print("Set a long random secret (e.g. FMR_JWT_SECRET=$(openssl rand -hex 32)) before running.")
        print("For local dev only: FMR_ALLOW_WEAK_SECRET=1")
        return 2
    }
    let rc = boot_migrate()?
    if rc != 0 {
        return rc
    }
    return fmr_run()?
}
