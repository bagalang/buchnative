// schema_kv.baga — версионирани миграции върху rocksbaga (KV).
//
// Защо съществува: счетоводната програма се мени със закона. Ново задължително
// поле, сменена ДДС ставка, нова версия на SAF-T — тези промени често искат
// СЪЩЕСТВУВАЩИТЕ редове да се преизчислят или допълнят. В bagabuch това бяха
// SQL миграциите (schema_pg_*). В KV няма DDL, затова тук е
// обхождане на таблицата с един MSET на ред.
//
// Какво НЕ е миграция: добавяне на нова колона. Редът е JSON — новият ключ се
// появява при следващия запис, а старите редове се четат като "" (нула).
// Миграция е само когато старите редове трябва да получат стойност, различна
// от нулата, или да бъдат преоформени.
//
// Как се добавя (пример за законова промяна):
//   1. напиши transform: fn(db, table, cols, vals, nulls, id) -> i64 !Net !IO !Time
//      — променя cols/vals/nulls на място и връща 1, ако е променил реда;
//   2. регистрирай го с kv_migrations_add(reg, "таблица", ВЕРСИЯ, "описание", fn);
//   3. версията се пази в kv:mig:<таблица> — миграцията се пуска веднъж.
//
// Версията е на таблица, не глобална: една таблица може да се промени
// независимо от другите, а редът на таблиците не е важен.

import "ormbaga/orm.baga"
import "models/kvtime.baga"
import "models/company.baga"
import "std/str/str.baga"

// ── примери / шаблони ─────────────────────────────────────────────────────

// Попълва created_at на редове, създадени преди колоната да съществува.
// Полезен при първо включване на KV backend-а към вече съществуваща база.
fn kv_mig_company_created_at(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>, id: str) -> i64 !Net !IO !Time {
    let mut i: i64 = 0
    let mut hit: i64 = 0 - 1
    while i < vec_len(cols) {
        if vec_get(cols, i) == "created_at" {
            hit = i
        }
        i = i + 1
    }
    if hit < 0 {
        vec_push(cols, "created_at")
        vec_push(vals, kv_now_iso()?)
        vec_push(nulls, 0)
        return 1
    }
    if vec_get(nulls, hit) == 1 || vec_get(vals, hit) == "" {
        vec_set(vals, hit, kv_now_iso()?)
        vec_set(nulls, hit, 0)
        return 1
    }
    return 0
}

// SAF-T: software_id/software_company_name/software_version са задължителни в
// износа. Стари редове може да са без тях.
fn kv_mig_company_software(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>, id: str) -> i64 !Net !IO !Time {
    let mut changed: i64 = 0
    changed = kv_mig_set_default(cols, vals, nulls, "software_company_name", "buchnative")
    changed = kv_mig_set_default(cols, vals, nulls, "software_id", "BUCHNATIVE")
    changed = kv_mig_set_default(cols, vals, nulls, "software_version", "1.0")
    return changed
}

// Ако колоната липсва или е NULL/празна — слага default. Връща 1 при промяна.
fn kv_mig_set_default(cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>, name: str, def: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(cols) {
        if vec_get(cols, i) == name {
            if vec_get(nulls, i) == 1 || vec_get(vals, i) == "" {
                vec_set(vals, i, def)
                vec_set(nulls, i, 0)
                return 1
            }
            return 0
        }
        i = i + 1
    }
    vec_push(cols, name)
    vec_push(vals, def)
    vec_push(nulls, 0)
    return 1
}

// ── регистър ──────────────────────────────────────────────────────────────

// Периодите/началните салда/ДМА са били глобални. Съществуващите редове се
// запринасят към първата фирма — преди това нямаше разграничение и всичко е
// в една фирма.
fn kv_mig_default_company(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>, id: str) -> i64 !Net !IO !Time {
    let mut i: i64 = 0
    while i < vec_len(cols) {
        if vec_get(cols, i) == "company_id" {
            if vec_get(nulls, i) == 0 && vec_get(vals, i) != "" && vec_get(vals, i) != "0" {
                return 0
            }
        }
        i = i + 1
    }
    let cq = company_all(db)?
    if orm_ok_q(cq) == 0 || orm_nrows(cq) < 1 {
        return 0
    }
    let cid = orm_cell_by_i64(cq, 0, "id")
    return kv_mig_set_default(cols, vals, nulls, "company_id", int_to_str(cid))
}

// От 2026 България е в еврозоната: сметка 503 се казва в EUR, не в левове.
fn kv_mig_account_eur(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>, id: str) -> i64 !Net !IO !Time {
    let mut ni: i64 = 0 - 1
    let mut mi: i64 = 0 - 1
    let mut i: i64 = 0
    while i < vec_len(cols) {
        if vec_get(cols, i) == "number" {
            ni = i
        }
        if vec_get(cols, i) == "name" {
            mi = i
        }
        i = i + 1
    }
    if ni < 0 || mi < 0 {
        return 0
    }
    if vec_get(vals, ni) != "503" {
        return 0
    }
    let nm = vec_get(vals, mi)
    if str_find(nm, "в левове") < 0 {
        return 0
    }
    vec_set(vals, mi, str_replace(nm, "в левове", "в EUR"))
    vec_set(nulls, mi, 0)
    return 1
}

// Контрагентите стават мултивалутни: валута по подразбиране на разчетната
// сметка е EUR (празното се чете като EUR и при четене).
fn kv_mig_counterpart_currency(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>, id: str) -> i64 !Net !IO !Time {
    return kv_mig_set_default(cols, vals, nulls, "currency", "EUR")
}

// Валутни сметки: групи 4xx (разчети) и 5xx (парични средства / финансови
// активи) се маркират с is_currency=1 — по тях се води количество във валута.
fn kv_mig_account_is_currency(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>, nulls: Vec<i64>, id: str) -> i64 !Net !IO !Time {
    let mut ni: i64 = 0 - 1
    let mut ci: i64 = 0 - 1
    let mut i: i64 = 0
    while i < vec_len(cols) {
        if vec_get(cols, i) == "number" {
            ni = i
        }
        if vec_get(cols, i) == "is_currency" {
            ci = i
        }
        i = i + 1
    }
    if ni < 0 {
        return 0
    }
    let num = vec_get(vals, ni)
    if len(num) < 1 {
        return 0
    }
    let g0 = char_at(num, 0)
    if g0 != 52 && g0 != 53 {
        return 0
    }
    if ci >= 0 {
        if vec_get(nulls, ci) == 0 && vec_get(vals, ci) == "1" {
            return 0
        }
        vec_set(vals, ci, "1")
        vec_set(nulls, ci, 0)
        return 1
    }
    vec_push(cols, "is_currency")
    vec_push(vals, "1")
    vec_push(nulls, 0)
    return 1
}

// Празен списък е нормалното състояние на ново приложение: схемата се движи
// с кода, а миграция се добавя само при промяна, която иска преизчисление.
fn buchnative_kv_migrations() -> KvMigrations {
    let mut m = kv_migrations_new()
    m = kv_migrations_add(m, "accounting_periods", 20261107001, "period_company_id", kv_mig_default_company)
    m = kv_migrations_add(m, "opening_balances", 20261109001, "opening_balance_company_id", kv_mig_default_company)
    m = kv_migrations_add(m, "fixed_assets", 20261109002, "fixed_asset_company_id", kv_mig_default_company)
    m = kv_migrations_add(m, "internal_docs", 20261109003, "internal_doc_company_id", kv_mig_default_company)
    // Амортизационните записи по-рано се вмъкваха с company_id=0.
    m = kv_migrations_add(m, "journal_entries", 20261109004, "journal_entry_company_id", kv_mig_default_company)
    m = kv_migrations_add(m, "accounts", 20261111001, "account_503_eur", kv_mig_account_eur)
    m = kv_migrations_add(m, "accounts", 20261112001, "account_is_currency", kv_mig_account_is_currency)
    m = kv_migrations_add(m, "counterparts", 20261112001, "counterpart_currency_eur", kv_mig_counterpart_currency)
    return m
}

// Зарежда версиите и пуска само новите. Връща броя приложени.
fn buchnative_kv_migrate(db: OrmDb) -> i64 !Net !IO !Time {
    return kv_migrate_run(db, buchnative_kv_migrations())?
}
