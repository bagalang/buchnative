fn fmr_build_app() -> FmrApp !IO {
    let cfg = fmr_config_load()?
    let mut app = fmr_app_new(cfg.title, cfg.version)
    app = fmr_app_with_config(app, cfg)
    app = fmr_route_meta(app, "GET", "/health", RID_HEALTH(), "", "system", 1, "", "Status", "200", "")
    app = fmr_route_meta(app, "GET", "/ready", RID_READY(), "", "system", 1, "", "Ready", "200", "")
    app = fmr_route_meta(app, "GET", "/readyz", RID_READY(), "", "system", 1, "", "Ready", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/meta", RID_META(), "", "system", 1, "", "Status", "200", "")
    app = fmr_route_meta(app, "GET", "/openapi.json", RID_OPENAPI(), "", "system", 1, "", "-", "200", "")
    app = fmr_route_meta(app, "GET", "/metrics", RID_METRICS(), "", "system", 0, "", "-", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/token", RID_TOKEN(), "", "auth", 1, "TokenRequest?", "TokenResponse", "200", "sub:s")
    app = fmr_route_meta(app, "GET", "/v1/me", RID_ME(), "", "auth", 0, "", "Me", "200", "")
    app = fmr_route_meta(app, "GET", "/v1/auth/registration-status", RID_REG_STATUS(), "", "auth", 1, "", "RegStatus", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/register", RID_REGISTER(), "", "auth", 1, "RegisterRequest", "RegisterResult", "201", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/forgot-password", RID_FORGOT(), "", "auth", 1, "ForgotPassword", "Message", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/reset-password", RID_RESET(), "", "auth", 1, "ResetPassword", "Message", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/auth/mfa", RID_MFA(), "", "auth", 1, "MfaRequest", "TokenResponse", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/me/totp/start", RID_TOTP_START(), "", "auth", 0, "", "TotpStart", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/me/totp/confirm", RID_TOTP_CONFIRM(), "", "auth", 0, "TotpConfirm", "Message", "200", "")
    app = fmr_route_meta(app, "POST", "/v1/me/totp/disable", RID_TOTP_DISABLE(), "", "auth", 0, "TotpDisable", "Message", "200", "")
