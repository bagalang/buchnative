fn fmr_before(ctx: FmrCtx) -> DepResult !Time {
    let token = fmr_bearer(ctx)
    if token == "" {
        return dep_ok(ctx)
    }
    let now = time_now_ms()? / 1000
    if jwt_accept_hs256(ctx.jwt_secret, token, now, "", "") == 0 {
        return dep_fail(ctx, fmr_401("Invalid or expired token"))
    }
    if jwt_claim_int(token, "mfa") == 1 && ctx.route_id != RID_MFA() {
        return dep_fail(ctx, fmr_401("изисква се 2FA код"))
    }
    return dep_ok(ctx)
}

// buchnative няма gRPC повърхност — dual hook връща празен UNIMPLEMENTED.
fn fmr_grpc_handle(path: str, body: bytes, db: OrmDb) -> FmrOut !IO !Net {
    let mut r = http_response_bytes(200, bytes_new(0))
    r = http_set_header(r, "Content-Type", "application/grpc")
    r = http_set_header(r, "grpc-status", "12")
    r = http_set_header(r, "grpc-message", "UNIMPLEMENTED")
    return fmr_out(r, db)
}

fn fmr_dispatch(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Random !Time {
