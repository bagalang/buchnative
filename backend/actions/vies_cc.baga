// actions/vies_cc.baga — ЕС кодове, поддържани от VIES (EL = Гърция, XI = Северна
// Ирландия). Без импорти, за да се ползва и от VAT кода, и от VIES lookup-а.

fn vies_is_eu_cc(cc: str) -> i64 {
    if cc == "AT" || cc == "BE" || cc == "BG" || cc == "CY" || cc == "CZ" { return 1 }
    if cc == "DE" || cc == "DK" || cc == "EE" || cc == "ES" || cc == "FI" { return 1 }
    if cc == "FR" || cc == "EL" || cc == "HR" || cc == "HU" || cc == "IE" { return 1 }
    if cc == "IT" || cc == "LT" || cc == "LU" || cc == "LV" || cc == "MT" { return 1 }
    if cc == "NL" || cc == "PL" || cc == "PT" || cc == "RO" || cc == "SE" { return 1 }
    if cc == "SI" || cc == "SK" || cc == "XI" || cc == "GR" { return 1 }
    return 0
}
