// actions/journal_fx.baga — валутни полета на ред в ръчния запис на дневника.
//
// currency (ISO код, главни букви; "" = основната валута на фирмата), fx_quantity
// (сума във валутата на реда), fx_rate (единици основна валута за 1 единица
// от currency). amount остава в основната валута и трябва да е
// fx_quantity × fx_rate, закръглено до 2 знака. Валута се позволява само по
// валутна сметка (accounts.is_currency=1); валутата на фирмата се свежда до "".

import "../models/company.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"
import "bagadecimal/src/decimal.baga"

struct LineFx {
    ok: i64,
    err: str,
    currency: str,
    fx_quantity: str,
    fx_rate: str
}

fn line_fx_err(err: str) -> LineFx {
    return LineFx { ok: 0, err: err, currency: "", fx_quantity: "", fx_rate: "" }
}

fn fx_norm_code(s0: str) -> str {
    let s = str_trim(s0)
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c >= 97 && c <= 122 {
            out = concat(out, chr(c - 32))
        } else {
            out = concat(out, chr(c))
        }
        i = i + 1
    }
    return out
}

fn journal_line_fx_parse(b: JBody, elem: i64, acc_is_currency: i64, base: str, amount: str) -> LineFx {
    let mut cur = fx_norm_code(jopt_str(b.doc, elem, "currency", "").val)
    if cur == base {
        cur = ""
    }
    let fq_in = str_trim(jopt_str(b.doc, elem, "fx_quantity", "").val)
    let fr_in = str_trim(jopt_str(b.doc, elem, "fx_rate", "").val)
    if cur == "" {
        // Универсална статия (Option B): базовият ред също има количество и
        // курс — количество=amount, курс=1 (стойността съвпада с количеството).
        let mut fq = fq_in
        let mut fr = fr_in
        if fq == "" {
            fq = amount
        }
        if fr == "" {
            fr = "1"
        }
        let qp = dec_parse(fq)
        if qp.ok == 0 {
            return line_fx_err(concat("невалидно fx_quantity: ", fq))
        }
        let rp = dec_parse(fr)
        if rp.ok == 0 {
            return line_fx_err(concat("невалиден fx_rate: ", fr))
        }
        if dec_cmp(rp.value, dec_zero()) <= 0 {
            return line_fx_err("fx_rate трябва да е положителен")
        }
        let ap = dec_parse(amount)
        if ap.ok == 0 {
            return line_fx_err(concat("невалидна сума: ", amount))
        }
        let m = dec_mul(qp.value, rp.value)
        if m.ok == 0 {
            return line_fx_err(m.err)
        }
        let r2 = dec_round_dp(m.value, 2)
        if r2.ok == 0 {
            return line_fx_err(r2.err)
        }
        if dec_cmp(r2.value, ap.value) != 0 {
            return line_fx_err(concat("amount трябва да е fx_quantity × fx_rate до 2 знака (очаквани ", concat(dec_to_string(r2.value), ")")))
        }
        return LineFx { ok: 1, err: "", currency: "", fx_quantity: fq, fx_rate: fr }
    }
    if len(cur) != 3 {
        return line_fx_err("currency трябва да е ISO код от 3 букви (напр. USD)")
    }
    if acc_is_currency == 0 {
        return line_fx_err("сметката не е валутна (is_currency=0) — валута не се допуска по нея")
    }
    if fq_in == "" || fr_in == "" {
        return line_fx_err("при валута fx_quantity и fx_rate са задължителни")
    }
    let qp = dec_parse(fq_in)
    if qp.ok == 0 {
        return line_fx_err(concat("невалидно fx_quantity: ", fq_in))
    }
    let rp = dec_parse(fr_in)
    if rp.ok == 0 {
        return line_fx_err(concat("невалиден fx_rate: ", fr_in))
    }
    if dec_cmp(rp.value, dec_zero()) <= 0 {
        return line_fx_err("fx_rate трябва да е положителен")
    }
    let ap = dec_parse(amount)
    if ap.ok == 0 {
        return line_fx_err(concat("невалидна сума: ", amount))
    }
    let m = dec_mul(qp.value, rp.value)
    if m.ok == 0 {
        return line_fx_err(m.err)
    }
    let r2 = dec_round_dp(m.value, 2)
    if r2.ok == 0 {
        return line_fx_err(r2.err)
    }
    // fx_quantity=0 е преоценъчен ред (само base сумата се променя) — без проверка.
    if dec_is_zero(qp.value) == 0 && dec_cmp(r2.value, ap.value) != 0 {
        return line_fx_err(concat("amount трябва да е fx_quantity × fx_rate до 2 знака (очаквани ", concat(dec_to_string(r2.value), ")")))
    }
    return LineFx { ok: 1, err: "", currency: cur, fx_quantity: fq_in, fx_rate: fr_in }
}

// Основната валута на активната фирма (празно → EUR, като при създаване на фирма).
fn journal_base_currency(db: OrmDb, company_id: i64) -> str !IO !Net {
    let bc = company_base_currency(db, company_id)?
    if bc.ok == 0 {
        return "EUR"
    }
    return bc.cur
}
