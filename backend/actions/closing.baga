// actions/closing.baga — приключвателни операции в края на месеца.
//
// Картата `closing_map` в settings на фирмата казва коя сметка/подсметка
// (префикс на номера) към коя сметка се приключва: [{"source":"602","target":"612"},
// {"source":"60","target":"611"}]. Печели най-дългият префикс; без карта —
// по подразбиране 60 → 611. Сметките, които са цел на правило, не се
// приключват сами (няма верига в една операция).
//
// GET  /v1/closing-operations/preview?year=&month= — редове без запис.
// POST /v1/closing-operations/run {year, month} — една балансирана статия
// document_type='closing', номер CLOSE-YYYY-MM, дата последния ден на месеца.

import "../models/account.baga"
import "../models/company.baga"
import "../models/journal.baga"
import "../models/accounting_period.baga"
import "acl.baga"
import "audit.baga"
import "active_company.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/json/json.baga"
import "std/str/str.baga"

fn CLOSING_TYPE() -> str { return "closing" }

struct ClosingAccount { found: i64, id: i64, name: str }
struct ClosingExisting { found: i64, entry_id: i64, number: str }

// ── дати (чисто, без chrono) ───────────────────────────────────────────────

fn closing_leap(y: i64) -> i64 {
    if y % 4 != 0 {
        return 0
    }
    if y % 100 != 0 {
        return 1
    }
    if y % 400 != 0 {
        return 0
    }
    return 1
}

fn closing_month_days(y: i64, m: i64) -> i64 {
    if m == 2 {
        return 28 + closing_leap(y)
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    return 31
}

fn closing_pad2(n: i64) -> str {
    let s = int_to_str(n)
    if len(s) < 2 {
        return concat("0", s)
    }
    return s
}

fn closing_last_day(y: i64, m: i64) -> str {
    return concat(concat(int_to_str(y), "-"), concat(closing_pad2(m), concat("-", closing_pad2(closing_month_days(y, m)))))
}

fn closing_period(y: i64, m: i64) -> str {
    return concat(int_to_str(y), concat("-", closing_pad2(m)))
}

// a <= b за ISO дати — низовите < > в baga гледат само първия байт.
fn closing_day_le(a: str, b: str) -> i64 {
    let mut n = len(a)
    if len(b) < n {
        n = len(b)
    }
    let mut i: i64 = 0
    while i < n {
        let ca = char_at(a, i)
        let cb = char_at(b, i)
        if ca < cb {
            return 1
        }
        if ca > cb {
            return 0
        }
        i = i + 1
    }
    return 1
}

// ── пари в стотинки (NUMERIC(18,2) → цяло, точно) ─────────────────────────

fn closing_abs(c: i64) -> i64 {
    if c < 0 {
        return 0 - c
    }
    return c
}

fn closing_cents(s: str) -> i64 {
    let t = str_trim(s)
    let mut sign: i64 = 1
    let mut i: i64 = 0
    if len(t) > 0 && char_at(t, 0) == 45 {
        sign = 0 - 1
        i = 1
    }
    let mut whole: i64 = 0
    let mut frac: i64 = 0
    let mut fd: i64 = 0
    let mut dot: i64 = 0
    while i < len(t) {
        let c = char_at(t, i)
        if c == 46 {
            dot = 1
        } else {
            if c >= 48 && c <= 57 {
                if dot == 1 {
                    if fd < 2 {
                        frac = frac * 10 + (c - 48)
                        fd = fd + 1
                    }
                } else {
                    whole = whole * 10 + (c - 48)
                }
            }
        }
        i = i + 1
    }
    while fd < 2 {
        frac = frac * 10
        fd = fd + 1
    }
    return sign * (whole * 100 + frac)
}

fn closing_money(c: i64) -> str {
    let s = concat(int_to_str(closing_abs(c) / 100), concat(".", closing_pad2(closing_abs(c) % 100)))
    if c < 0 {
        return concat("-", s)
    }
    return s
}

// ── карта от настройките ───────────────────────────────────────────────────

fn closing_default_map() -> Map<str, str> {
    let m: Map<str, str> = map_new()
    map_set(m, "60", "611")
    return m
}

// Масив [{source,target}] или обект {"60":"611"}; невалиден JSON → празна карта.
fn closing_map_from_settings(raw: str) -> Map<str, str> {
    let m: Map<str, str> = map_new()
    let b = jbody_parse_str(raw)
    if b.ok == 0 {
        return m
    }
    let cm = json_get(b.doc, b.root, "closing_map")
    if cm < 0 {
        return m
    }
    let tag = json_tag(b.doc, cm)
    if tag == 5 {
        let n = json_count(b.doc, cm)
        let mut i: i64 = 0
        while i < n {
            let it = json_at(b.doc, cm, i)
            let s = json_get(b.doc, it, "source")
            let t = json_get(b.doc, it, "target")
            if s >= 0 && t >= 0 {
                let sv = str_trim(json_str(b.doc, s))
                let tv = str_trim(json_str(b.doc, t))
                if sv != "" && tv != "" {
                    map_set(m, sv, tv)
                }
            }
            i = i + 1
        }
        return m
    }
    if tag == 6 {
        let n = json_count(b.doc, cm)
        let mut i: i64 = 0
        while i < n {
            let k = json_key(b.doc, cm, i)
            let v = json_val(b.doc, cm, i)
            let tv = str_trim(json_str(b.doc, v))
            if str_trim(k) != "" && tv != "" {
                map_set(m, str_trim(k), tv)
            }
            i = i + 1
        }
    }
    return m
}

// Най-дългият префикс печели; без съвпадение — "".
fn closing_match(m: Map<str, str>, number: str) -> str {
    let keys = map_keys(m)
    let mut best = ""
    let mut blen: i64 = 0 - 1
    let mut i: i64 = 0
    while i < vec_len(keys) {
        let k = vec_get(keys, i)
        if len(k) > blen && str_starts_with(number, k) {
            best = map_get(m, k)
            blen = len(k)
        }
        i = i + 1
    }
    return best
}

// ── салда и планове ────────────────────────────────────────────────────────

// Салдо (Дт-Кт) по сметка до края на месеца за фирмата, в стотинки.
fn closing_balances(db: OrmDb, company_id: i64, last_day: str) -> Map<i64, i64> !IO !Net {
    let m: Map<i64, i64> = map_new()
    let lq = journal_lines_for_saft(db)?
    if orm_ok_q(lq) == 0 {
        return m
    }
    let mut i: i64 = 0
    while i < orm_nrows(lq) {
        let day = orm_cell_by(lq, i, "entry_date")
        let co = orm_cell_by_i64(lq, i, "company_id")
        if co == company_id && closing_day_le(day, last_day) == 1 {
            let key = orm_cell_by_i64(lq, i, "account_id")
            let cents = closing_cents(orm_cell_by(lq, i, "amount"))
            let mut v: i64 = 0
            let cur = map_get(m, key)
            if cur != 0 {
                v = cur
            }
            if orm_cell_by(lq, i, "direction") == "debit" {
                v = v + cents
            } else {
                v = v - cents
            }
            map_set(m, key, v)
        }
        i = i + 1
    }
    return m
}

// Съществува ли вече приключване за месеца.
fn closing_existing(db: OrmDb, company_id: i64, period: str) -> ClosingExisting !IO !Net {
    let out = ClosingExisting { found: 0, entry_id: 0, number: "" }
    let q = kv_select_where(db, journal_entry_table(), "vat_period", period, journal_entry_cols())?
    if orm_ok_q(q) == 0 {
        return out
    }
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by_i64(q, i, "company_id") == company_id {
            if orm_cell_by(q, i, "document_type") == CLOSING_TYPE() {
                return ClosingExisting { found: 1, entry_id: orm_cell_by_i64(q, i, "id"), number: orm_cell_by(q, i, "document_number") }
            }
        }
        i = i + 1
    }
    return out
}

// Периодът трябва да е отворен (закрит месец не се приключва повторно).
fn closing_period_open(db: OrmDb, company_id: i64, year: i64, month: i64) -> i64 !IO !Net {
    let q = aper_by_company_year(db, company_id, year)?
    if orm_ok_q(q) == 0 {
        return 0
    }
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by_i64(q, i, "month") == month {
            if orm_cell_by(q, i, "status") == "closed" {
                return 0
            }
            return 1
        }
        i = i + 1
    }
    // Липсващ ред е отворен (seed-ът прави 12 месеца, но стари бази — не).
    return 1
}

// Сметка по номер (сметкопланът е общ за всички фирми в buchnative).
fn closing_account_by_number(db: OrmDb, number: str) -> ClosingAccount !IO !Net {
    let out = ClosingAccount { found: 0, id: 0, name: "" }
    let q = account_all(db)?
    if orm_ok_q(q) == 0 {
        return out
    }
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by(q, i, "number") == number {
            return ClosingAccount { found: 1, id: orm_cell_by_i64(q, i, "id"), name: orm_cell_by(q, i, "name") }
        }
        i = i + 1
    }
    return out
}

// Събира плановете; връща JsonDoc с lines (преглед) и post (готови редове).
fn closing_compute(db: OrmDb, company_id: i64, year: i64, month: i64) -> JsonDoc !IO !Net {
    let last_day = closing_last_day(year, month)
    let period = closing_period(year, month)
    let doc_number = concat("CLOSE-", period)

    let cq = company_find(db, company_id)?
    let mut rules = closing_default_map()
    if orm_ok_q(cq) == 1 && orm_nrows(cq) > 0 {
        let st = orm_cell_by(cq, 0, "settings")
        let m = closing_map_from_settings(st)
        if map_len(m) > 0 {
            rules = m
        }
    }
    // Целите на правилата са СТОЙНОСТИТЕ (а не ключовете) — сметка, която е
    // цел, не се приключва сама.
    let sources = map_keys(rules)
    let mut target_hit: Map<str, str> = map_new()
    let mut ti: i64 = 0
    while ti < vec_len(sources) {
        let k = vec_get(sources, ti)
        map_set(target_hit, map_get(rules, k), "1")
        ti = ti + 1
    }

    let balances = closing_balances(db, company_id, last_day)?
    let aq = account_all(db)?
    let mut lines = jarr_new()
    let mut post = jarr_new()
    let mut total: i64 = 0
    let mut count: i64 = 0
    let mut tgt_sum: Map<i64, i64> = map_new()
    let mut i: i64 = 0
    while i < orm_nrows(aq) {
        let aid = orm_cell_by_i64(aq, i, "id")
        let num = orm_cell_by(aq, i, "number")
        let bal = map_get(balances, aid)
        if num == "702" || num == "611" {
        }
        if bal != 0 && map_get(target_hit, num) == "" {
            let cents = bal
            let tgt = closing_match(rules, num)
            if tgt != "" {
                let ta = closing_account_by_number(db, tgt)?
                if ta.found == 1 {
                    total = total + closing_abs(cents)
                    count = count + 1
                    let mut dir = "credit"
                    if cents < 0 {
                        dir = "debit"
                    }
                    let mut l = jobj_new()
                    l = jobj_i64(l, "source_id", aid)
                    l = jobj_str(l, "source_number", num)
                    l = jobj_str(l, "source_name", orm_cell_by(aq, i, "name"))
                    l = jobj_i64(l, "target_id", ta.id)
                    l = jobj_str(l, "target_number", tgt)
                    l = jobj_str(l, "target_name", ta.name)
                    l = jobj_str(l, "balance", closing_money(cents))
                    lines = jarr_obj(lines, l)
                    let mut p = jobj_new()
                    p = jobj_i64(p, "account_id", aid)
                    p = jobj_str(p, "direction", dir)
                    p = jobj_str(p, "amount", closing_money(closing_abs(cents)))
                    post = jarr_obj(post, p)
                    let mut ts: i64 = 0
                    let cur = map_get(tgt_sum, ta.id)
                    if cur != 0 {
                        ts = cur
                    }
                    map_set(tgt_sum, ta.id, ts + cents)
                }
            }
        }
        i = i + 1
    }
    // Целовите сметки: знакова сума → Дт/Кт по цяло.
    let tids = map_keys(tgt_sum)
    ti = 0
    while ti < vec_len(tids) {
        let tid = vec_get(tids, ti)
        let cents = map_get(tgt_sum, tid)
        if cents != 0 {
            let mut dir = "debit"
            if cents < 0 {
                dir = "credit"
            }
            let mut p = jobj_new()
            p = jobj_i64(p, "account_id", tid)
            p = jobj_str(p, "direction", dir)
            p = jobj_str(p, "amount", closing_money(closing_abs(cents)))
            post = jarr_obj(post, p)
        }
        ti = ti + 1
    }

    let mut o = jobj_new()
    o = jobj_i64(o, "year", year)
    o = jobj_i64(o, "month", month)
    o = jobj_str(o, "entry_date", last_day)
    o = jobj_str(o, "period", period)
    o = jobj_str(o, "document_number", doc_number)
    o = jobj_str(o, "total", closing_money(total))
    o = jobj_i64(o, "count", count)
    o = jobj_arr(o, "lines", lines)
    o = jobj_arr(o, "post", post)
    return json_parse(jobj_encode(o))
}

// Четци на JsonDoc-а от compute().
fn cl_str(d: JsonDoc, key: str) -> str {
    let n = json_get(d, json_root(d), key)
    if n < 0 {
        return ""
    }
    return json_str(d, n)
}

fn cl_i64(d: JsonDoc, key: str) -> i64 {
    let n = json_get(d, json_root(d), key)
    if n < 0 {
        return 0
    }
    return parse_int(json_str(d, n))
}

// Редове за преглед (lines) като JArr с полетата на UI-то.
fn cl_lines(d: JsonDoc, key: str) -> JArr {
    let n = json_get(d, json_root(d), key)
    if n < 0 {
        return jarr_new()
    }
    let cnt = json_count(d, n)
    let mut out = jarr_new()
    let mut i: i64 = 0
    while i < cnt {
        let it = json_at(d, n, i)
        let mut o = jobj_new()
        o = jobj_str(o, "source_number", json_str(d, json_get(d, it, "source_number")))
        o = jobj_str(o, "source_name", json_str(d, json_get(d, it, "source_name")))
        o = jobj_str(o, "target_number", json_str(d, json_get(d, it, "target_number")))
        o = jobj_str(o, "target_name", json_str(d, json_get(d, it, "target_name")))
        o = jobj_str(o, "balance", json_str(d, json_get(d, it, "balance")))
        out = jarr_obj(out, o)
        i = i + 1
    }
    return out
}

struct ClosingPost { account_id: i64, direction: str, amount: str }

fn closing_post_len(d: JsonDoc) -> i64 {
    let n = json_get(d, json_root(d), "post")
    if n < 0 {
        return 0
    }
    return json_count(d, n)
}

fn closing_post_at(d: JsonDoc, i: i64) -> ClosingPost {
    let n = json_get(d, json_root(d), "post")
    let it = json_at(d, n, i)
    return ClosingPost {
        account_id: parse_int(json_str(d, json_get(d, it, "account_id"))),
        direction: json_str(d, json_get(d, it, "direction")),
        amount: json_str(d, json_get(d, it, "amount")),
    }
}

// ── handlers ───────────────────────────────────────────────────────────────

fn act_closing_preview(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let y = parse_int(fmr_query(ctx, "year"))
    let m = parse_int(fmr_query(ctx, "month"))
    if y < 2000 || m < 1 || m > 12 {
        return act_err(db, 422, "year и month (1–12) са задължителни")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let d = ac.db
    let doc = closing_compute(d, ac.id, y, m)?
    let ex = closing_existing(d, ac.id, cl_str(doc, "period"))?
    let mut o = jobj_new()
    o = jobj_i64(o, "year", cl_i64(doc, "year"))
    o = jobj_i64(o, "month", cl_i64(doc, "month"))
    o = jobj_str(o, "entry_date", cl_str(doc, "entry_date"))
    o = jobj_str(o, "period", cl_str(doc, "period"))
    o = jobj_str(o, "document_number", cl_str(doc, "document_number"))
    o = jobj_str(o, "total", cl_str(doc, "total"))
    o = jobj_i64(o, "count", cl_i64(doc, "count"))
    o = jobj_arr(o, "lines", cl_lines(doc, "lines"))
    if ex.found == 1 {
        o = jobj_i64(o, "already_done", 1)
        o = jobj_i64(o, "existing_entry_id", ex.entry_id)
        o = jobj_str(o, "existing_document_number", ex.number)
    } else {
        o = jobj_i64(o, "already_done", 0)
    }
    return act_ok(d, o)
}

fn act_closing_run(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_perm(ctx, db, "accounting:write")?
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let yf = jreq_i64(b.doc, b.root, "year")
    if yf.ok == 0 {
        return act_422_field(db, "year", yf)
    }
    let mf = jreq_i64(b.doc, b.root, "month")
    if mf.ok == 0 {
        return act_422_field(db, "month", mf)
    }
    let y = yf.num
    let m = mf.num
    if y < 2000 || m < 1 || m > 12 {
        return act_err(db, 422, "year и month (1–12) са задължителни")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let d = ac.db
    let period = closing_period(y, m)
    if closing_period_open(d, ac.id, y, m) == 0 {
        return act_err(d, 422, "месецът е затворен")
    }
    let ex = closing_existing(d, ac.id, period)?
    if ex.found == 1 {
        return act_err(d, 409, concat("приключването за ", concat(period, " вече е записано")))
    }
    let doc = closing_compute(d, ac.id, y, m)?
    if cl_i64(doc, "count") == 0 {
        return act_err(d, 422, concat("няма салда за приключване за ", period))
    }
    let entry_date = cl_str(doc, "entry_date")
    let doc_number = cl_str(doc, "document_number")
    let total = cl_str(doc, "total")
    let desc = concat("Приключвателни операции за ", period)
    let eq = journal_entry_insert(d, entry_date, CLOSING_TYPE(), 0, desc, "no_vat", 0, "", "", doc_number, entry_date, period, total, "0", ac.id)?
    if orm_ok_q(eq) == 0 {
        return act_err(orm_db_q(eq), 500, orm_err_q(eq))
    }
    let entry_id = orm_cell_by_i64(eq, 0, "id")
    let mut d2 = orm_db_q(eq)
    let pn = closing_post_len(doc)
    let mut i: i64 = 0
    while i < pn {
        let p = closing_post_at(doc, i)
        let lq = journal_line_insert(d2, entry_id, p.account_id, p.direction, p.amount, "0", 0, 0, 0)?
        if orm_ok(lq) == 0 {
            return act_err(orm_db_exec(lq), 500, orm_err_exec(lq))
        }
        d2 = orm_db_exec(lq)
        i = i + 1
    }
    let mut out = jobj_new()
    out = jobj_i64(out, "year", y)
    out = jobj_i64(out, "month", m)
    out = jobj_str(out, "entry_date", entry_date)
    out = jobj_str(out, "period", period)
    out = jobj_str(out, "document_number", doc_number)
    out = jobj_str(out, "total", total)
    out = jobj_i64(out, "count", cl_i64(doc, "count"))
    out = jobj_i64(out, "entry_id", entry_id)
    audit_record(d2, ac.id, auth.ctx.user_sub, "closing", entry_id, doc_number, "close", concat("Приключвателни операции за ", period), "", total, "")
    return act_ok(d2, out)
}
