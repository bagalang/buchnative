// actions/health.baga — проверка на интегритет на базата.
//
// db-check изисква вход и показва връзката, броя редове по таблици и баланса
// на счетоводните статии (дебит = кредит). Животът и готовността са в
// actions/system.baga (/health, /ready, /readyz).

import "../models/journal.baga"
import "acl.baga"
import "active_company.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "bagadecimal/src/decimal.baga"
import "std/str/str.baga"

// Една проверка: id, ok, детайл.
fn health_check(items: Vec<str>, oks: Vec<i64>, ids: Vec<str>, ok: i64, id: str, detail: str) -> i64 {
    vec_push(items, detail)
    vec_push(oks, ok)
    vec_push(ids, id)
    return 0
}

fn health_dec(s: str) -> Decimal {
    let p = dec_parse(s)
    if p.ok == 0 {
        return dec_zero()
    }
    return p.value
}

fn act_db_check(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_perm(ctx, db, "settings:read")?
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let mut ids: Vec<str> = vec_new()
    let mut oks: Vec<i64> = vec_new()
    let mut details: Vec<str> = vec_new()

    // Връзка.
    let c = orm_count_sql(db, "SELECT COUNT(*) AS count FROM companies")?
    if orm_ok_c(c) == 0 {
        health_check(details, oks, ids, 0, "connection", orm_err_c(c))
    } else {
        health_check(details, oks, ids, 1, "connection", "ok")
    }
    let mut d = orm_db_c(c)

    // Баланс на статии: дебит = кредит по всеки запис в дневника.
    let lq = journal_lines_all(d)?
    if orm_ok_q(lq) == 0 {
        health_check(details, oks, ids, 0, "journal_balance", orm_err_q(lq))
        d = orm_db_q(lq)
    } else {
        d = orm_db_q(lq)
        let mut deb: Map<i64, Decimal> = map_new()
        let mut cre: Map<i64, Decimal> = map_new()
        let mut order: Vec<i64> = vec_new()
        let mut i: i64 = 0
        while i < orm_nrows(lq) {
            let e = orm_cell_by_i64(lq, i, "entry_id")
            let a = health_dec(orm_cell_by(lq, i, "amount"))
            if map_has(deb, e) == 0 {
                vec_push(order, e)
            }
            if orm_cell_by(lq, i, "direction") == "debit" {
                map_set(deb, e, dec_add(map_get(deb, e), a).value)
            } else {
                map_set(cre, e, dec_add(map_get(cre, e), a).value)
            }
            i = i + 1
        }
        let mut bad: i64 = 0
        i = 0
        while i < vec_len(order) {
            let e = vec_get(order, i)
            if dec_cmp(map_get(deb, e), map_get(cre, e)) != 0 {
                bad = bad + 1
            }
            i = i + 1
        }
        if bad == 0 {
            health_check(details, oks, ids, 1, "journal_balance", "ok")
        } else {
            health_check(details, oks, ids, 0, "journal_balance", concat("несбалансирани записи: ", int_to_str(bad)))
        }
    }

    // Таблици: брой редове.
    let mut tables: Vec<str> = vec_new()
    vec_push(tables, "companies")
    vec_push(tables, "accounts")
    vec_push(tables, "counterparts")
    vec_push(tables, "products")
    vec_push(tables, "invoices")
    vec_push(tables, "invoice_lines")
    vec_push(tables, "journal_entries")
    vec_push(tables, "journal_lines")
    vec_push(tables, "users")
    vec_push(tables, "material_issues")
    vec_push(tables, "internal_docs")
    vec_push(tables, "production_orders")
    vec_push(tables, "fixed_assets")
    vec_push(tables, "audit_logs")
    vec_push(tables, "accounting_periods")
    let mut i: i64 = 0
    while i < vec_len(tables) {
        let name = vec_get(tables, i)
        let sql = concat("SELECT COUNT(*) AS count FROM ", name)
        let tq = orm_count_sql(d, sql)?
        if orm_ok_c(tq) == 0 {
            health_check(details, oks, ids, 0, name, orm_err_c(tq))
        } else {
            health_check(details, oks, ids, 1, name, int_to_str(orm_count_n(tq)))
        }
        d = orm_db_c(tq)
        i = i + 1
    }

    let mut arr = jarr_new()
    let mut all_ok: i64 = 1
    i = 0
    while i < vec_len(ids) {
        let mut o = jobj_new()
        o = jobj_str(o, "id", vec_get(ids, i))
        o = jobj_i64(o, "ok", vec_get(oks, i))
        o = jobj_str(o, "detail", vec_get(details, i))
        arr = jarr_obj(arr, o)
        if vec_get(oks, i) == 0 {
            all_ok = 0
        }
        i = i + 1
    }
    let mut out = jobj_new()
    out = jobj_i64(out, "ok", all_ok)
    out = jobj_raw(out, "checks", jarr_encode(arr))
    return act_ok(d, out)
}
