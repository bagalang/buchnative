// actions/bank_suggest.baga — предложение за сметка и контрагент при
// осчетоводяване. Първо търси правилата в базата (bank_rules.baga); ако фирмата
// няма правила, влиза във вградените шаблони (резерв, без AI ключ).

import "../models/account.baga"
import "bank_rules.baga"
import "bagadecimal/src/decimal.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

// Резервни шаблони — само ако няма записани правила за фирмата.
struct BnFallbackRule {
    keywords: str,
    numbers: Vec<str>,
    credit_only: i64,
    debit_only: i64
}

fn bank_suggest_fallback_rules() -> Vec<BnFallbackRule> {
    let r: Vec<BnFallbackRule> = vec_new()
    let mut n: Vec<str> = vec_new()
    vec_push(n, "447")
    vec_push(n, "446")
    vec_push(n, "50902")
    vec_push(r, BnFallbackRule { keywords: "POS,ПОС,pos трансакция,покупка на пос,pos purchase,card purchase,покупка с карта,покупка с дк", numbers: n, credit_only: 0, debit_only: 1 })
    n = vec_new()
    vec_push(n, "501")
    vec_push(r, BnFallbackRule { keywords: "ATM,АТМ,atm трансакция,теглене,withdrawal,cash withdrawal,теглене на каса,теглене на пари", numbers: n, credit_only: 0, debit_only: 1 })
    n = vec_new()
    vec_push(n, "629")
    vec_push(r, BnFallbackRule { keywords: "автоматична такса,такса теглене,такса за поддръжка,комисионна,bank fee,commission,месечна такса,мес. такса,monthly fee", numbers: n, credit_only: 0, debit_only: 1 })
    n = vec_new()
    vec_push(n, "411")
    vec_push(r, BnFallbackRule { keywords: "получен директен превод,получен превод,sct instant получен,incoming credit,credit transfer received", numbers: n, credit_only: 1, debit_only: 0 })
    n = vec_new()
    vec_push(n, "401")
    vec_push(r, BnFallbackRule { keywords: "издаден превод,sct instant издаден,изходящ превод,outgoing credit,issued transfer", numbers: n, credit_only: 0, debit_only: 1 })
    n = vec_new()
    vec_push(n, "402")
    vec_push(r, BnFallbackRule { keywords: "аванс,avans,advance", numbers: n, credit_only: 0, debit_only: 1 })
    return r
}

fn bank_suggest_fallback(db: OrmDb, text: str, amount: str) -> OrmQuery !IO !Net {
    let ap = dec_parse(amount)
    let mut positive: i64 = 0
    if ap.ok == 1 && dec_is_negative(ap.value) == 0 {
        positive = 1
    }
    let rules = bank_suggest_fallback_rules()
    let mut i: i64 = 0
    while i < vec_len(rules) {
        let r = vec_get(rules, i)
        if r.credit_only == 1 && positive == 0 {
            i = i + 1
        } else {
            if r.debit_only == 1 && positive == 1 {
                i = i + 1
            } else {
                if bn_rule_has_keyword(text, r.keywords) == 1 {
                    let mut j: i64 = 0
                    while j < vec_len(r.numbers) {
                        let aq = account_by_number(db, vec_get(r.numbers, j))?
                        if orm_ok_q(aq) == 1 && orm_nrows(aq) > 0 {
                            return aq
                        }
                        db = orm_db_q(aq)
                        j = j + 1
                    }
                }
                i = i + 1
            }
        }
    }
    return kv_select_by_id(db, account_table(), 0, account_cols())?
}

// Предложение за сметка: правила в базата, иначе вградените шаблони.
fn bank_suggest_account(db: OrmDb, company_id: i64, text: str, amount: str) -> OrmQuery !IO !Net {
    let hit = bank_rule_match(db, company_id, text, amount)?
    if hit.found == 1 && hit.account_id > 0 {
        let aq = account_find(db, hit.account_id)?
        if orm_ok_q(aq) == 1 && orm_nrows(aq) > 0 {
            return aq
        }
    }
    return bank_suggest_fallback(db, text, amount)?
}
