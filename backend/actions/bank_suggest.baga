// actions/bank_suggest.baga — предложение на сметка за банкова транзакция
// по ключови думи (както secret/baraba BankMatchingService). Правилата са
// вградени шаблони; първата намерена сметка по номер печели.

import "../models/account.baga"
import "bank_parse_types.baga"
import "bagadecimal/src/decimal.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

struct SuggestRule {
    name: str,
    keywords: str,
    numbers: Vec<str>,
    credit_only: i64,
    debit_only: i64
}

fn bank_suggest_rules() -> Vec<SuggestRule> {
    let r: Vec<SuggestRule> = vec_new()
    let mut n: Vec<str> = vec_new()
    vec_push(n, "447")
    vec_push(n, "446")
    vec_push(n, "50902")
    vec_push(r, SuggestRule { name: "POS покупки", keywords: "POS,ПОС,pos трансакция,покупка на пос,pos purchase,card purchase,покупка с карта,покупка с дк", numbers: n, credit_only: 0, debit_only: 1 })
    n = vec_new()
    vec_push(n, "501")
    vec_push(r, SuggestRule { name: "ATM теглене", keywords: "ATM,АТМ,atm трансакция,теглене,withdrawal,cash withdrawal,теглене на каса,теглене на пари", numbers: n, credit_only: 0, debit_only: 1 })
    n = vec_new()
    vec_push(n, "629")
    vec_push(r, SuggestRule { name: "Банкови такси", keywords: "автоматична такса,такса теглене,такса за поддръжка,комисионна,bank fee,commission,месечна такса,мес. такса,monthly fee", numbers: n, credit_only: 0, debit_only: 1 })
    n = vec_new()
    vec_push(n, "411")
    vec_push(r, SuggestRule { name: "Получен превод", keywords: "получен директен превод,получен превод,sct instant получен,incoming credit,credit transfer received", numbers: n, credit_only: 1, debit_only: 0 })
    n = vec_new()
    vec_push(n, "401")
    vec_push(r, SuggestRule { name: "Издаден превод", keywords: "издаден превод,sct instant издаден,изходящ превод,outgoing credit,issued transfer", numbers: n, credit_only: 0, debit_only: 1 })
    n = vec_new()
    vec_push(n, "402")
    vec_push(r, SuggestRule { name: "Аванс", keywords: "аванс,avans,advance", numbers: n, credit_only: 0, debit_only: 1 })
    return r
}

fn bp_has_keyword(text: str, keywords: str) -> i64 {
    let parts = str_split(keywords, ",")
    let mut i: i64 = 0
    while i < vec_len(parts) {
        let k = str_trim(vec_get(parts, i))
        if k != "" && str_find(text, k) >= 0 {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Първата намерена сметка по правилата; празна заявка (id 0), ако няма ход.
fn bank_suggest_account(db: OrmDb, company_id: i64, text: str, amount: str) -> OrmQuery !IO !Net {
    let t = bp_lower(text)
    let ap = dec_parse(amount)
    let mut positive: i64 = 0
    if ap.ok == 1 && dec_is_negative(ap.value) == 0 {
        positive = 1
    }
    let rules = bank_suggest_rules()
    let mut i: i64 = 0
    while i < vec_len(rules) {
        let r = vec_get(rules, i)
        if r.credit_only == 1 && positive == 0 {
            i = i + 1
        } else {
            if r.debit_only == 1 && positive == 1 {
                i = i + 1
            } else {
                if bp_has_keyword(t, r.keywords) == 1 {
                    let mut j: i64 = 0
                    while j < vec_len(r.numbers) {
                        let aq = account_by_number(db, vec_get(r.numbers, j))?
                        if orm_ok_q(aq) == 1 && orm_nrows(aq) > 0 {
                            return aq
                        }
                        db = orm_db_q(aq)
                        j = j + 1
                    }
                }
                i = i + 1
            }
        }
    }
    return kv_select_by_id(db, account_table(), 0, account_cols())?
}
