// actions/vat.baga — ДДС дневници и ППДДС за НАП.
// Източник: journal_entries (постнати фактури + ръчни записи с ДДС_тип).
// Ставките идват от редовете на фактурата; иначе 20% / без ДДС.
// Файлове: DEKLAR.TXT, POKUPKI.TXT, PRODAGBI.TXT (cp-1251) и ZIP.

import "../models/journal.baga"
import "../models/company.baga"
import "../models/vat_manual.baga"
import "vat_fmt.baga"
import "acl.baga"
import "vat_line.baga"
import "vat_files.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "bagadecimal/src/decimal.baga"
import "chronobaga/src/chrono.baga"
import "httpdbaga/http.baga"
import "std/str/str.baga"

struct VatPack {
    ok: i64
    err: str
    db: OrmDb
    period: str
    period_fin: str
    company_name: str
    company_vat: str
    submitter: str
    branch: str
    purchases: JArr
    sales: JArr
    cells: VatCells
    pok: bytes
    pro: bytes
    dek: bytes
    vies: bytes
    vies_parties: JArr
    vies_count: i64
}

fn vat_pack_err(db: OrmDb, err: str) -> VatPack {
    return VatPack {
        ok: 0, err: err, db: db, period: "", period_fin: "",
        company_name: "", company_vat: "", submitter: "", branch: "",
        purchases: jarr_new(), sales: jarr_new(), cells: vat_cells_empty(),
        pok: bytes_new(0), pro: bytes_new(0), dek: bytes_new(0),
        vies: bytes_new(0), vies_parties: jarr_new(), vies_count: 0
    }
}

fn vat_file_resp(db: OrmDb, data: bytes, mime: str, filename: str) -> FmrOut {
    let mut r = http_response_bytes(200, data)
    r = http_set_header(r, "Content-Type", mime)
    r = http_set_header(r, "Content-Disposition", concat(concat("attachment; filename=\"", filename), "\""))
    return fmr_out(r, db)
}

fn vat_period_ok(raw: str) -> str {
    let per = dt_period_parse(raw)
    if per.ok == 0 {
        return ""
    }
    return dt_period_to_iso(per.value)
}

fn vat_company_submitter(cq: OrmQuery) -> str {
    let an = orm_cell_by(cq, 0, "accountant_name")
    let ae = orm_cell_by(cq, 0, "accountant_egn")
    if str_trim(an) != "" || str_trim(ae) != "" {
        return vat_submitter(ae, an)
    }
    let xn = orm_cell_by(cq, 0, "authorized_person_name")
    let xe = orm_cell_by(cq, 0, "authorized_person_egn")
    if str_trim(xn) != "" || str_trim(xe) != "" {
        return vat_submitter(xe, xn)
    }
    return vat_submitter(orm_cell_by(cq, 0, "manager_egn"), orm_cell_by(cq, 0, "manager_name"))
}

// Decimal → стотинки (NUMERIC(18,2) е точно с 2 знака).
fn vat_dec_cents(d: Decimal) -> i64 {
    let m = dec_mul(d, dec_from_i64(100))
    if m.ok == 0 {
        return 0
    }
    let r = dec_to_i64(m.value)
    if r.ok == 0 {
        return 0
    }
    return r.value
}

// ДДС номерата за VIES се сортират по азбучен ред (стабилен insertion sort).
fn vat_sort_vins(vins: Vec<str>) -> Vec<str> {
    let out: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(vins) {
        vec_push(out, vec_get(vins, i))
        i = i + 1
    }
    i = 1
    let n = vec_len(out)
    while i < n {
        let v = vec_get(out, i)
        let mut j = i - 1
        let mut stop: i64 = 0
        while j >= 0 && stop == 0 {
            if kv_strcmp(vec_get(out, j), v) > 0 {
                vec_set(out, j + 1, vec_get(out, j))
                j = j - 1
            } else {
                stop = 1
            }
        }
        vec_set(out, j + 1, v)
        i = i + 1
    }
    return out
}

fn vat_base_from_total(total: str, vat: str) -> Decimal {
    return vat_dsub(vat_parse_amt(total), vat_parse_amt(vat))
}

fn vat_collect(db: OrmDb, period: str) -> VatPack !IO !Net {
    let cq = company_all(db)?
    if orm_ok_q(cq) == 0 {
        return vat_pack_err(orm_db_q(cq), orm_err_q(cq))
    }
    if orm_nrows(cq) < 1 {
        return vat_pack_err(orm_db_q(cq), "няма фирма за ДДС")
    }
    let company_id_of_pack = orm_cell_by_i64(cq, 0, "id")
    let company_name = orm_cell_by(cq, 0, "name")
    let company_vat = orm_cell_by(cq, 0, "vat_number")
    let submitter = vat_company_submitter(cq)
    let branch = orm_cell_by(cq, 0, "vat_branch_number")
    let per = dt_period_parse(period)
    let period_fin = dt_period_to_financial(per.value)
    let q = journal_by_period(orm_db_q(cq), period)?
    if orm_ok_q(q) == 0 {
        return vat_pack_err(orm_db_q(q), orm_err_q(q))
    }
    let mut db2 = orm_db_q(q)
    let mut purchases = jarr_new()
    let mut sales = jarr_new()
    let mut cells = vat_cells_empty()
    let mut pok = bytes_new(0)
    let mut pro = bytes_new(0)
    // VIES: агрегат по ДДС номер на контрагент (само ЕС, не BG).
    let mut vk3: Map<str, i64> = map_new()
    let mut vk4: Map<str, i64> = map_new()
    let mut vk5: Map<str, i64> = map_new()
    let mut vins: Vec<str> = vec_new()
    let mut i: i64 = 0
    let n = orm_nrows(q)
    while i < n {
        let vt = orm_cell_by(q, i, "vat_type")
        if vt == "purchase" || vt == "sales" {
            let mut dd = orm_cell_by(q, i, "document_date")
            if dd == "" {
                dd = orm_cell_by(q, i, "entry_date")
            }
            let base = vat_base_from_total(orm_cell_by(q, i, "total_amount"), orm_cell_by(q, i, "total_vat_amount"))
            let vat = vat_parse_amt(orm_cell_by(q, i, "total_vat_amount"))
            let mut ln = vat_from_totals(vt, base, vat, "")
            ln.doc_type = vat_doc_type(orm_cell_by(q, i, "document_type"))
            ln.doc_no = orm_cell_by(q, i, "document_number")
            ln.doc_date = dd
            ln.cp_vat = vat_with_bg(orm_cell_by(q, i, "counterpart_vat_number"))
            ln.cp_name = orm_cell_by(q, i, "counterpart_name")
            ln.goods = orm_cell_by(q, i, "description")
            let doc_id = orm_cell_by_i64(q, i, "document_id")
            if doc_id > 0 {
                let f = vat_from_invoice(db2, ln, doc_id)?
                if f.ok == 0 {
                    return vat_pack_err(f.db, f.err)
                }
                db2 = f.db
                ln = f.line
            }
            ln = vat_apply_credit(ln)
            if vt == "sales" {
                let vin = vat_vies_vin(ln.cp_vat)
                if vin != "" {
                    if map_has(vk3, vin) == 0 {
                        vec_push(vins, vin)
                        map_set(vk3, vin, 0)
                        map_set(vk4, vin, 0)
                        map_set(vk5, vin, 0)
                    }
                    map_set(vk3, vin, map_get(vk3, vin) + vat_dec_cents(ln.s_vod))
                    map_set(vk4, vin, map_get(vk4, vin) + vat_dec_cents(ln.s_tri))
                    map_set(vk5, vin, map_get(vk5, vin) + vat_dec_cents(ln.s_svc))
                }
            }
            let id = orm_cell_by_i64(q, i, "id")
            if vt == "purchase" {
                let row = cells.purch_n + 1
                cells = vat_cells_add(cells, ln)
                purchases = jarr_obj(purchases, vat_line_json(ln, id, row))
                pok = nap_cat(pok, vat_pok_line(company_vat, period_fin, branch, row, ln))
            } else {
                let row = cells.sales_n + 1
                cells = vat_cells_add(cells, ln)
                sales = jarr_obj(sales, vat_line_json(ln, id, row))
                pro = nap_cat(pro, vat_pro_line(company_vat, period_fin, branch, row, ln))
            }
        }
        i = i + 1
    }
    cells = vat_cells_finish(cells)
    // Ръчно въведени клетки за периода (същата фирма като пакета).
    let mq = vat_manual_find(db2, company_id_of_pack, period)?
    if orm_ok_q(mq) == 1 && orm_nrows(mq) > 0 {
        cells.m33 = orm_cell_by(mq, 0, "cell_33")
        cells.m70 = vat_parse_amt(orm_cell_by(mq, 0, "cell_70"))
        cells.m71 = vat_parse_amt(orm_cell_by(mq, 0, "cell_71"))
        cells.m80 = vat_parse_amt(orm_cell_by(mq, 0, "cell_80"))
        cells.m81 = vat_parse_amt(orm_cell_by(mq, 0, "cell_81"))
        cells.m82 = vat_parse_amt(orm_cell_by(mq, 0, "cell_82"))
    }
    let dek = vat_deklar(company_vat, company_name, period_fin, submitter, cells)
    // VIES: държавите се сортират по ДДС номер; нулевите агрегати се махат.
    let sv = vat_sort_vins(vins)
    let vins_out: Vec<str> = vec_new()
    let out3: Vec<i64> = vec_new()
    let out4: Vec<i64> = vec_new()
    let out5: Vec<i64> = vec_new()
    let mut vies_parties = jarr_new()
    let mut vi: i64 = 0
    while vi < vec_len(sv) {
        let vin = vec_get(sv, vi)
        let a3 = map_get(vk3, vin)
        let a4 = map_get(vk4, vin)
        let a5 = map_get(vk5, vin)
        if a3 != 0 || a4 != 0 || a5 != 0 {
            vec_push(vins_out, vin)
            vec_push(out3, a3)
            vec_push(out4, a4)
            vec_push(out5, a5)
            let mut pj = jobj_new()
            pj = jobj_str(pj, "vat_number", vin)
            pj = jobj_str(pj, "k3", nap_money_cents(a3))
            pj = jobj_str(pj, "k4", nap_money_cents(a4))
            pj = jobj_str(pj, "k5", nap_money_cents(a5))
            vies_parties = jarr_obj(vies_parties, pj)
        }
        vi = vi + 1
    }
    let dq = company_all(db2)?
    let mut d_egn = orm_cell_by(dq, 0, "accountant_egn")
    let mut d_name = orm_cell_by(dq, 0, "accountant_name")
    let mut quality = "A"
    if str_trim(d_egn) == "" && str_trim(d_name) == "" {
        d_egn = orm_cell_by(dq, 0, "authorized_person_egn")
        d_name = orm_cell_by(dq, 0, "authorized_person_name")
        if str_trim(d_egn) == "" && str_trim(d_name) == "" {
            d_egn = orm_cell_by(dq, 0, "manager_egn")
            d_name = orm_cell_by(dq, 0, "manager_name")
            quality = "R"
        }
    }
    let d_addr = orm_cell_by(dq, 0, "address")
    let d_city = orm_cell_by(dq, 0, "city")
    let d_post = orm_cell_by(dq, 0, "post_code")
    let mm = substr(period_fin, 4, 6)
    let yyyy = substr(period_fin, 0, 4)
    let vies_period = concat(mm, concat("/", yyyy))
    let vies = vat_vies_txt(company_vat, company_name, d_addr, d_egn, d_name, d_city, d_post, d_addr, quality, vies_period, vins_out, out3, out4, out5)
    return VatPack {
        ok: 1, err: "", db: db2, period: period, period_fin: period_fin,
        company_name: company_name, company_vat: vat_with_bg(company_vat),
        submitter: submitter, branch: branch,
        purchases: purchases, sales: sales, cells: cells,
        pok: pok, pro: pro, dek: dek,
        vies: vies, vies_parties: vies_parties, vies_count: vec_len(vins_out)
    }
}

fn vat_pack_json(p: VatPack) -> JObj {
    let mut o = jobj_new()
    o = jobj_str(o, "period", p.period)
    o = jobj_str(o, "period_nap", p.period_fin)
    o = jobj_str(o, "company_name", p.company_name)
    o = jobj_str(o, "company_vat", p.company_vat)
    o = jobj_str(o, "submitter", p.submitter)
    o = jobj_i64(o, "sales_count", p.cells.sales_n)
    o = jobj_i64(o, "purchase_count", p.cells.purch_n)
    o = jobj_arr(o, "purchases", p.purchases)
    o = jobj_arr(o, "sales", p.sales)
    o = jobj_obj(o, "cells", vat_cells_json(p.cells))
    o = jobj_str(o, "due", vat_money(p.cells.r50))
    o = jobj_str(o, "refund", vat_money(p.cells.r60))
    o = jobj_str(o, "cell_01", vat_money(p.cells.s01))
    o = jobj_str(o, "cell_11", vat_money(p.cells.s11))
    o = jobj_str(o, "cell_31", vat_money(p.cells.s21))
    o = jobj_str(o, "cell_41", vat_money(p.cells.p31))
    o = jobj_str(o, "cell_71", vat_money(p.cells.p41))
    o = jobj_str(o, "cell_81", vat_money(p.cells.r50))
    o = jobj_str(o, "cell_82", vat_money(p.cells.r60))
    o = jobj_arr(o, "vies_parties", p.vies_parties)
    o = jobj_i64(o, "vies_count", p.vies_count)
    o = jobj_str(o, "manual_cell_33", p.cells.m33)
    o = jobj_str(o, "manual_cell_70", vat_money(p.cells.m70))
    o = jobj_str(o, "manual_cell_71", vat_money(p.cells.m71))
    o = jobj_str(o, "manual_cell_80", vat_money(p.cells.m80))
    o = jobj_str(o, "manual_cell_81", vat_money(p.cells.m81))
    o = jobj_str(o, "manual_cell_82", vat_money(p.cells.m82))
    return o
}

fn vat_need_period(ctx: FmrCtx, db: OrmDb) -> FmrOut {
    return act_err(db, 400, "period е задължителен (YYYY-MM)")
}

fn act_vat_registers(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_perm(ctx, db, "vat:read")?
    if auth.ok == 0 {
        return auth.out
    }
    let raw = fmr_query(ctx, "period")
    let period = vat_period_ok(raw)
    if period == "" {
        if raw == "" {
            return vat_need_period(ctx, db)
        }
        return act_err(db, 400, "period трябва да е YYYY-MM или YYYYMM")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let p = vat_collect(db, period)?
    if p.ok == 0 {
        return act_err(p.db, 500, p.err)
    }
    return act_ok(p.db, vat_pack_json(p))
}

fn act_vat_return(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    return act_vat_registers(ctx, db)?
}

fn act_vat_export(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_perm(ctx, db, "vat:read")?
    if auth.ok == 0 {
        return auth.out
    }
    let raw = fmr_query(ctx, "period")
    let period = vat_period_ok(raw)
    if period == "" {
        if raw == "" {
            return vat_need_period(ctx, db)
        }
        return act_err(db, 400, "period трябва да е YYYY-MM или YYYYMM")
    }
    let kind = fmr_query(ctx, "type")
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let p = vat_collect(db, period)?
    if p.ok == 0 {
        return act_err(p.db, 500, p.err)
    }
    if kind == "pokupki" {
        return vat_file_resp(p.db, p.pok, "text/plain; charset=windows-1251", "POKUPKI.TXT")
    }
    if kind == "prodagbi" || kind == "prodajbi" {
        return vat_file_resp(p.db, p.pro, "text/plain; charset=windows-1251", "PRODAGBI.TXT")
    }
    if kind == "vies" {
        let nm = concat(concat("VIES_", p.period_fin), ".TXT")
        return vat_file_resp(p.db, p.vies, "text/plain; charset=windows-1251", nm)
    }
    if kind == "zip" {
        let z = vat_zip3(p.dek, p.pok, p.pro)
        return vat_file_resp(p.db, z, "application/zip", concat(concat("PPDDS_", p.period_fin), ".zip"))
    }
    return vat_file_resp(p.db, p.dek, "text/plain; charset=windows-1251", "DEKLAR.TXT")
}

// Запис на ръчно въведените ДДС клетки за период.
fn act_vat_manual_save(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_perm(ctx, db, "vat:read")?
    if auth.ok == 0 {
        return auth.out
    }
    let raw = fmr_query(ctx, "period")
    let period = vat_period_ok(raw)
    if period == "" {
        if raw == "" {
            return vat_need_period(ctx, db)
        }
        return act_err(db, 400, "period трябва да е YYYY-MM или YYYYMM")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let c33 = vat_manual_field(b.doc, b.root, "cell_33", "0.00")
    let c70 = vat_manual_field(b.doc, b.root, "cell_70", "0")
    let c71 = vat_manual_field(b.doc, b.root, "cell_71", "0")
    let c80 = vat_manual_field(b.doc, b.root, "cell_80", "0")
    let c81 = vat_manual_field(b.doc, b.root, "cell_81", "0")
    let c82 = vat_manual_field(b.doc, b.root, "cell_82", "0")
    let cq = company_all(db)?
    if orm_ok_q(cq) == 0 || orm_nrows(cq) < 1 {
        return act_err(orm_db_q(cq), 422, "няма фирма за ДДС")
    }
    let cid = orm_cell_by_i64(cq, 0, "id")
    let sv = vat_manual_save(orm_db_q(cq), cid, period, c33, c70, c71, c80, c81, c82)?
    if orm_ok(sv) == 0 {
        return act_err(orm_db_exec(sv), 500, orm_err_exec(sv))
    }
    let p = vat_collect(orm_db_exec(sv), period)?
    if p.ok == 0 {
        return act_err(p.db, 500, p.err)
    }
    return act_ok(p.db, vat_pack_json(p))
}

fn vat_manual_field(d: JsonDoc, root: i64, key: str, def: str) -> str {
    let f = jopt_str(d, root, key, def)
    return f.val
}
