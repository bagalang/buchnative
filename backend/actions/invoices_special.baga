// actions/invoices_special.baga — протокол по чл. 117 ЗДДС и митническа декларация.
//
// Протокол (09): Дт 4531 / Кт 4532 за начисления ДДС към входяща фактура.
// Митническа декларация (07): Дт разход (мито) / Дт 4531 (митническо ДДС) /
// Кт 458 (Разчети с митници) — кредитира се митницата, не доставчикът.
// Постингът се прави веднага (документът се създава като чернова и се поства).

import "../models/invoice.baga"
import "invoices_post.baga"
import "acl.baga"
import "audit.baga"
import "active_company.baga"
import "document_series.baga"
import "vat_fmt.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"

// ДДС от нетна сума и ставка (проценти), закръглено на 2 знака.
fn vat_calc(net: str, rate: str) -> str {
    let n = vat_parse_amt(net)
    let r = vat_parse_amt(rate)
    let m = dec_mul(n, r)
    if m.ok == 0 {
        return "0.00"
    }
    let p = dec_div_scale(m.value, vat_parse_amt("100"), 2)
    if p.ok == 0 {
        return "0.00"
    }
    return vat_money(p.value)
}

fn inv_month(date: str) -> str {
    return substr(date, 0, 7)
}

fn act_invoices_issue_protocol(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_perm(ctx, db, "accounting:post")?
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let article = jopt_str(b.doc, b.root, "vat_article", "чл. 117")
    let rate = jopt_str(b.doc, b.root, "vat_rate", "20")
    let issue_raw = jopt_str(b.doc, b.root, "issue_date", "")
    let number_raw = jopt_str(b.doc, b.root, "number", "")
    let iq = invoice_find(db, id)?
    if orm_ok_q(iq) == 0 || orm_nrows(iq) < 1 {
        return act_404(orm_db_q(iq), "Invoice not found")
    }
    let ac_spec = active_company_id(orm_db_q(iq), auth.ctx.user_sub)?
    if orm_cell_by_i64(iq, 0, "company_id") != ac_spec.id {
        return act_404(ac_spec.db, "Invoice not found")
    }
    let d0 = orm_db_q(iq)
    if orm_cell_by(iq, 0, "direction") != "in" {
        return act_err(d0, 422, "протокол по чл. 117 се издава само към входяща фактура")
    }
    let src_number = orm_cell_by(iq, 0, "number")
    let src_date = orm_cell_by(iq, 0, "issue_date")
    let mut issue_date = src_date
    if str_trim(issue_raw.val) != "" {
        issue_date = str_trim(issue_raw.val)
    }
    let mut number = invoice_auto_number(d0, "09", "in", ac_spec.id)
    if str_trim(number_raw.val) != "" {
        number = str_trim(number_raw.val)
    }
    let month = inv_month(issue_date)
    let notes = concat("Протокол по ", concat(article.val, concat(" от ЗДДС към входяща фактура № ", concat(src_number, concat(" от ", src_date)))))
    let hq = invoice_create_header(d0, "in", number, "09", id, issue_date, "", issue_date, month, orm_cell_by_i64(iq, 0, "counterpart_id"), orm_cell_by(iq, 0, "currency"), orm_cell_by(iq, 0, "currency_rate"), "", notes, "0", "0", "", 0, auth.ctx.user_sub)?
    if orm_ok_q(hq) == 0 || orm_nrows(hq) < 1 {
        return act_err(orm_db_q(hq), 500, orm_err_q(hq))
    }
    let new_id = orm_cell_by_i64(hq, 0, "id")
    let mut d1 = orm_db_q(hq)
    let sp = invoice_set_special(d1, new_id, article.val, "", "", "")?
    d1 = orm_db_exec(sp)
    // Редовете: същите като източника, с ДДС преизчислено по ставката.
    let lq = invoice_lines_by_invoice(d1, id)?
    let mut nlines: i64 = 0
    if orm_ok_q(lq) == 1 {
        nlines = orm_nrows(lq)
    }
    if nlines == 0 {
        let net = orm_cell_by(iq, 0, "net_amount")
        let vat = vat_calc(net, rate.val)
        let tot = vat_dadd(vat_parse_amt(net), vat_parse_amt(vat))
        let li = invoice_line_insert(d1, new_id, 0, 0, concat("Протокол по ", concat(article.val, concat(" към фактура № ", src_number))), "1", "C62", net, net, rate.val, vat, vat_money(tot))?
        if orm_ok(li) == 0 {
            return act_err(orm_db_exec(li), 500, orm_err_exec(li))
        }
        d1 = orm_db_exec(li)
    } else {
        let mut i: i64 = 0
        while i < nlines {
            let net = orm_cell_by(lq, i, "net_amount")
            let src_rate = orm_cell_by(lq, i, "vat_rate")
            let mut r = rate.val
            if src_rate != "" && src_rate != "0" && src_rate != "0.00" {
                r = src_rate
            }
            let vat = vat_calc(net, r)
            let tot = vat_dadd(vat_parse_amt(net), vat_parse_amt(vat))
            let li = invoice_line_insert(d1, new_id, orm_cell_by_i64(lq, i, "product_id"), 0, orm_cell_by(lq, i, "description"), orm_cell_by(lq, i, "quantity"), orm_cell_by(lq, i, "unit"), orm_cell_by(lq, i, "unit_price"), net, r, vat, vat_money(tot))?
            if orm_ok(li) == 0 {
                return act_err(orm_db_exec(li), 500, orm_err_exec(li))
            }
            d1 = orm_db_exec(li)
            i = i + 1
        }
    }
    let rc = invoice_recalc_totals(d1, new_id)?
    if orm_ok(rc) == 0 {
        return act_err(orm_db_exec(rc), 500, orm_err_exec(rc))
    }
    let out = invoice_post_one(orm_db_exec(rc), new_id, auth.ctx.user_sub)?
    let acp = active_company_id(out.db, auth.ctx.user_sub)?
    let aq = invoice_find(acp.db, new_id)?
    if orm_ok_q(aq) == 1 && orm_nrows(aq) > 0 {
        audit_record(orm_db_q(aq), acp.id, auth.ctx.user_sub, "invoice", new_id, number, "create", concat("Създаден Протокол по ", concat(article.val, concat(" № ", number))), "", orm_cell_by(aq, 0, "total_amount"), "")
    }
    return out
}

fn act_invoices_issue_customs(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_perm(ctx, db, "accounting:post")?
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let mrn = jreq_str(b.doc, b.root, "number")
    if mrn.ok == 0 || str_trim(mrn.val) == "" {
        return act_422_field(db, "number", mrn)
    }
    let issue_raw = jopt_str(b.doc, b.root, "issue_date", "")
    let stat_raw = jopt_str(b.doc, b.root, "customs_statistical", "")
    let duty_raw = jopt_str(b.doc, b.root, "customs_duty", "0")
    let vat_raw = jopt_str(b.doc, b.root, "customs_vat", "")
    let iq = invoice_find(db, id)?
    if orm_ok_q(iq) == 0 || orm_nrows(iq) < 1 {
        return act_404(orm_db_q(iq), "Invoice not found")
    }
    let ac_spec = active_company_id(orm_db_q(iq), auth.ctx.user_sub)?
    if orm_cell_by_i64(iq, 0, "company_id") != ac_spec.id {
        return act_404(ac_spec.db, "Invoice not found")
    }
    let d0 = orm_db_q(iq)
    if orm_cell_by(iq, 0, "direction") != "in" {
        return act_err(d0, 422, "митническа декларация се издава само към входяща фактура")
    }
    let src_number = orm_cell_by(iq, 0, "number")
    let src_date = orm_cell_by(iq, 0, "issue_date")
    let src_name = orm_cell_by(iq, 0, "counterpart_name")
    let mut issue_date = src_date
    if str_trim(issue_raw.val) != "" {
        issue_date = str_trim(issue_raw.val)
    }
    let mut stat = orm_cell_by(iq, 0, "net_amount")
    if str_trim(stat_raw.val) != "" {
        stat = str_trim(stat_raw.val)
    }
    let duty = str_trim(duty_raw.val)
    let vat_given = str_trim(vat_raw.val)
    let base = vat_dadd(vat_parse_amt(stat), vat_parse_amt(duty))
    let mut customs_vat = vat_calc(vat_money(base), "20")
    if vat_given != "" {
        customs_vat = vat_given
    }
    let month = inv_month(issue_date)
    let mrn_s = str_trim(mrn.val)
    let mut desc = "Митническа декларация № "
    desc = concat(desc, mrn_s)
    desc = concat(desc, " към фактура № ")
    desc = concat(desc, src_number)
    desc = concat(desc, " (Стат. ст-ст ")
    desc = concat(desc, vat_money(base))
    desc = concat(desc, ", Мито ")
    desc = concat(desc, duty)
    desc = concat(desc, ")")
    let mut notes = "Митническа декларация № "
    notes = concat(notes, mrn_s)
    notes = concat(notes, " към фактура № ")
    notes = concat(notes, src_number)
    notes = concat(notes, " (")
    notes = concat(notes, src_name)
    notes = concat(notes, ") — Разчети с митници")
    let hq = invoice_create_header(d0, "in", str_trim(mrn.val), "07", id, issue_date, "", issue_date, month, 0, "EUR", "1", "", notes, "0", "0", "", 0, auth.ctx.user_sub)?
    if orm_ok_q(hq) == 0 || orm_nrows(hq) < 1 {
        return act_err(orm_db_q(hq), 500, orm_err_q(hq))
    }
    let new_id = orm_cell_by_i64(hq, 0, "id")
    let mut d1 = orm_db_q(hq)
    let sp = invoice_set_special(d1, new_id, "", vat_money(base), duty, customs_vat)?
    d1 = orm_db_exec(sp)
    let tot = vat_dadd(vat_parse_amt(vat_money(base)), vat_parse_amt(customs_vat))
    let li = invoice_line_insert(d1, new_id, 0, 0, desc, "1", "C62", vat_money(base), vat_money(base), "20.00", customs_vat, vat_money(tot))?
    if orm_ok(li) == 0 {
        return act_err(orm_db_exec(li), 500, orm_err_exec(li))
    }
    d1 = orm_db_exec(li)
    let rc = invoice_recalc_totals(d1, new_id)?
    if orm_ok(rc) == 0 {
        return act_err(orm_db_exec(rc), 500, orm_err_exec(rc))
    }
    let out = invoice_post_one(orm_db_exec(rc), new_id, auth.ctx.user_sub)?
    let acp = active_company_id(out.db, auth.ctx.user_sub)?
    let aq = invoice_find(acp.db, new_id)?
    if orm_ok_q(aq) == 1 && orm_nrows(aq) > 0 {
        audit_record(orm_db_q(aq), acp.id, auth.ctx.user_sub, "invoice", new_id, str_trim(mrn.val), "create", concat("Създадена Митническа декларация № ", concat(str_trim(mrn.val), concat(" към фактура № ", src_number))), "", orm_cell_by(aq, 0, "total_amount"), "")
    }
    return out
}
