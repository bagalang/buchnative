// actions/fx_report.baga — валутни позиции: справка „отворени валутни позиции"
// и преоценка към дата (курсови разлики по 624/724).
//
// Отворена позиция = група journal_lines по (account_id, counterpart_id,
// currency) с currency != "": количество = Σ (debit ? +fx_quantity : −fx_quantity),
// салдо в основната валута = Σ (debit ? +amount : −amount) — включително
// преоценъчните редове (те носят currency, но fx_quantity=0, за да не местят
// количеството, а само base салдото).
// Преоценка: diff = qty × курс(as-of date) − base_saldo; diff ≠ 0 → запис
// Дт/Кт валутната сметка |diff| и Кт 724 (diff>0) / Дт 624 (diff<0).

import "../models/journal.baga"
import "../models/account.baga"
import "../models/counterpart.baga"
import "../models/fx.baga"
import "../models/exchange_rate.baga"
import "active_company.baga"
import "periods.baga"
import "acl.baga"
import "audit.baga"
import "txn.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "std/str/str.baga"
import "bagadecimal/src/decimal.baga"

struct FxGroup {
    account_id: i64,
    counterpart_id: i64,
    currency: str,
    qty: Decimal,
    base: Decimal,
    rate: str,
    rate_date: str,
    revalued: Decimal,
    diff: Decimal
}

struct FxGroups {
    ok: i64,
    err: str,
    db: OrmDb,
    groups: Vec<FxGroup>,
    base: str
}

// Всички отворени валутни позиции на фирмата към дата (entry_date <= date).
// Връща и db (през последния заявен курс).
fn fx_open_groups(db: OrmDb, company_id: i64, date: str) -> FxGroups !IO !Net {
    let lq = journal_lines_fx_all(db)?
    if orm_ok_q(lq) == 0 {
        return FxGroups { ok: 0, err: orm_err_q(lq), db: orm_db_q(lq), groups: vec_new(), base: "" }
    }
    let mut d0 = orm_db_q(lq)
    let bc = company_base_currency(d0, company_id)?
    if bc.ok == 0 {
        return FxGroups { ok: 0, err: "фирмата липсва", db: bc.db, groups: vec_new(), base: "" }
    }
    d0 = bc.db
    let mut idx: Map<str, i64> = map_new()
    let mut groups: Vec<FxGroup> = vec_new()
    let mut i: i64 = 0
    while i < orm_nrows(lq) {
        let cur = orm_cell_by(lq, i, "currency")
        if cur != "" && orm_cell_by_i64(lq, i, "company_id") == company_id {
            let edate = orm_cell_by(lq, i, "entry_date")
            if er_str_cmp(edate, date) <= 0 {
                let acc = orm_cell_by_i64(lq, i, "account_id")
                let cp = orm_cell_by_i64(lq, i, "counterpart_id")
                let key = concat(concat(int_to_str(acc), "|"), concat(int_to_str(cp), concat("|", cur)))
                let mut gi: i64 = 0 - 1
                if map_has(idx, key) == 1 {
                    gi = map_get(idx, key)
                } else {
                    gi = vec_len(groups)
                    map_set(idx, key, gi)
                    let mut g = FxGroup { account_id: acc, counterpart_id: cp, currency: cur, qty: dec_zero(), base: dec_zero(), rate: "", rate_date: "", revalued: dec_zero(), diff: dec_zero() }
                    vec_push(groups, g)
                }
                let mut g = vec_get(groups, gi)
                let qp = dec_parse(orm_cell_by(lq, i, "fx_quantity"))
                let ap = dec_parse(orm_cell_by(lq, i, "amount"))
                let mut q = dec_zero()
                if qp.ok == 1 {
                    q = qp.value
                }
                let mut a = dec_zero()
                if ap.ok == 1 {
                    a = ap.value
                }
                if orm_cell_by(lq, i, "direction") == "debit" {
                    let s1 = dec_add(g.qty, q)
                    if s1.ok == 1 { g.qty = s1.value }
                    let s2 = dec_add(g.base, a)
                    if s2.ok == 1 { g.base = s2.value }
                } else {
                    let s1 = dec_sub(g.qty, q)
                    if s1.ok == 1 { g.qty = s1.value }
                    let s2 = dec_sub(g.base, a)
                    if s2.ok == 1 { g.base = s2.value }
                }
                vec_set(groups, gi, g)
            }
        }
        i = i + 1
    }
    // Курс към датата за всяка валута + преоценена стойност и разлика.
    i = 0
    while i < vec_len(groups) {
        let mut g = vec_get(groups, i)
        if dec_is_zero(g.qty) == 0 {
            let c = exchange_rate_cross(d0, g.currency, bc.cur, date)?
            if c.ok == 0 {
                return FxGroups { ok: 0, err: c.err, db: c.db, groups: groups, base: bc.cur }
            }
            d0 = c.db
            let rp = dec_parse(c.rate)
            if rp.ok == 1 {
                g.rate = c.rate
                g.rate_date = c.rate_date
                let m = dec_mul(g.qty, rp.value)
                if m.ok == 1 {
                    let r2 = dec_round_dp(m.value, 2)
                    if r2.ok == 1 {
                        g.revalued = r2.value
                        let dd = dec_sub(g.revalued, g.base)
                        if dd.ok == 1 {
                            g.diff = dd.value
                        }
                    }
                }
            }
        }
        vec_set(groups, i, g)
        i = i + 1
    }
    return FxGroups { ok: 1, err: "", db: d0, groups: groups, base: bc.cur }
}

fn fx_group_json(g: FxGroup, acc_number: str, acc_name: str, cp_name: str, base: str) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "account_id", g.account_id)
    o = jobj_str(o, "account_number", acc_number)
    o = jobj_str(o, "account_name", acc_name)
    if g.counterpart_id > 0 {
        o = jobj_i64(o, "counterpart_id", g.counterpart_id)
        o = jobj_str(o, "counterpart_name", cp_name)
    }
    o = jobj_str(o, "currency", g.currency)
    o = jobj_str(o, "fx_quantity", dec_to_string(g.qty))
    o = jobj_str(o, "base_amount", dec_to_string(g.base))
    o = jobj_str(o, "rate", g.rate)
    o = jobj_str(o, "rate_date", g.rate_date)
    o = jobj_str(o, "revalued", dec_to_string(g.revalued))
    o = jobj_str(o, "diff", dec_to_string(g.diff))
    o = jobj_str(o, "base_currency", base)
    return o
}

// GET /v1/fx/open-items?date=YYYY-MM-DD — отворени валутни позиции към дата.
fn act_fx_open_items(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_perm(ctx, db, "accounting:read")?
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let date = str_trim(fmr_query(ctx, "date"))
    if date == "" {
        return act_err(ac.db, 400, "date е задължителен (YYYY-MM-DD)")
    }
    let fg = fx_open_groups(ac.db, ac.id, date)?
    if fg.ok == 0 {
        return act_err(fg.db, 422, fg.err)
    }
    let aq = account_all(fg.db)?
    if orm_ok_q(aq) == 0 {
        return act_err(orm_db_q(aq), 500, orm_err_q(aq))
    }
    let cq = counterpart_all_co(orm_db_q(aq), ac.id)?
    if orm_ok_q(cq) == 0 {
        return act_err(orm_db_q(cq), 500, orm_err_q(cq))
    }
    let mut arr = jarr_new()
    let mut count: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(fg.groups) {
        let g = vec_get(fg.groups, i)
        if dec_is_zero(g.qty) == 0 {
            count = count + 1
            let mut an = ""
            let mut anm = ""
            let mut j: i64 = 0
            while j < orm_nrows(aq) {
                if orm_cell_by_i64(aq, j, "id") == g.account_id {
                    an = orm_cell_by(aq, j, "number")
                    anm = orm_cell_by(aq, j, "name")
                    j = orm_nrows(aq)
                } else {
                    j = j + 1
                }
            }
            let mut cn = ""
            j = 0
            while j < orm_nrows(cq) {
                if orm_cell_by_i64(cq, j, "id") == g.counterpart_id {
                    cn = orm_cell_by(cq, j, "name")
                    j = orm_nrows(cq)
                } else {
                    j = j + 1
                }
            }
            arr = jarr_obj(arr, fx_group_json(g, an, anm, cn, fg.base))
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_str(o, "date", date)
    o = jobj_str(o, "base_currency", fg.base)
    o = jobj_arr(o, "items", arr)
    o = jobj_i64(o, "count", count)
    return act_ok(orm_db_q(cq), o)
}

// POST /v1/fx/revalue {date} — преоценка на отворените валутни позиции към
// датата: за всяка с diff ≠ 0 нов запис (тип fx_revalue) с ред по валутната
// сметка (|diff|, посока по знака на diff) и кореспондиращ ред 724 (приход,
// diff>0) / 624 (разход, diff<0). Преоценъчният ред носи currency и
// fx_quantity=0 — мести само base салдото, не количеството.
fn act_fx_revalue(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_perm(ctx, db, "accounting:write")?
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(ac.db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(ac.db, 400, b.err)
    }
    let date_f = jreq_str(b.doc, b.root, "date")
    if date_f.ok == 0 {
        return act_422_field(ac.db, "date", date_f)
    }
    let date = date_f.val
    let pc = period_assert_open(ac.db, ac.id, date)?
    if pc.ok == 0 {
        return act_err(pc.db, 422, pc.err)
    }
    let fg = fx_open_groups(pc.db, ac.id, date)?
    if fg.ok == 0 {
        return act_err(fg.db, 422, fg.err)
    }
    let mut d0 = fg.db
    let q624 = account_by_number(d0, "624")?
    if orm_ok_q(q624) == 0 {
        return act_err(orm_db_q(q624), 500, orm_err_q(q624))
    }
    if orm_nrows(q624) < 1 {
        return act_err(orm_db_q(q624), 422, "липсва сметка 624 (Разходи от валутни операции)")
    }
    d0 = orm_db_q(q624)
    let acc624 = orm_cell_by_i64(q624, 0, "id")
    let q724 = account_by_number(d0, "724")?
    if orm_ok_q(q724) == 0 {
        return act_err(orm_db_q(q724), 500, orm_err_q(q724))
    }
    if orm_nrows(q724) < 1 {
        return act_err(orm_db_q(q724), 422, "липсва сметка 724 (Приходи от валутни операции)")
    }
    d0 = orm_db_q(q724)
    let acc724 = orm_cell_by_i64(q724, 0, "id")
    let bgn = bb_begin(d0)?
    if orm_ok(bgn) == 0 {
        return act_err(orm_db_exec(bgn), 500, orm_err_exec(bgn))
    }
    let mut db2 = orm_db_exec(bgn)
    let mut revalued: i64 = 0
    let mut diff_total = dec_zero()
    let mut i: i64 = 0
    while i < vec_len(fg.groups) {
        let g = vec_get(fg.groups, i)
        if dec_is_zero(g.qty) == 0 && dec_is_zero(g.diff) == 0 {
            let diff_abs = dec_abs(g.diff)
            let diff_s = dec_to_string(diff_abs)
            let mut acc_dir = "debit"
            let mut pl_acc = acc724
            let mut pl_dir = "credit"
            if dec_is_negative(g.diff) != 0 {
                acc_dir = "credit"
                pl_acc = acc624
                pl_dir = "debit"
            }
            let desc = concat("Валутна преоценка към ", concat(date, concat(" — ", concat(g.currency, concat(" (курс ", concat(g.rate, ")"))))))
            let eq = journal_entry_insert(db2, date, "fx_revalue", 0, desc, "no_vat", g.counterpart_id, "", "", "", date, "", diff_s, "0", ac.id)?
            if orm_ok_q(eq) == 0 || orm_nrows(eq) < 1 {
                return act_err_rb(orm_db_q(eq), 500, "journal entry insert failed")
            }
            let entry_id = orm_cell_by_i64(eq, 0, "id")
            db2 = orm_db_q(eq)
            // Ред по валутната сметка: fx_quantity=0 (преоценка само на base сумата).
            let l1 = journal_line_insert_fx(db2, entry_id, g.account_id, acc_dir, diff_s, "0", g.currency, "0", g.rate, g.counterpart_id, 0, 0)?
            if orm_ok(l1) == 0 {
                return act_err_rb(orm_db_exec(l1), 500, orm_err_exec(l1))
            }
            db2 = orm_db_exec(l1)
            let l2 = journal_line_insert(db2, entry_id, pl_acc, pl_dir, diff_s, "0", 0, 0, 0)?
            if orm_ok(l2) == 0 {
                return act_err_rb(orm_db_exec(l2), 500, orm_err_exec(l2))
            }
            db2 = orm_db_exec(l2)
            let dt = dec_add(diff_total, g.diff)
            if dt.ok == 1 {
                diff_total = dt.value
            }
            revalued = revalued + 1
        }
        i = i + 1
    }
    let cmt = bb_commit(db2)?
    if orm_ok(cmt) == 0 {
        return act_err_rb(orm_db_exec(cmt), 500, orm_err_exec(cmt))
    }
    db2 = orm_db_exec(cmt)
    audit_record(db2, ac.id, auth.ctx.user_sub, "fx_revalue", 0, date, "create", concat("Валутна преоценка към ", date), "", dec_to_string(diff_total), "")
    let mut o = jobj_new()
    o = jobj_str(o, "date", date)
    o = jobj_i64(o, "revalued", revalued)
    o = jobj_str(o, "diff_total", dec_to_string(diff_total))
    o = jobj_str(o, "base_currency", fg.base)
    return act_ok(db2, o)
}
