// actions/fixed_assets.baga — ДМА: категории, активи, амортизация.
// Амортизацията (линейна/намаляващ остатък, счетоводна + данъчна норма)
// се изчислява с багадесимал и при пост генерира счетоводен запис
// Дт 603 / Кт 241 (сметките от категорията, иначе по подразбиране).

import "../models/fixed_asset.baga"
import "../models/account.baga"
import "../models/journal.baga"
import "fmrbaga/app.baga"
import "fmrbaga/ctx.baga"
import "fmrbaga/action.baga"
import "fmrbaga/jsonx.baga"
import "ormbaga/orm.baga"
import "bagadecimal/src/decimal.baga"
import "fixed_assets_ops.baga"
import "active_company.baga"
import "periods.baga"
import "std/str/str.baga"

// ---------- категории ----------

fn act_fa_categories_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = fac_all(db)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    return act_ok(orm_db_q(q), fac_list_json(q))
}

fn act_fa_categories_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.ok == 0 {
        return act_422_field(db, "name", name)
    }
    let cita_category = jopt_str(b.doc, b.root, "cita_category", "")
    let min_rate = jopt_str(b.doc, b.root, "min_depreciation_rate", "0")
    let max_rate = jopt_str(b.doc, b.root, "max_depreciation_rate", "0")
    let default_method = jopt_str(b.doc, b.root, "default_method", "linear")
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let cq = fac_create(db, name.val, cita_category.val, min_rate.val, max_rate.val, default_method.val, 0, 0, 0)?
    if orm_ok_q(cq) == 0 || orm_nrows(cq) < 1 {
        return act_err(orm_db_q(cq), 500, "category insert failed")
    }
    let new_id = orm_cell_by_i64(cq, 0, "id")
    let q = fac_find(orm_db_q(cq), new_id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 500, "category missing after create")
    }
    return act_created(orm_db_q(q), fac_to_json(q, 0))
}

fn act_fa_categories_update(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let cols = vec_new()
    let vals = vec_new()
    let name = jreq_str(b.doc, b.root, "name")
    if name.present == 1 {
        if name.ok == 0 {
            return act_422_field(db, "name", name)
        }
        vec_push(cols, "name")
        vec_push(vals, name.val)
    }
    let cita_category = jreq_str(b.doc, b.root, "cita_category")
    if cita_category.present == 1 {
        if cita_category.ok == 0 {
            return act_422_field(db, "cita_category", cita_category)
        }
        vec_push(cols, "cita_category")
        vec_push(vals, cita_category.val)
    }
    let min_rate = jreq_str(b.doc, b.root, "min_depreciation_rate")
    if min_rate.present == 1 {
        if min_rate.ok == 0 {
            return act_422_field(db, "min_depreciation_rate", min_rate)
        }
        vec_push(cols, "min_depreciation_rate")
        vec_push(vals, min_rate.val)
    }
    let max_rate = jreq_str(b.doc, b.root, "max_depreciation_rate")
    if max_rate.present == 1 {
        if max_rate.ok == 0 {
            return act_422_field(db, "max_depreciation_rate", max_rate)
        }
        vec_push(cols, "max_depreciation_rate")
        vec_push(vals, max_rate.val)
    }
    let default_method = jreq_str(b.doc, b.root, "default_method")
    if default_method.present == 1 {
        if default_method.ok == 0 {
            return act_422_field(db, "default_method", default_method)
        }
        vec_push(cols, "default_method")
        vec_push(vals, default_method.val)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    if vec_len(cols) == 0 {
        let q0 = fac_find(db, id)?
        if orm_ok_q(q0) == 0 || orm_nrows(q0) < 1 {
            return act_404(orm_db_q(q0), "Category not found")
        }
        return act_ok(orm_db_q(q0), fac_to_json(q0, 0))
    }
    let upd = orm_update_by_id(db, fac_table(), id, cols, vals)?
    if orm_ok(upd) == 0 {
        return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
    }
    let q = fac_find(orm_db_exec(upd), id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Category not found")
    }
    return act_ok(orm_db_q(q), fac_to_json(q, 0))
}

fn act_fa_categories_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let del = fac_delete(db, id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    return act_no_content(orm_db_exec(del))
}

// ---------- активи ----------

fn act_fa_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    let q = fa_all_co(ac.db, ac.id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    return act_ok(orm_db_q(q), fa_list_json(q))
}

fn act_fa_create(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.ok == 0 {
        return act_422_field(db, "name", name)
    }
    let inventory_number = jopt_str(b.doc, b.root, "inventory_number", "")
    let cid = jreq_i64(b.doc, b.root, "category_id")
    let mut category_id: i64 = 0
    if cid.present == 1 {
        if cid.ok == 0 {
            return act_422_field(db, "category_id", cid)
        }
        category_id = cid.num
    }
    let acquisition_date = jopt_str(b.doc, b.root, "acquisition_date", "")
    let put_into_service_date = jopt_str(b.doc, b.root, "put_into_service_date", "")
    let cost = jopt_str(b.doc, b.root, "cost", "0")
    let salvage_value = jopt_str(b.doc, b.root, "salvage_value", "0")
    let useful_life_months = jopt_str(b.doc, b.root, "useful_life_months", "0")
    let depreciation_method = jopt_str(b.doc, b.root, "depreciation_method", "linear")
    let accounting_rate = jopt_str(b.doc, b.root, "accounting_depreciation_rate", "0")
    let tax_rate = jopt_str(b.doc, b.root, "tax_depreciation_rate", "0")
    let status = jopt_str(b.doc, b.root, "status", "active")
    let serial_number = jopt_str(b.doc, b.root, "serial_number", "")
    let manufacturer = jopt_str(b.doc, b.root, "manufacturer", "")
    let model = jopt_str(b.doc, b.root, "model", "")
    let responsible_person = jopt_str(b.doc, b.root, "responsible_person", "")
    let loc = jreq_i64(b.doc, b.root, "location_id")
    let mut location_id: i64 = 0
    if loc.present == 1 {
        if loc.ok == 0 {
            return act_422_field(db, "location_id", loc)
        }
        location_id = loc.num
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let cq = fa_create(ac.db, name.val, inventory_number.val, category_id, acquisition_date.val, put_into_service_date.val, cost.val, salvage_value.val, useful_life_months.val, depreciation_method.val, accounting_rate.val, tax_rate.val, status.val, serial_number.val, manufacturer.val, model.val, responsible_person.val, 0, ac.id)?
    if orm_ok_q(cq) == 0 || orm_nrows(cq) < 1 {
        return act_err(orm_db_q(cq), 500, "asset insert failed")
    }
    let new_id = orm_cell_by_i64(cq, 0, "id")
    let mut dfa = orm_db_q(cq)
    if location_id > 0 {
        let lcols = vec_new()
        vec_push(lcols, "location_id")
        let lvals = vec_new()
        vec_push(lvals, int_to_str(location_id))
        let lup = orm_update_by_id(dfa, fa_table(), new_id, lcols, lvals)?
        if orm_ok(lup) == 0 {
            return act_err(orm_db_exec(lup), 500, orm_err_exec(lup))
        }
        dfa = orm_db_exec(lup)
    }
    let q = fa_find(dfa, new_id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_err(orm_db_q(q), 500, "asset missing after create")
    }
    return act_created(orm_db_q(q), fa_to_json(q, 0))
}

fn act_fa_show(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let q = fa_find(db, id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    if orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Asset not found")
    }
    let ac = active_company_id(orm_db_q(q), auth.ctx.user_sub)?
    if orm_cell_by_i64(q, 0, "company_id") != ac.id {
        return act_404(ac.db, "Asset not found")
    }
    return act_ok(ac.db, fa_to_json(q, 0))
}

fn act_fa_update(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    let cur = fa_find(db, id)?
    if orm_ok_q(cur) == 0 || orm_nrows(cur) < 1 || orm_cell_by_i64(cur, 0, "company_id") != ac.id {
        return act_404(ac.db, "Asset not found")
    }
    db = ac.db
    let cols = vec_new()
    let vals = vec_new()
    let fields: Vec<str> = vec_new()
    vec_push(fields, "name")
    vec_push(fields, "inventory_number")
    vec_push(fields, "acquisition_date")
    vec_push(fields, "put_into_service_date")
    vec_push(fields, "cost")
    vec_push(fields, "salvage_value")
    vec_push(fields, "useful_life_months")
    vec_push(fields, "depreciation_method")
    vec_push(fields, "accounting_depreciation_rate")
    vec_push(fields, "tax_depreciation_rate")
    vec_push(fields, "status")
    vec_push(fields, "serial_number")
    vec_push(fields, "manufacturer")
    vec_push(fields, "model")
    vec_push(fields, "responsible_person")
    let mut fi: i64 = 0
    while fi < vec_len(fields) {
        let f = jreq_str(b.doc, b.root, vec_get(fields, fi))
        if f.present == 1 {
            if f.ok == 0 {
                return act_422_field(db, vec_get(fields, fi), f)
            }
            vec_push(cols, vec_get(fields, fi))
            vec_push(vals, f.val)
        }
        fi = fi + 1
    }
    let cid = jreq_i64(b.doc, b.root, "category_id")
    if cid.present == 1 {
        if cid.ok == 0 {
            return act_422_field(db, "category_id", cid)
        }
        vec_push(cols, "category_id")
        vec_push(vals, int_to_str(cid.num))
    }
    let conv = jreq_bool(b.doc, b.root, "is_conserved")
    if conv.present == 1 {
        if conv.ok == 0 {
            return act_422_field(db, "is_conserved", conv)
        }
        vec_push(cols, "is_conserved")
        vec_push(vals, int_to_str(conv.num))
    }
    let locu = jreq_i64(b.doc, b.root, "location_id")
    if locu.present == 1 {
        if locu.ok == 0 {
            return act_422_field(db, "location_id", locu)
        }
        vec_push(cols, "location_id")
        vec_push(vals, int_to_str(locu.num))
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    if vec_len(cols) == 0 {
        let q0 = fa_find(db, id)?
        if orm_ok_q(q0) == 0 || orm_nrows(q0) < 1 {
            return act_404(orm_db_q(q0), "Asset not found")
        }
        return act_ok(orm_db_q(q0), fa_to_json(q0, 0))
    }
    let upd = orm_update_by_id(db, fa_table(), id, cols, vals)?
    if orm_ok(upd) == 0 {
        return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
    }
    let q = fa_find(orm_db_exec(upd), id)?
    if orm_ok_q(q) == 0 || orm_nrows(q) < 1 {
        return act_404(orm_db_q(q), "Asset not found")
    }
    return act_ok(orm_db_q(q), fa_to_json(q, 0))
}

fn act_fa_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    let cur = fa_find(db, id)?
    if orm_ok_q(cur) == 0 || orm_nrows(cur) < 1 || orm_cell_by_i64(cur, 0, "company_id") != ac.id {
        return act_404(ac.db, "Asset not found")
    }
    let del = fa_delete(ac.db, id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    return act_no_content(orm_db_exec(del))
}
