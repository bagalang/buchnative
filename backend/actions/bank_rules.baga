// ── Нормализатор: кирилица → латиница, малки букви, само a-z0-9 ─────────────

fn bn_cyr(cp: i64) -> str {
    if cp == 1072 || cp == 1040 { return "a" }
    if cp == 1073 || cp == 1041 { return "b" }
    if cp == 1074 || cp == 1042 { return "v" }
    if cp == 1075 || cp == 1043 { return "g" }
    if cp == 1076 || cp == 1044 { return "d" }
    if cp == 1077 || cp == 1045 { return "e" }
    if cp == 1105 || cp == 1025 { return "e" }
    if cp == 1078 || cp == 1046 { return "zh" }
    if cp == 1079 || cp == 1047 { return "z" }
    if cp == 1080 || cp == 1048 { return "i" }
    if cp == 1081 || cp == 1049 { return "y" }
    if cp == 1082 || cp == 1050 { return "k" }
    if cp == 1083 || cp == 1051 { return "l" }
    if cp == 1084 || cp == 1052 { return "m" }
    if cp == 1085 || cp == 1053 { return "n" }
    if cp == 1086 || cp == 1054 { return "o" }
    if cp == 1087 || cp == 1055 { return "p" }
    if cp == 1088 || cp == 1056 { return "r" }
    if cp == 1089 || cp == 1057 { return "s" }
    if cp == 1090 || cp == 1058 { return "t" }
    if cp == 1091 || cp == 1059 { return "u" }
    if cp == 1092 || cp == 1060 { return "f" }
    if cp == 1093 || cp == 1061 { return "h" }
    if cp == 1094 || cp == 1062 { return "ts" }
    if cp == 1095 || cp == 1063 { return "ch" }
    if cp == 1096 || cp == 1064 { return "sh" }
    if cp == 1097 || cp == 1065 { return "sht" }
    if cp == 1098 || cp == 1066 { return "a" }
    if cp == 1099 || cp == 1067 { return "y" }
    if cp == 1100 || cp == 1068 { return "" }
    if cp == 1101 || cp == 1069 { return "e" }
    if cp == 1102 || cp == 1070 { return "yu" }
    if cp == 1103 || cp == 1071 { return "ya" }
    return ""
}

fn bn_squash(s: str) -> str {
    let mut out = ""
    let mut sp: i64 = 0
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 32 {
            if sp == 0 {
                out = concat(out, " ")
                sp = 1
            }
        } else {
            sp = 0
            out = concat(out, chr(c))
        }
        i = i + 1
    }
    return str_trim(out)
}

fn bn_fold(s: str) -> str {
    let mut out = ""
    let n = len(s)
    let mut pos: i64 = 0
    while pos < n {
        let w = str_utf8_width(s, pos)
        if w == 1 {
            let c = byte_at(s, pos)
            if c >= 65 && c <= 90 {
                out = concat(out, byte_chr(c + 32))
            } else {
                if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
                    out = concat(out, byte_chr(c))
                } else {
                    out = concat(out, " ")
                }
            }
            pos = pos + 1
        } else {
            if w == 2 {
                let b0 = byte_at(s, pos)
                let b1 = byte_at(s, pos + 1)
                let cp = ((b0 - 192) * 64) + (b1 - 128)
                let tr = bn_cyr(cp)
                if tr == "" {
                    out = concat(out, " ")
                } else {
                    out = concat(out, tr)
                }
            } else {
                out = concat(out, " ")
            }
            pos = pos + w
        }
    }
    return bn_squash(out)
}

fn bn_contains(haystack: str, keyword: str) -> i64 {
    let needle = bn_fold(keyword)
    if needle == "" {
        return 0
    }
    if str_find(bn_fold(haystack), needle) >= 0 {
        return 1
    }
    return 0
}

// Ключ на контрагент за съвпадение: без правните форми (еоод, оод, ад…).
fn bn_company_key(s: str) -> str {
    let mut k = bn_fold(s)
    k = str_replace(k, " eood", "")
    k = str_replace(k, " ood", "")
    k = str_replace(k, " ad", "")
    k = str_replace(k, " et", "")
    k = str_replace(k, " kd", "")
    k = str_replace(k, " ltd", "")
    k = str_replace(k, " llc", "")
    return bn_squash(k)
}

// ── Стандартни шаблони (като baraba DEFAULT_TEMPLATES) ─────────────────────

struct BnTemplate {
    name: str,
    keywords: str,
    direction: str,
    codes: Vec<str>,
    priority: i64
}

fn bank_rule_templates() -> Vec<BnTemplate> {
    let t: Vec<BnTemplate> = vec_new()
    let mut n: Vec<str> = vec_new()
    vec_push(n, "447")
    vec_push(n, "446")
    vec_push(n, "50902")
    vec_push(t, BnTemplate { name: "POS покупки", keywords: "POS,ПОС,pos трансакция,покупка на пос,pos purchase,card purchase,покупка с карта,покупка с дк", direction: "debit", codes: n, priority: 100 })
    n = vec_new()
    vec_push(n, "501")
    vec_push(t, BnTemplate { name: "ATM теглене", keywords: "ATM,АТМ,atm трансакция,теглене,withdrawal,cash withdrawal,теглене на каса,теглене на пари", direction: "debit", codes: n, priority: 90 })
    n = vec_new()
    vec_push(n, "629")
    vec_push(t, BnTemplate { name: "Банкови такси", keywords: "автоматична такса,такса теглене,такса за поддръжка,комисионна,bank fee,commission,месечна такса,мес. такса,monthly fee", direction: "debit", codes: n, priority: 80 })
    n = vec_new()
    vec_push(n, "411")
    vec_push(t, BnTemplate { name: "Получени преводи от клиенти", keywords: "получен директен превод,получен превод,sct instant получен,incoming credit,credit transfer received", direction: "credit", codes: n, priority: 70 })
    n = vec_new()
    vec_push(n, "401")
    vec_push(t, BnTemplate { name: "Издадени преводи към доставчици", keywords: "издаден превод,sct instant издаден,изходящ превод,outgoing credit,issued transfer", direction: "debit", codes: n, priority: 60 })
    n = vec_new()
    vec_push(n, "402")
    vec_push(t, BnTemplate { name: "Аванси", keywords: "аванс,avans,advance", direction: "debit", codes: n, priority: 50 })
    return t
}

// ── Съвпадения ────────────────────────────────────────────────────────────

struct BankRuleHit {
    found: i64,
    rule_id: i64,
    name: str,
    account_id: i64,
    counterpart_id: i64
}

fn bank_rule_hit_none() -> BankRuleHit {
    return BankRuleHit { found: 0, rule_id: 0, name: "", account_id: 0, counterpart_id: 0 }
}

fn bn_rule_has_keyword(text: str, keywords: str) -> i64 {
    let parts = str_split(keywords, ",")
    let mut i: i64 = 0
    while i < vec_len(parts) {
        let k = str_trim(vec_get(parts, i))
        if bn_contains(text, k) == 1 {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn bank_rule_match(db: OrmDb, company_id: i64, text: str, amount: str) -> BankRuleHit !IO !Net {
    let rules = bank_rule_by_company(db, company_id)?
    if orm_ok_q(rules) == 0 || orm_nrows(rules) < 1 {
        return bank_rule_hit_none()
    }
    let ap = dec_parse(amount)
    let mut positive: i64 = 0
    if ap.ok == 1 && dec_is_negative(ap.value) == 0 {
        positive = 1
    }
    let mut i: i64 = 0
    // kv_sort реди текстови колони по низ; приоритетът е число, затова тук
    // избираме числово най-високото съвпадение (не първото от заявката).
    let mut best = bank_rule_hit_none()
    let mut best_pri: i64 = 0 - 1000000
    while i < orm_nrows(rules) {
        if orm_cell_by_i64(rules, i, "is_active") != 0 {
            let dir = orm_cell_by(rules, i, "direction")
            let mut dir_ok: i64 = 1
            if dir == "debit" && positive == 1 {
                dir_ok = 0
            }
            if dir == "credit" && positive == 0 {
                dir_ok = 0
            }
            if dir_ok == 1 {
                let kws = orm_cell_by(rules, i, "keywords")
                if bn_rule_has_keyword(text, kws) == 1 {
                    let pri = orm_cell_by_i64(rules, i, "priority")
                    if best.found == 0 || pri > best_pri {
                        best = BankRuleHit {
                            found: 1,
                            rule_id: orm_cell_by_i64(rules, i, "id"),
                            name: orm_cell_by(rules, i, "name"),
                            account_id: orm_cell_by_i64(rules, i, "account_id"),
                            counterpart_id: orm_cell_by_i64(rules, i, "counterpart_id")
                        }
                        best_pri = pri
                    }
                }
            }
        }
        i = i + 1
    }
    return best
}

// Контрагент по име (нормализирано, без правни форми).
fn bank_rule_counterpart(db: OrmDb, company_id: i64, name: str) -> i64 !IO !Net {
    let key = bn_company_key(name)
    if len(key) < 3 {
        return 0
    }
    let cq = counterpart_all_co(db, company_id)?
    if orm_ok_q(cq) == 0 {
        return 0
    }
    let mut i: i64 = 0
    while i < orm_nrows(cq) {
        let ck = bn_company_key(orm_cell_by(cq, i, "name"))
        if ck != "" {
            if ck == key {
                return orm_cell_by_i64(cq, i, "id")
            }
            if len(ck) >= 5 && len(key) >= 5 {
                if str_find(key, ck) >= 0 || str_find(ck, key) >= 0 {
                    return orm_cell_by_i64(cq, i, "id")
                }
            }
        }
        i = i + 1
    }
    return 0
}

// ── CRUD ──────────────────────────────────────────────────────────────────

// jopt_i64 като в material_issue.baga (jopt_* не са в jsonx).
fn bn_jopt_i64(doc: JsonDoc, obj: i64, key: str, def: i64) -> JField {
    if json_get(doc, obj, key) < 0 {
        return jfield_ok_i64(def, int_to_str(def))
    }
    return jreq_i64(doc, obj, key)
}

fn act_bank_rules_index(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    let q = bank_rule_by_company(ac.db, ac.id)?
    if orm_ok_q(q) == 0 {
        return act_err(orm_db_q(q), 500, orm_err_q(q))
    }
    return act_ok(orm_db_q(q), bank_rule_list_json(q))
}

fn act_bank_rules_save(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    let body = jbody_parse_str(fmr_body(ctx))
    if body.ok == 0 {
        return act_err(db, 400, body.err)
    }
    let b = jbody_require_object(body)
    if b.ok == 0 {
        return act_err(db, 400, b.err)
    }
    let name = jreq_str(b.doc, b.root, "name")
    if name.ok == 0 {
        return act_422_field(db, "name", name)
    }
    let keywords = jreq_str(b.doc, b.root, "keywords")
    if keywords.ok == 0 {
        return act_422_field(db, "keywords", keywords)
    }
    let direction = jopt_str(b.doc, b.root, "direction", "any")
    if direction.val != "any" && direction.val != "debit" && direction.val != "credit" {
        return act_err(db, 422, "direction трябва да е any/debit/credit")
    }
    let priority_f = bn_jopt_i64(b.doc, b.root, "priority", 0)
    if priority_f.ok == 0 {
        return act_422_field(db, "priority", priority_f)
    }
    let active_f = bn_jopt_i64(b.doc, b.root, "is_active", 1)
    if active_f.ok == 0 {
        return act_422_field(db, "is_active", active_f)
    }
    let account_f = bn_jopt_i64(b.doc, b.root, "account_id", 0)
    if account_f.ok == 0 {
        return act_422_field(db, "account_id", account_f)
    }
    let cp_f = bn_jopt_i64(b.doc, b.root, "counterpart_id", 0)
    if cp_f.ok == 0 {
        return act_422_field(db, "counterpart_id", cp_f)
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let mut d0 = ac.db
    if account_f.num > 0 {
        let aq = account_find(d0, account_f.num)?
        if orm_ok_q(aq) == 0 || orm_nrows(aq) < 1 {
            return act_404(orm_db_q(aq), "Account not found")
        }
        d0 = orm_db_q(aq)
    }
    if cp_f.num > 0 {
        let cq = counterpart_find(d0, cp_f.num)?
        if orm_ok_q(cq) == 0 || orm_nrows(cq) < 1 || orm_cell_by_i64(cq, 0, "company_id") != ac.id {
            return act_404(orm_db_q(cq), "Counterpart not found")
        }
        d0 = orm_db_q(cq)
    }
    if id > 0 {
        let cur = bank_rule_find(d0, id)?
        if orm_ok_q(cur) == 0 || orm_nrows(cur) < 1 || orm_cell_by_i64(cur, 0, "company_id") != ac.id {
            return act_404(orm_db_q(cur), "Rule not found")
        }
        d0 = orm_db_q(cur)
        let upd = bank_rule_update(d0, id, name.val, keywords.val, direction.val, priority_f.num, active_f.num, account_f.num, cp_f.num)?
        if orm_ok(upd) == 0 {
            return act_err(orm_db_exec(upd), 500, orm_err_exec(upd))
        }
        let q = bank_rule_find(orm_db_exec(upd), id)?
        return act_ok(orm_db_q(q), bank_rule_to_json(q, 0))
    }
    let ins = bank_rule_create(d0, ac.id, name.val, keywords.val, direction.val, priority_f.num, active_f.num, account_f.num, cp_f.num)?
    if orm_ok_q(ins) == 0 || orm_nrows(ins) < 1 {
        return act_err(orm_db_q(ins), 500, "rule insert failed")
    }
    return act_created(orm_db_q(ins), bank_rule_to_json(ins, 0))
}

fn act_bank_rules_delete(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    let id = fmr_param_i64(ctx, "id")
    if id <= 0 {
        return act_err(db, 400, "invalid id")
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    let cur = bank_rule_find(ac.db, id)?
    if orm_ok_q(cur) == 0 || orm_nrows(cur) < 1 || orm_cell_by_i64(cur, 0, "company_id") != ac.id {
        return act_404(orm_db_q(cur), "Rule not found")
    }
    let del = bank_rule_delete(orm_db_q(cur), id)?
    if orm_ok(del) == 0 {
        return act_err(orm_db_exec(del), 500, orm_err_exec(del))
    }
    return act_no_content(orm_db_exec(del))
}

// Създава стандартните правила за фирмата (пропуска вече съществуващите по име).
fn act_bank_rules_defaults(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let existing = bank_rule_by_company(ac.db, ac.id)?
    if orm_ok_q(existing) == 0 {
        return act_err(orm_db_q(existing), 500, orm_err_q(existing))
    }
    let mut names: Map<str, i64> = map_new()
    let mut i: i64 = 0
    while i < orm_nrows(existing) {
        map_set(names, orm_cell_by(existing, i, "name"), 1)
        i = i + 1
    }
    let templates = bank_rule_templates()
    let mut created: i64 = 0
    let mut d0 = orm_db_q(existing)
    i = 0
    while i < vec_len(templates) {
        let tpl = vec_get(templates, i)
        if map_has(names, tpl.name) == 0 {
            // Първата съществуваваща сметка по кода.
            let mut acc_id: i64 = 0
            let mut j: i64 = 0
            while j < vec_len(tpl.codes) {
                let aq = account_by_number(d0, vec_get(tpl.codes, j))?
                if orm_ok_q(aq) == 1 && orm_nrows(aq) > 0 {
                    acc_id = orm_cell_by_i64(aq, 0, "id")
                    d0 = orm_db_q(aq)
                    j = vec_len(tpl.codes)
                } else {
                    d0 = orm_db_q(aq)
                    j = j + 1
                }
            }
            if acc_id > 0 {
                let ins = bank_rule_create(d0, ac.id, tpl.name, tpl.keywords, tpl.direction, tpl.priority, 1, acc_id, 0)?
                if orm_ok_q(ins) == 0 || orm_nrows(ins) < 1 {
                    return act_err(orm_db_q(ins), 500, "rule insert failed")
                }
                d0 = orm_db_q(ins)
                created = created + 1
            }
        }
        i = i + 1
    }
    let q = bank_rule_by_company(d0, ac.id)?
    let mut o = bank_rule_list_json(q)
    o = jobj_i64(o, "created", created)
    return act_ok(orm_db_q(q), o)
}

// ── Автоматично разнасяне на всички чакащи транзакции ──────────────────────

fn bn_needs_processing(txs: OrmQuery, row: i64, bank_account: OrmQuery) -> i64 !IO !Net {
    let booked = orm_cell_by_i64(txs, row, "is_booked")
    let entry_id = orm_cell_by_i64(txs, row, "journal_entry_id")
    if booked == 0 {
        return 1
    }
    if entry_id <= 0 {
        return 0
    }
    let buffer_id = orm_cell_by_i64(bank_account, 0, "buffer_account_id")
    if buffer_id <= 0 {
        return 0
    }
    let lq = journal_lines_by_entry(orm_db_q(txs), entry_id)?
    if orm_ok_q(lq) == 0 {
        return 0
    }
    let mut i: i64 = 0
    while i < orm_nrows(lq) {
        if orm_cell_by_i64(lq, i, "account_id") == buffer_id {
            return 1
        }
        i = i + 1
    }
    return 0
}

fn act_bank_rules_auto(ctx: FmrCtx, db: OrmDb) -> FmrOut !IO !Net !Time {
    let auth = act_require_auth(ctx, db)
    if auth.ok == 0 {
        return auth.out
    }
    if orm_ok_db(db) == 0 {
        return act_err(db, 503, "database unavailable")
    }
    let ac = active_company_id(db, auth.ctx.user_sub)?
    if ac.id <= 0 {
        return act_err(ac.db, 422, "няма избрана активна фирма")
    }
    let txs = bank_tx_by_company(ac.db, ac.id)?
    if orm_ok_q(txs) == 0 {
        return act_err(orm_db_q(txs), 500, orm_err_q(txs))
    }
    let mut matched: i64 = 0
    let mut unmatched: i64 = 0
    let mut errors: i64 = 0
    let mut cp_hits: i64 = 0
    let mut details = jarr_new()
    let mut i: i64 = 0
    let mut d0 = orm_db_q(txs)
    while i < orm_nrows(txs) {
        let tx_id = orm_cell_by_i64(txs, i, "id")
        let ba_id = orm_cell_by_i64(txs, i, "bank_account_id")
        let baq = bank_account_find(d0, ba_id)?
        if orm_ok_q(baq) == 0 || orm_nrows(baq) < 1 {
            i = i + 1
        } else {
            d0 = orm_db_q(baq)
            if bn_needs_processing(txs, i, baq) == 1 {
                let text = concat(concat(concat(orm_cell_by(txs, i, "description"), " "), orm_cell_by(txs, i, "counterpart_name")), concat(" ", orm_cell_by(txs, i, "reference")))
                let amount = orm_cell_by(txs, i, "amount")
                let hit = bank_rule_match(d0, ac.id, text, amount)?
                if hit.found == 0 {
                    unmatched = unmatched + 1
                    if vec_len(details.items) < 50 {
                        details = jarr_obj(details, bn_detail(tx_id, "unmatched", "", bn_snippet(text)))
                    }
                } else {
                    let mut cp_id = hit.counterpart_id
                    if cp_id <= 0 {
                        cp_id = bank_rule_counterpart(d0, ac.id, orm_cell_by(txs, i, "counterpart_name"))?
                    }
                    if cp_id > 0 {
                        cp_hits = cp_hits + 1
                    }
                    let booked = orm_cell_by_i64(txs, i, "is_booked")
                    let mut r = bank_book_result_err("", 0, d0)
                    if booked == 0 {
                        r = bank_tx_book_one(d0, ac.id, tx_id, hit.account_id, cp_id)?
                    } else {
                        r = bank_tx_reallocate_one(d0, ac.id, tx_id, hit.account_id, cp_id)?
                    }
                    if r.ok == 1 {
                        matched = matched + 1
                        d0 = r.db
                        if vec_len(details.items) < 50 {
                            details = jarr_obj(details, bn_detail(tx_id, "matched", hit.name, ""))
                        }
                    } else {
                        errors = errors + 1
                        if vec_len(details.items) < 50 {
                            details = jarr_obj(details, bn_detail(tx_id, "error", "", r.err))
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "matched", matched)
    o = jobj_i64(o, "unmatched", unmatched)
    o = jobj_i64(o, "errors", errors)
    o = jobj_i64(o, "counterpart_hits", cp_hits)
    o = jobj_arr(o, "details", details)
    return act_ok(d0, o)
}

fn bn_snippet(s: str) -> str {
    return utf8_clip(s, 80)
}

fn bn_detail(id: i64, status: str, rule: str, text: str) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", id)
    o = jobj_str(o, "status", status)
    o = jobj_str(o, "rule", rule)
    o = jobj_str(o, "text", text)
    return o
}
