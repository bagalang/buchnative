PORT=8080
FMR_WORKERS=4
FMR_LOG=1
FMR_CORS=*
FMR_JWT_SECRET=dev-secret
FMR_TITLE=buchnative
FMR_VERSION=0.1.0

# База данни. По подразбиране rocksbaga (KV, RESP2) през drockb — това е
# backend-ът, за който е мигриран buchnative.
#
#   drock  — rocksbaga (DROCK_HOST:DROCK_PORT). Без user/password/database:
#            KV сървърът няма автентикация.
#   pg     — Postgres (PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE)
#   boila  — boilaDB през PostgreSQL v3 wire (serve_pg)
#
# Останалите две стойности са за останалите приложения в монорепото и са
# запазени — ormbaga поддържа и трите. За buchnative дръж drock.
ORM_BACKEND=drock
DROCK_HOST=127.0.0.1
DROCK_PORT=16579

# За ORM_BACKEND=pg / boila (не се ползват от buchnative):
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=bagatest
# PGPASSWORD=
# PGDATABASE=baga_orm
