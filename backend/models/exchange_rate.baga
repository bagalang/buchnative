// models/exchange_rate.baga — обменни курсове на ЕЦБ (за 1 EUR).
// Курсът е TEXT (десимална точност, без float). Уникалност (currency_code, date)
// я пази upsert-ът: преди импорта се зарежда цялата таблица и двойката се
// търси в нея. As-of е WHERE currency_code = ? ORDER BY date DESC, после
// date <= в приложението (kv_where_dir).

import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"

fn exchange_rate_table() -> str {
    return "exchange_rates"
}

fn exchange_rate_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM exchange_rates")?
}

fn exchange_rate_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "currency_code")
    vec_push(c, "rate")
    vec_push(c, "date")
    vec_push(c, "created_at")
    return c
}

fn exchange_rate_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "currency_code", orm_cell_by(q, row, "currency_code"))
    o = jobj_str(o, "rate", orm_cell_by(q, row, "rate"))
    o = jobj_str(o, "date", orm_cell_by(q, row, "date"))
    return o
}

fn exchange_rate_all(db: OrmDb) -> OrmQuery !IO !Net {
    let sc: Vec<str> = vec_new()
    vec_push(sc, "date")
    vec_push(sc, "currency_code")
    let dirs: Vec<i64> = vec_new()
    vec_push(dirs, 1)
    vec_push(dirs, 0)
    return kv_select_all_dir(db, exchange_rate_table(), exchange_rate_cols(), sc, dirs)?
}

fn exchange_rate_by_date(db: OrmDb, date: str) -> OrmQuery !IO !Net {
    return kv_where_order(db, exchange_rate_table(), "date", date, "currency_code", exchange_rate_cols())?
}

// Последната дата с курсове: максимум по колоната, без sort на цялото.
fn exchange_rate_latest_q(db: OrmDb) -> OrmQuery !IO !Net {
    let d = kv_max_value(db, exchange_rate_table(), "date")?
    let cols: Vec<str> = vec_new()
    vec_push(cols, "date")
    if d == "" {
        return kv_query_empty(db, cols)
    }
    let cells: Vec<str> = vec_new()
    vec_push(cells, d)
    let nulls: Vec<i64> = vec_new()
    vec_push(nulls, 0)
    return kv_query_ok(db, cols, cells, nulls, 1)
}

// Курсове за една валута, най-новите първи. date <= се прилага в asof_pick
// (две колони в WHERE още не са надеждни в BoilaSQL).
fn exchange_rate_by_currency(db: OrmDb, currency: str) -> OrmQuery !IO !Net {
    let sc: Vec<str> = vec_new()
    vec_push(sc, "date")
    let dirs: Vec<i64> = vec_new()
    vec_push(dirs, 1)
    return kv_where_dir(db, exchange_rate_table(), "currency_code", currency, exchange_rate_cols(), sc, dirs)?
}

// Лексикографско сравнение (низовите < > в baga гледат само първия байт).
// ISO датите са с равна дължина, затова байт-по-байт е точно.
fn er_str_cmp(a: str, b: str) -> i64 {
    let mut n = len(a)
    if len(b) < n {
        n = len(b)
    }
    let mut i: i64 = 0
    while i < n {
        let ca = char_at(a, i)
        let cb = char_at(b, i)
        if ca < cb {
            return 0 - 1
        }
        if ca > cb {
            return 1
        }
        i = i + 1
    }
    if len(a) < len(b) {
        return 0 - 1
    }
    if len(a) > len(b) {
        return 1
    }
    return 0
}

// Първи ред с date <= target (q е ORDER BY date DESC). -1 ако няма.
fn exchange_rate_asof_pick(q: OrmQuery, date: str) -> i64 {
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if er_str_cmp(orm_cell_by(q, i, "date"), date) <= 0 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// Ред на (currency, date) в резултат от заявка; -1 ако липсва.
fn exchange_rate_row_of_pair(q: OrmQuery, currency: str, date: str) -> i64 {
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by(q, i, "currency_code") == currency {
            if orm_cell_by(q, i, "date") == date {
                return i
            }
        }
        i = i + 1
    }
    return 0 - 1
}

fn exchange_rate_insert(db: OrmDb, currency: str, rate: str, date: str) -> OrmExec !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "currency_code")
    vec_push(cols, "rate")
    vec_push(cols, "date")
    let vals: Vec<str> = vec_new()
    vec_push(vals, currency)
    vec_push(vals, rate)
    vec_push(vals, date)
    return orm_insert_strs(db, exchange_rate_table(), cols, vals)?
}

// Ъпсърт по (currency, date) срещу предварително заредена заявка q
// (едно SELECT за целия импорт — 90-дневният фид е ~3000 реда).
// out: 1 insert, 0 update, 2 без промяна, -1 грешка. Връща обновената db.
fn exchange_rate_upsert(db: OrmDb, q: OrmQuery, currency: str, rate: str, date: str, out: Vec<i64>) -> OrmDb !IO !Net {
    let row = exchange_rate_row_of_pair(q, currency, date)
    if row >= 0 {
        if orm_cell_by(q, row, "rate") == rate {
            vec_push(out, 2)
            return db
        }
        let id = orm_cell_by_i64(q, row, "id")
        let cols = vec_new()
        vec_push(cols, "rate")
        let vals = vec_new()
        vec_push(vals, rate)
        let u = orm_update_by_id(db, exchange_rate_table(), id, cols, vals)?
        if orm_ok(u) == 0 {
            vec_push(out, 0 - 1)
        } else {
            vec_push(out, 0)
        }
        return orm_db_exec(u)
    }
    let ins = exchange_rate_insert(db, currency, rate, date)?
    if orm_ok(ins) == 0 {
        vec_push(out, 0 - 1)
    } else {
        vec_push(out, 1)
    }
    return orm_db_exec(ins)
}
