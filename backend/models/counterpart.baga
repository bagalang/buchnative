// models/counterpart.baga — counterparts (контрагенти) table helpers over ormbaga.
// Table DDL живее в schema.baga на buchnative. Типът (клиент/доставчик/двете) е
// изведен от is_client/is_supplier — съхранението остава като два флага.

import "ormbaga/orm.baga"
import "kvtime.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"

fn counterpart_table() -> str {
    return "counterparts"
}

// Следващ PK: таблицата е създадена преди P20 (без BIGSERIAL). NULL max → 0.
fn counterpart_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM counterparts")?
}

// Тип → флагове (customer/supplier/both → is_client/is_supplier).
fn counterpart_is_client(t: str) -> i64 {
    if t == "supplier" {
        return 0
    }
    return 1
}

fn counterpart_is_supplier(t: str) -> i64 {
    if t == "customer" {
        return 0
    }
    return 1
}

// Флагове → тип.
fn counterpart_type_of(ic: i64, is_: i64) -> str {
    if ic == 1 && is_ == 0 {
        return "customer"
    }
    if ic == 0 && is_ == 1 {
        return "supplier"
    }
    return "both"
}

fn counterpart_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "counterpart_type", counterpart_type_of(orm_cell_by_i64(q, row, "is_client"), orm_cell_by_i64(q, row, "is_supplier")))
    o = jobj_str(o, "eik", orm_cell_by(q, row, "eik"))
    o = jobj_str(o, "vat_number", orm_cell_by(q, row, "vat_number"))
    o = jobj_str(o, "address", orm_cell_by(q, row, "address"))
    o = jobj_str(o, "vies_address", orm_cell_by(q, row, "vies_address"))
    o = jobj_str(o, "city", orm_cell_by(q, row, "city"))
    o = jobj_str(o, "country", orm_cell_by(q, row, "country"))
    o = jobj_str(o, "post_code", orm_cell_by(q, row, "post_code"))
    o = jobj_str(o, "street_name", orm_cell_by(q, row, "street_name"))
    o = jobj_str(o, "building_number", orm_cell_by(q, row, "building_number"))
    o = jobj_str(o, "address_building", orm_cell_by(q, row, "address_building"))
    o = jobj_str(o, "additional_address_detail", orm_cell_by(q, row, "additional_address_detail"))
    o = jobj_str(o, "address_type", orm_cell_by(q, row, "address_type"))
    o = jobj_str(o, "region", orm_cell_by(q, row, "region"))
    o = jobj_str(o, "contact_person", orm_cell_by(q, row, "contact_person"))
    o = jobj_str(o, "email", orm_cell_by(q, row, "email"))
    o = jobj_str(o, "phone", orm_cell_by(q, row, "phone"))
    let mut cur = orm_cell_by(q, row, "currency")
    if cur == "" {
        cur = "EUR"
    }
    o = jobj_str(o, "currency", cur)
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

fn counterpart_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "name")
    vec_push(c, "is_client")
    vec_push(c, "is_supplier")
    vec_push(c, "eik")
    vec_push(c, "vat_number")
    vec_push(c, "address")
    vec_push(c, "vies_address")
    vec_push(c, "city")
    vec_push(c, "country")
    vec_push(c, "post_code")
    vec_push(c, "street_name")
    vec_push(c, "building_number")
    vec_push(c, "region")
    vec_push(c, "address_building")
    vec_push(c, "additional_address_detail")
    vec_push(c, "address_type")
    vec_push(c, "contact_person")
    vec_push(c, "email")
    vec_push(c, "phone")
    vec_push(c, "currency")
    vec_push(c, "company_id")
    vec_push(c, "created_at")
    return c
}

fn counterpart_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, counterpart_table(), id, counterpart_cols())?
}

fn counterpart_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, counterpart_table(), "id", counterpart_cols())?
}

fn counterpart_all_co(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, counterpart_table(), "company_id", int_to_str(company_id), "id", counterpart_cols())?
}

fn counterpart_by_vat(db: OrmDb, vat_number: str) -> OrmQuery !IO !Net {
    return kv_where_star(db, counterpart_table(), "vat_number", vat_number)?
}

fn counterpart_by_eik(db: OrmDb, eik: str) -> OrmQuery !IO !Net {
    return kv_where_star(db, counterpart_table(), "eik", eik)?
}

// Уникалността е в рамките на фирмата: един и същ доставчик е редовно
// контрагент на няколко фирми, затова глобална проверка би блокирала това.
fn counterpart_by_eik_co(db: OrmDb, company_id: i64, eik: str) -> OrmQuery !IO !Net {
    return kv_where2_star(db, counterpart_table(), "company_id", int_to_str(company_id), "eik", eik)?
}

fn counterpart_by_vat_co(db: OrmDb, company_id: i64, vat_number: str) -> OrmQuery !IO !Net {
    return kv_where2_star(db, counterpart_table(), "company_id", int_to_str(company_id), "vat_number", vat_number)?
}

// currency е валутата по подразбиране на разчетната сметка с контрагента
// (мултивалутни 4xx, default EUR); празно се чете като EUR.
fn counterpart_create(db: OrmDb, name: str, counterpart_type: str, eik: str, vat_number: str, address: str, vies_address: str, city: str, country: str, post_code: str, street_name: str, building_number: str, region: str, address_building: str, additional_address_detail: str, address_type: str, contact_person: str, email: str, phone: str, currency: str, company_id: i64) -> OrmExec !IO !Net !Time {
    let ic = counterpart_is_client(counterpart_type)
    let is_ = counterpart_is_supplier(counterpart_type)
    let cols: Vec<str> = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "is_client")
    vec_push(cols, "is_supplier")
    vec_push(cols, "eik")
    vec_push(cols, "vat_number")
    vec_push(cols, "address")
    vec_push(cols, "vies_address")
    vec_push(cols, "city")
    vec_push(cols, "country")
    vec_push(cols, "post_code")
    vec_push(cols, "street_name")
    vec_push(cols, "building_number")
    vec_push(cols, "region")
    vec_push(cols, "address_building")
    vec_push(cols, "additional_address_detail")
    vec_push(cols, "address_type")
    vec_push(cols, "contact_person")
    vec_push(cols, "email")
    vec_push(cols, "phone")
    vec_push(cols, "currency")
    vec_push(cols, "company_id")
    vec_push(cols, "created_at")
    let vals: Vec<str> = vec_new()
    vec_push(vals, name)
    vec_push(vals, int_to_str(ic))
    vec_push(vals, int_to_str(is_))
    vec_push(vals, eik)
    vec_push(vals, vat_number)
    vec_push(vals, address)
    vec_push(vals, vies_address)
    vec_push(vals, city)
    vec_push(vals, country)
    vec_push(vals, post_code)
    vec_push(vals, street_name)
    vec_push(vals, building_number)
    vec_push(vals, region)
    vec_push(vals, address_building)
    vec_push(vals, additional_address_detail)
    vec_push(vals, address_type)
    vec_push(vals, contact_person)
    vec_push(vals, email)
    vec_push(vals, phone)
    vec_push(vals, currency)
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, kv_now_iso()?)
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(cols) {
        vec_push(nulls, 0)
        i = i + 1
    }
    return kv_insert_exec(db, counterpart_table(), cols, vals, nulls)?
}

fn counterpart_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return kv_delete_by_id(db, counterpart_table(), id)?
}

fn counterpart_list_json_co(q: OrmQuery, cid: i64) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    let mut n: i64 = 0
    while i < orm_nrows(q) {
        let row_co = orm_cell_by_i64(q, i, "company_id")
        if cid <= 0 || row_co == 0 || row_co == cid {
            arr = jarr_obj(arr, counterpart_to_json(q, i))
            n = n + 1
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", n)
    return o
}

fn counterpart_list_json(q: OrmQuery) -> JObj {
    return counterpart_list_json_co(q, 0)
}

fn counterpart_list_json_all(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, counterpart_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
