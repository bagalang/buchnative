// models/fixed_asset.baga — ДМА върху KV (rocksbaga): категории (ЗКПО) + активи + събития.
// Table DDL живее в schema.baga на buchnative. Сумите са NUMERIC като стрингове.
//
// Сигнатурите са тези от SQL версията, затова actions/fixed_assets*.baga не се
// пипат: kv_select_* попълва същия OrmQuery, който orm_cell_by / orm_nrows /
// orm_db_q четат. created_at се щампова в модела — в KV няма DEFAULT NOW().

import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "kvtime.baga"
import "std/str/str.baga"

// ---------- категории ----------

fn fac_table() -> str {
    return "fixed_asset_categories"
}

// Следващ PK: id-то го раздава броячът на таблицата, тук само се чете.
fn fac_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM fixed_asset_categories")?
}

// Замества SELECT списъка — колоните и редът им са същите.
fn fac_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "name")
    vec_push(c, "cita_category")
    vec_push(c, "min_depreciation_rate")
    vec_push(c, "max_depreciation_rate")
    vec_push(c, "default_method")
    vec_push(c, "asset_account_id")
    vec_push(c, "depreciation_account_id")
    vec_push(c, "expense_account_id")
    return c
}

fn fac_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "cita_category", orm_cell_by(q, row, "cita_category"))
    o = jobj_str(o, "min_depreciation_rate", orm_cell_by(q, row, "min_depreciation_rate"))
    o = jobj_str(o, "max_depreciation_rate", orm_cell_by(q, row, "max_depreciation_rate"))
    o = jobj_str(o, "default_method", orm_cell_by(q, row, "default_method"))
    let aa = orm_cell_by_i64(q, row, "asset_account_id")
    if aa > 0 {
        o = jobj_i64(o, "asset_account_id", aa)
    }
    let da = orm_cell_by_i64(q, row, "depreciation_account_id")
    if da > 0 {
        o = jobj_i64(o, "depreciation_account_id", da)
    }
    let ea = orm_cell_by_i64(q, row, "expense_account_id")
    if ea > 0 {
        o = jobj_i64(o, "expense_account_id", ea)
    }
    return o
}

fn fac_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, fac_table(), id, fac_cols())?
}

fn fac_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, fac_table(), "id", fac_cols())?
}

// Сметковите колони са nullable в DDL-а, но SQL версията пишеше 0 (не NULL) и
// fac_to_json ги изпуска при 0 — същото остава тук.
fn fac_create(db: OrmDb, name: str, cita_category: str, min_rate: str, max_rate: str, default_method: str, asset_acc: i64, dep_acc: i64, exp_acc: i64) -> OrmQuery !IO !Net !Time {
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "cita_category")
    vec_push(cols, "min_depreciation_rate")
    vec_push(cols, "max_depreciation_rate")
    vec_push(cols, "default_method")
    vec_push(cols, "asset_account_id")
    vec_push(cols, "depreciation_account_id")
    vec_push(cols, "expense_account_id")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, cita_category)
    vec_push(vals, min_rate)
    vec_push(vals, max_rate)
    vec_push(vals, default_method)
    vec_push(vals, int_to_str(asset_acc))
    vec_push(vals, int_to_str(dep_acc))
    vec_push(vals, int_to_str(exp_acc))
    vec_push(vals, kv_now_iso()?)
    let nulls = vec_new()
    let mut i: i64 = 0
    while i < 9 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return orm_insert_returning_full(db, fac_table(), cols, vals, nulls)?
}

fn fac_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, fac_table(), id)?
}

fn fac_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, fac_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}

// ---------- активи ----------

fn fa_table() -> str {
    return "fixed_assets"
}

fn fa_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM fixed_assets")?
}

fn fa_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "name")
    vec_push(c, "inventory_number")
    vec_push(c, "category_id")
    vec_push(c, "acquisition_date")
    vec_push(c, "put_into_service_date")
    vec_push(c, "cost")
    vec_push(c, "salvage_value")
    vec_push(c, "useful_life_months")
    vec_push(c, "depreciation_method")
    vec_push(c, "accounting_depreciation_rate")
    vec_push(c, "tax_depreciation_rate")
    vec_push(c, "accumulated_depreciation")
    vec_push(c, "tax_accumulated_depreciation")
    vec_push(c, "status")
    vec_push(c, "serial_number")
    vec_push(c, "manufacturer")
    vec_push(c, "model")
    vec_push(c, "responsible_person")
    vec_push(c, "is_conserved")
    vec_push(c, "location_id")
    return c
}

fn fa_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "inventory_number", orm_cell_by(q, row, "inventory_number"))
    let cid = orm_cell_by_i64(q, row, "category_id")
    if cid > 0 {
        o = jobj_i64(o, "category_id", cid)
    }
    o = jobj_str(o, "acquisition_date", orm_cell_by(q, row, "acquisition_date"))
    o = jobj_str(o, "put_into_service_date", orm_cell_by(q, row, "put_into_service_date"))
    o = jobj_str(o, "cost", orm_cell_by(q, row, "cost"))
    o = jobj_str(o, "salvage_value", orm_cell_by(q, row, "salvage_value"))
    o = jobj_str(o, "useful_life_months", orm_cell_by(q, row, "useful_life_months"))
    o = jobj_str(o, "depreciation_method", orm_cell_by(q, row, "depreciation_method"))
    o = jobj_str(o, "accounting_depreciation_rate", orm_cell_by(q, row, "accounting_depreciation_rate"))
    o = jobj_str(o, "tax_depreciation_rate", orm_cell_by(q, row, "tax_depreciation_rate"))
    o = jobj_str(o, "accumulated_depreciation", orm_cell_by(q, row, "accumulated_depreciation"))
    o = jobj_str(o, "tax_accumulated_depreciation", orm_cell_by(q, row, "tax_accumulated_depreciation"))
    o = jobj_str(o, "status", orm_cell_by(q, row, "status"))
    o = jobj_str(o, "serial_number", orm_cell_by(q, row, "serial_number"))
    o = jobj_str(o, "manufacturer", orm_cell_by(q, row, "manufacturer"))
    o = jobj_str(o, "model", orm_cell_by(q, row, "model"))
    o = jobj_str(o, "responsible_person", orm_cell_by(q, row, "responsible_person"))
    o = jobj_i64(o, "is_conserved", orm_cell_by_i64(q, row, "is_conserved"))
    o = jobj_i64(o, "location_id", orm_cell_by_i64(q, row, "location_id"))
    return o
}

fn fa_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, fa_table(), id, fa_cols())?
}

fn fa_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, fa_table(), "id", fa_cols())?
}

// Натрупаните амортизации тръгват от 0: те идват от месечното осчетоводяване
// (fa_update_accumulated), не от екрана. location_id го слага action-ът.
fn fa_create(db: OrmDb, name: str, inventory_number: str, category_id: i64, acquisition_date: str, put_into_service_date: str, cost: str, salvage_value: str, useful_life_months: str, depreciation_method: str, accounting_depreciation_rate: str, tax_depreciation_rate: str, status: str, serial_number: str, manufacturer: str, model: str, responsible_person: str, is_conserved: i64) -> OrmQuery !IO !Net !Time {
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "inventory_number")
    vec_push(cols, "category_id")
    vec_push(cols, "acquisition_date")
    vec_push(cols, "put_into_service_date")
    vec_push(cols, "cost")
    vec_push(cols, "salvage_value")
    vec_push(cols, "useful_life_months")
    vec_push(cols, "depreciation_method")
    vec_push(cols, "accounting_depreciation_rate")
    vec_push(cols, "tax_depreciation_rate")
    vec_push(cols, "accumulated_depreciation")
    vec_push(cols, "tax_accumulated_depreciation")
    vec_push(cols, "status")
    vec_push(cols, "serial_number")
    vec_push(cols, "manufacturer")
    vec_push(cols, "model")
    vec_push(cols, "responsible_person")
    vec_push(cols, "is_conserved")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, inventory_number)
    vec_push(vals, int_to_str(category_id))
    vec_push(vals, acquisition_date)
    vec_push(vals, put_into_service_date)
    vec_push(vals, cost)
    vec_push(vals, salvage_value)
    vec_push(vals, useful_life_months)
    vec_push(vals, depreciation_method)
    vec_push(vals, accounting_depreciation_rate)
    vec_push(vals, tax_depreciation_rate)
    vec_push(vals, "0")
    vec_push(vals, "0")
    vec_push(vals, status)
    vec_push(vals, serial_number)
    vec_push(vals, manufacturer)
    vec_push(vals, model)
    vec_push(vals, responsible_person)
    vec_push(vals, int_to_str(is_conserved))
    vec_push(vals, kv_now_iso()?)
    let nulls = vec_new()
    let mut i: i64 = 0
    while i < 20 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return orm_insert_returning_full(db, fa_table(), cols, vals, nulls)?
}

fn fa_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, fa_table(), id)?
}

// Обновява натрупаните амортизации (след осчетоводяване на месеца).
fn fa_update_accumulated(db: OrmDb, id: i64, accumulated: str, tax_accumulated: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "accumulated_depreciation")
    vec_push(cols, "tax_accumulated_depreciation")
    let vals = vec_new()
    vec_push(vals, accumulated)
    vec_push(vals, tax_accumulated)
    return orm_update_by_id(db, fa_table(), id, cols, vals)?
}

fn fa_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, fa_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}

// ---------- събития (жизнен цикъл) ----------

fn fae_table() -> str {
    return "fixed_asset_events"
}

fn fae_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM fixed_asset_events")?
}

fn fae_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "asset_id")
    vec_push(c, "event_type")
    vec_push(c, "event_date")
    vec_push(c, "amount")
    vec_push(c, "prev_value")
    vec_push(c, "location")
    vec_push(c, "reason")
    return c
}

fn fae_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "asset_id", orm_cell_by_i64(q, row, "asset_id"))
    o = jobj_str(o, "event_type", orm_cell_by(q, row, "event_type"))
    o = jobj_str(o, "event_date", orm_cell_by(q, row, "event_date"))
    o = jobj_str(o, "amount", orm_cell_by(q, row, "amount"))
    o = jobj_str(o, "prev_value", orm_cell_by(q, row, "prev_value"))
    o = jobj_str(o, "location", orm_cell_by(q, row, "location"))
    o = jobj_str(o, "reason", orm_cell_by(q, row, "reason"))
    return o
}

// Хронологичен ред: събитията се редят по id (броячът ги раздава), затова
// WHERE asset_id + ORDER BY id е GET по индекса и после sort.
fn fae_by_asset(db: OrmDb, asset_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, fae_table(), "asset_id", int_to_str(asset_id), "id", fae_cols())?
}

fn fae_create(db: OrmDb, asset_id: i64, event_type: str, event_date: str, amount: str, prev_value: str, location: str, reason: str) -> OrmExec !IO !Net !Time {
    let cols = vec_new()
    vec_push(cols, "asset_id")
    vec_push(cols, "event_type")
    vec_push(cols, "event_date")
    vec_push(cols, "amount")
    vec_push(cols, "prev_value")
    vec_push(cols, "location")
    vec_push(cols, "reason")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, int_to_str(asset_id))
    vec_push(vals, event_type)
    vec_push(vals, event_date)
    vec_push(vals, amount)
    vec_push(vals, prev_value)
    vec_push(vals, location)
    vec_push(vals, reason)
    vec_push(vals, kv_now_iso()?)
    return orm_insert_strs(db, fae_table(), cols, vals)?
}

fn fae_list_json(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, fae_to_json(q, i))
        i = i + 1
    }
    return arr
}
