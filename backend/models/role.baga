// models/role.baga — роли и права (permissions е JSON текст).

import "ormbaga/orm.baga"
import "kvtime.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"

fn role_table() -> str {
    return "roles"
}

fn role_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM roles")?
}

fn role_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "name")
    vec_push(c, "description")
    vec_push(c, "permissions")
    vec_push(c, "created_at")
    return c
}

fn role_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    let perms = orm_cell_by(q, row, "permissions")
    if perms == "" {
        o = jobj_raw(o, "permissions", "[]")
    } else {
        o = jobj_raw(o, "permissions", perms)
    }
    return o
}

fn role_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, role_table(), id, role_cols())?
}

fn role_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, role_table(), "name", role_cols())?
}

fn role_create(db: OrmDb, name: str, description: str, permissions: str) -> OrmQuery !IO !Net !Time {
    let mut perms = permissions
    if perms == "" {
        perms = "[]"
    }
    let cols: Vec<str> = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "description")
    vec_push(cols, "permissions")
    vec_push(cols, "created_at")
    let vals: Vec<str> = vec_new()
    vec_push(vals, name)
    vec_push(vals, description)
    vec_push(vals, perms)
    vec_push(vals, kv_now_iso()?)
    let nulls: Vec<i64> = vec_new()
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    return kv_insert(db, role_table(), cols, vals, nulls)?
}

fn role_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return kv_delete_by_id(db, role_table(), id)?
}

fn role_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, role_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}
