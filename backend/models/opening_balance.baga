// models/opening_balance.baga — начални салда по сметка за фискална година.
// Видът на сметката е по НСС (първа цифра на номера), не по US GAAP.

import "ormbaga/orm.baga"
import "ormbaga/sql.baga"
import "fmrbaga/jsonx.baga"
import "pgbaga/pg.baga"
import "std/str/str.baga"
import "std/os/os.baga"

fn ob_table() -> str { return "opening_balances" }

fn ob_backend_boila() -> i64 !IO {
    let be = env("ORM_BACKEND")?
    if be == "boila" || be == "boiladb" || be == "boilaDB" {
        return 1
    }
    return 0
}

fn ob_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM opening_balances")?
}

// Нормална страна по българския сметкоплан (НСС класове 1–7).
fn ob_natural_side(number: str) -> str {
    if len(number) < 1 {
        return "any"
    }
    let d0 = substr(number, 0, 1)
    if d0 == "1" {
        return "credit"
    }
    if d0 == "2" {
        if len(number) >= 2 {
            if substr(number, 0, 2) == "24" {
                return "credit"
            }
        }
        return "debit"
    }
    if d0 == "3" {
        return "debit"
    }
    if d0 == "4" {
        if len(number) >= 4 {
            if substr(number, 0, 4) == "4531" {
                return "debit"
            }
            if substr(number, 0, 4) == "4532" {
                return "credit"
            }
        }
        if len(number) >= 2 {
            let d1 = substr(number, 0, 2)
            if d1 == "40" {
                return "credit"
            }
            if d1 == "41" {
                return "debit"
            }
        }
        return "any"
    }
    if d0 == "5" {
        return "debit"
    }
    if d0 == "6" {
        return "debit"
    }
    if d0 == "7" {
        return "credit"
    }
    return "any"
}

fn ob_account_kind(number: str) -> str {
    if len(number) < 1 {
        return "other"
    }
    let d0 = substr(number, 0, 1)
    if d0 == "1" { return "capital" }
    if d0 == "2" { return "fixed_asset" }
    if d0 == "3" { return "inventory" }
    if d0 == "4" {
        if len(number) >= 2 {
            let d1 = substr(number, 0, 2)
            if d1 == "40" { return "payable" }
            if d1 == "41" { return "receivable" }
        }
        return "settlement"
    }
    if d0 == "5" { return "cash" }
    if d0 == "6" { return "expense" }
    if d0 == "7" { return "revenue" }
    return "other"
}

fn ob_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "fiscal_year", orm_cell_by_i64(q, row, "fiscal_year"))
    o = jobj_i64(o, "account_id", orm_cell_by_i64(q, row, "account_id"))
    o = jobj_str(o, "debit", orm_cell_by(q, row, "debit"))
    o = jobj_str(o, "credit", orm_cell_by(q, row, "credit"))
    o = jobj_i64(o, "counterpart_id", orm_cell_by_i64(q, row, "counterpart_id"))
    o = jobj_i64(o, "product_id", orm_cell_by_i64(q, row, "product_id"))
    o = jobj_str(o, "quantity", orm_cell_by(q, row, "quantity"))
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    return o
}

fn ob_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "fiscal_year")
    vec_push(c, "account_id")
    vec_push(c, "debit")
    vec_push(c, "credit")
    vec_push(c, "counterpart_id")
    vec_push(c, "product_id")
    vec_push(c, "quantity")
    vec_push(c, "description")
    return c
}

fn ob_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, ob_table(), id, ob_cols())?
}

fn ob_by_year(db: OrmDb, year: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, ob_table(), "fiscal_year", int_to_str(year), "id", ob_cols())?
}

fn ob_insert(db: OrmDb, fiscal_year: i64, account_id: i64, debit: str, credit: str, counterpart_id: i64, product_id: i64, quantity: str, description: str) -> OrmExec !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "fiscal_year")
    vec_push(cols, "account_id")
    vec_push(cols, "debit")
    vec_push(cols, "credit")
    vec_push(cols, "counterpart_id")
    vec_push(cols, "product_id")
    vec_push(cols, "quantity")
    vec_push(cols, "description")
    let vals: Vec<str> = vec_new()
    vec_push(vals, int_to_str(fiscal_year))
    vec_push(vals, int_to_str(account_id))
    vec_push(vals, debit)
    vec_push(vals, credit)
    vec_push(vals, int_to_str(counterpart_id))
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, quantity)
    vec_push(vals, description)
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(cols) {
        vec_push(nulls, 0)
        i = i + 1
    }
    return kv_insert_exec(db, ob_table(), cols, vals, nulls)?
}

fn ob_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return kv_delete_by_id(db, ob_table(), id)?
}
