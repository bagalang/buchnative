// models/auth_tokens.baga — password-reset tokens + TOTP recovery hashes.
// KV (rocksbaga): двете таблици се четат по вторичен индекс (user_id,
// token_hash), id-то идва от брояча на таблицата. expires_at е BIGINT (epoch
// секунди), който action-ът подава изрично и сравнява сам — KV няма DEFAULT
// NOW() и няма WHERE <, затова филтърът за изтичане си остава в action-а.

import "ormbaga/orm.baga"
import "std/str/str.baga"

fn rec_table() -> str {
    return "user_recovery_codes"
}

fn prt_table() -> str {
    return "password_reset_tokens"
}

// Списъците колони на бившите SELECT-и — action-ите четат точно тези имена.
fn rec_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "user_id")
    vec_push(c, "code_hash")
    vec_push(c, "used")
    return c
}

fn prt_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "user_id")
    vec_push(c, "token_hash")
    vec_push(c, "expires_at")
    vec_push(c, "used")
    return c
}

// Следващ PK: броячът на таблицата го раздава при insert, тук само се чете.
fn rec_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM user_recovery_codes")?
}

fn prt_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM password_reset_tokens")?
}

// KV изтрива по PK, затова кодовете на потребителя минават през индекса.
fn rec_delete_user(db: OrmDb, user_id: i64) -> OrmExec !IO !Net {
    return kv_delete_where(db, rec_table(), "user_id", int_to_str(user_id))?
}

fn rec_insert(db: OrmDb, user_id: i64, code_hash: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "user_id")
    vec_push(cols, "code_hash")
    vec_push(cols, "used")
    let vals = vec_new()
    vec_push(vals, int_to_str(user_id))
    vec_push(vals, code_hash)
    vec_push(vals, "0")
    return orm_insert_strs(db, rec_table(), cols, vals)?
}

// Всички кодове на потребителя (used се филтрира от action-а, както преди).
fn rec_unused(db: OrmDb, user_id: i64) -> OrmQuery !IO !Net {
    return kv_select_where(db, rec_table(), "user_id", int_to_str(user_id), rec_cols())?
}

fn rec_mark_used(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "used")
    let vals = vec_new()
    vec_push(vals, "1")
    return orm_update_by_id(db, rec_table(), id, cols, vals)?
}

fn prt_insert(db: OrmDb, user_id: i64, token_hash: str, expires_at: i64) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "user_id")
    vec_push(cols, "token_hash")
    vec_push(cols, "expires_at")
    vec_push(cols, "used")
    let vals = vec_new()
    vec_push(vals, int_to_str(user_id))
    vec_push(vals, token_hash)
    vec_push(vals, int_to_str(expires_at))
    vec_push(vals, "0")
    return orm_insert_strs(db, prt_table(), cols, vals)?
}

// Токенът е SHA-256 hex (64 символа) — индексът по token_hash го вади с един GET.
fn prt_by_hash(db: OrmDb, token_hash: str) -> OrmQuery !IO !Net {
    return kv_select_where(db, prt_table(), "token_hash", token_hash, prt_cols())?
}

fn prt_mark_used(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "used")
    let vals = vec_new()
    vec_push(vals, "1")
    return orm_update_by_id(db, prt_table(), id, cols, vals)?
}
