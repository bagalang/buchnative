// models/journal.baga — journal_entries + journal_lines върху KV (rocksbaga).
//
// Сигнатурите съвпадат със SQL версията, затова actions/*.baga не се пипат:
// kv_select_* попълва същия OrmQuery, който същите accessor-и четат. KV няма
// JOIN, така че двете свързвания (редовете по запис и редовете за САФТ) се
// сглобяват в паметта с map по готов списък ключове.

import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "kvtime.baga"
import "std/str/str.baga"

fn journal_entry_table() -> str {
    return "journal_entries"
}

fn journal_line_table() -> str {
    return "journal_lines"
}

fn journal_entry_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "entry_date")
    vec_push(c, "document_type")
    vec_push(c, "document_id")
    vec_push(c, "description")
    vec_push(c, "vat_type")
    vec_push(c, "counterpart_id")
    vec_push(c, "counterpart_name")
    vec_push(c, "counterpart_vat_number")
    vec_push(c, "document_number")
    vec_push(c, "document_date")
    vec_push(c, "vat_period")
    vec_push(c, "total_amount")
    vec_push(c, "total_vat_amount")
    vec_push(c, "company_id")
    vec_push(c, "created_at")
    return c
}

fn journal_line_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "entry_id")
    vec_push(c, "account_id")
    vec_push(c, "direction")
    vec_push(c, "amount")
    vec_push(c, "vat_amount")
    vec_push(c, "currency")
    vec_push(c, "fx_quantity")
    vec_push(c, "fx_rate")
    vec_push(c, "counterpart_id")
    vec_push(c, "product_id")
    vec_push(c, "location_id")
    return c
}

fn journal_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM journal_entries")?
}

fn journal_line_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM journal_lines")?
}

fn journal_entry_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "entry_date", orm_cell_by(q, row, "entry_date"))
    o = jobj_str(o, "document_type", orm_cell_by(q, row, "document_type"))
    o = jobj_i64(o, "document_id", orm_cell_by_i64(q, row, "document_id"))
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    o = jobj_str(o, "vat_type", orm_cell_by(q, row, "vat_type"))
    let cpid = orm_cell_by_i64(q, row, "counterpart_id")
    if cpid > 0 {
        o = jobj_i64(o, "counterpart_id", cpid)
    }
    o = jobj_str(o, "counterpart_name", orm_cell_by(q, row, "counterpart_name"))
    o = jobj_str(o, "counterpart_vat_number", orm_cell_by(q, row, "counterpart_vat_number"))
    o = jobj_str(o, "document_number", orm_cell_by(q, row, "document_number"))
    o = jobj_str(o, "document_date", orm_cell_by(q, row, "document_date"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    o = jobj_str(o, "vat_period", orm_cell_by(q, row, "vat_period"))
    o = jobj_str(o, "total_vat_amount", orm_cell_by(q, row, "total_vat_amount"))
    o = jobj_str(o, "total_amount", orm_cell_by(q, row, "total_amount"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

fn journal_line_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "entry_id", orm_cell_by_i64(q, row, "entry_id"))
    o = jobj_i64(o, "account_id", orm_cell_by_i64(q, row, "account_id"))
    o = jobj_str(o, "direction", orm_cell_by(q, row, "direction"))
    o = jobj_str(o, "amount", orm_cell_by(q, row, "amount"))
    let va = orm_cell_by(q, row, "vat_amount")
    if va != "" {
        o = jobj_str(o, "vat_amount", va)
    }
    let cur = orm_cell_by(q, row, "currency")
    if cur != "" {
        o = jobj_str(o, "currency", cur)
        let fq = orm_cell_by(q, row, "fx_quantity")
        if fq != "" {
            o = jobj_str(o, "fx_quantity", fq)
        }
        let fr = orm_cell_by(q, row, "fx_rate")
        if fr != "" {
            o = jobj_str(o, "fx_rate", fr)
        }
    }
    let cp = orm_cell_by_i64(q, row, "counterpart_id")
    if cp > 0 {
        o = jobj_i64(o, "counterpart_id", cp)
    }
    let pr = orm_cell_by_i64(q, row, "product_id")
    if pr > 0 {
        o = jobj_i64(o, "product_id", pr)
    }
    o = jobj_i64(o, "location_id", orm_cell_by_i64(q, row, "location_id"))
    let mut an = orm_cell_by(q, row, "account_number")
    if an == "" {
        an = orm_cell_by(q, row, "number")
    }
    if an != "" {
        o = jobj_str(o, "account_number", an)
        let mut anm = orm_cell_by(q, row, "account_name")
        if anm == "" {
            anm = orm_cell_by(q, row, "name")
        }
        o = jobj_str(o, "account_name", anm)
    }
    return o
}

fn journal_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, journal_entry_table(), id, journal_entry_cols())?
}

fn journal_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, journal_entry_table(), "id", journal_entry_cols())?
}

fn journal_all_dated(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order2(db, journal_entry_table(), "entry_date", "id", journal_entry_cols())?
}

fn journal_lines_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, journal_line_table(), "id", journal_line_cols())?
}

// journal_lines + сметката на всеки ред (number, name) — заменя LEFT JOIN accounts.
fn journal_lines_by_entry(db: OrmDb, entry_id: i64) -> OrmQuery !IO !Net {
    let lq = kv_where_order(db, journal_line_table(), "entry_id", int_to_str(entry_id), "id", journal_line_cols())?
    if orm_ok_q(lq) == 0 {
        return lq
    }
    let acols: Vec<str> = vec_new()
    vec_push(acols, "id")
    vec_push(acols, "number")
    vec_push(acols, "name")
    let ac = kv_select_all(orm_db_q(lq), "accounts", acols)?
    if orm_ok_q(ac) == 0 {
        return lq
    }
    let keys = kv_col_values(lq, "account_id")
    let with_num = kv_attach(lq, journal_line_cols(), keys, kv_map_of(ac, "id", "number"), "number")
    let cols2 = kv_cols_plus(journal_line_cols(), "number")
    return kv_attach(with_num, cols2, keys, kv_map_of(ac, "id", "name"), "name")
}

// journal_lines + датата и фирмата от заглавния ред — заменя LEFT JOIN journal_entries.
fn journal_lines_for_saft(db: OrmDb) -> OrmQuery !IO !Net {
    let base: Vec<str> = vec_new()
    vec_push(base, "account_id")
    vec_push(base, "direction")
    vec_push(base, "amount")
    vec_push(base, "counterpart_id")
    vec_push(base, "entry_id")
    let lq = kv_select_all_order(db, journal_line_table(), "id", base)?
    if orm_ok_q(lq) == 0 {
        return lq
    }
    let ecols: Vec<str> = vec_new()
    vec_push(ecols, "id")
    vec_push(ecols, "entry_date")
    vec_push(ecols, "company_id")
    let eq = kv_select_all(orm_db_q(lq), journal_entry_table(), ecols)?
    if orm_ok_q(eq) == 0 {
        return lq
    }
    let show: Vec<str> = vec_new()
    vec_push(show, "account_id")
    vec_push(show, "direction")
    vec_push(show, "amount")
    vec_push(show, "counterpart_id")
    let keys = kv_col_values(lq, "entry_id")
    let with_date = kv_attach(lq, show, keys, kv_map_of(eq, "id", "entry_date"), "entry_date")
    let cols2 = kv_cols_plus(show, "entry_date")
    return kv_attach(with_date, cols2, keys, kv_map_of(eq, "id", "company_id"), "company_id")
}

// Вмъхва journal_entry и връща реда (id-то идва от брояча на таблицата).
fn journal_entry_insert(db: OrmDb, entry_date: str, document_type: str, document_id: i64, description: str, vat_type: str, counterpart_id: i64, counterpart_name: str, counterpart_vat_number: str, document_number: str, document_date: str, vat_period: str, total_amount: str, total_vat_amount: str, company_id: i64) -> OrmQuery !IO !Net !Time {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "entry_date")
    vec_push(cols, "document_type")
    vec_push(cols, "document_id")
    vec_push(cols, "description")
    vec_push(cols, "vat_type")
    vec_push(cols, "counterpart_id")
    vec_push(cols, "counterpart_name")
    vec_push(cols, "counterpart_vat_number")
    vec_push(cols, "document_number")
    vec_push(cols, "document_date")
    vec_push(cols, "vat_period")
    vec_push(cols, "total_amount")
    vec_push(cols, "total_vat_amount")
    vec_push(cols, "company_id")
    vec_push(cols, "created_at")
    let vals: Vec<str> = vec_new()
    vec_push(vals, entry_date)
    vec_push(vals, document_type)
    vec_push(vals, int_to_str(document_id))
    vec_push(vals, description)
    vec_push(vals, vat_type)
    vec_push(vals, int_to_str(counterpart_id))
    vec_push(vals, counterpart_name)
    vec_push(vals, counterpart_vat_number)
    vec_push(vals, document_number)
    vec_push(vals, document_date)
    vec_push(vals, vat_period)
    vec_push(vals, total_amount)
    vec_push(vals, total_vat_amount)
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, kv_now_iso()?)
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < 15 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return kv_insert(db, journal_entry_table(), cols, vals, nulls)?
}

// Вмъква journal_line; counterpart_id/product_id са с нищо (0 → без стойност).
// Без валутни данни: currency="" означава основната валута на фирмата.
fn journal_line_insert(db: OrmDb, entry_id: i64, account_id: i64, direction: str, amount: str, vat_amount: str, counterpart_id: i64, product_id: i64, location_id: i64) -> OrmExec !IO !Net {
    return journal_line_insert_fx(db, entry_id, account_id, direction, amount, vat_amount, "", "", "", counterpart_id, product_id, location_id)
}

// С валутни данни: currency (празно = основна валута), fx_quantity (сума във
// валутата), fx_rate (единици основна валута за 1 единица от currency).
// amount остава в основната валута: amount = fx_quantity × fx_rate (2 знака).
fn journal_line_insert_fx(db: OrmDb, entry_id: i64, account_id: i64, direction: str, amount: str, vat_amount: str, currency: str, fx_quantity: str, fx_rate: str, counterpart_id: i64, product_id: i64, location_id: i64) -> OrmExec !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "entry_id")
    vec_push(cols, "account_id")
    vec_push(cols, "direction")
    vec_push(cols, "amount")
    vec_push(cols, "vat_amount")
    vec_push(cols, "currency")
    vec_push(cols, "fx_quantity")
    vec_push(cols, "fx_rate")
    vec_push(cols, "counterpart_id")
    vec_push(cols, "product_id")
    vec_push(cols, "location_id")
    let vals: Vec<str> = vec_new()
    vec_push(vals, int_to_str(entry_id))
    vec_push(vals, int_to_str(account_id))
    vec_push(vals, direction)
    vec_push(vals, amount)
    vec_push(vals, vat_amount)
    vec_push(vals, currency)
    vec_push(vals, fx_quantity)
    vec_push(vals, fx_rate)
    vec_push(vals, int_to_str(counterpart_id))
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, int_to_str(location_id))
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < 11 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return kv_insert_exec(db, journal_line_table(), cols, vals, nulls)?
}

// Записи по ДДС период (за дневниците покупки/продажби); филтърът по
// ДДС_тип е в приложението — KVWhere гледа само една колона.
fn journal_by_period(db: OrmDb, period: str) -> OrmQuery !IO !Net {
    return kv_where_order2(db, journal_entry_table(), "vat_period", period, "entry_date", "id", journal_entry_cols())?
}

fn journal_row_in_company(q: OrmQuery, row: i64, cid: i64) -> i64 {
    if cid <= 0 {
        return 1
    }
    let row_co = orm_cell_by_i64(q, row, "company_id")
    if row_co == 0 || row_co == cid {
        return 1
    }
    return 0
}

fn journal_list_json_co(q: OrmQuery, cid: i64) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    let mut n: i64 = 0
    while i < orm_nrows(q) {
        if journal_row_in_company(q, i, cid) == 1 {
            arr = jarr_obj(arr, journal_entry_to_json(q, i))
            n = n + 1
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", n)
    return o
}

fn journal_list_json(q: OrmQuery) -> JObj {
    return journal_list_json_co(q, 0)
}

fn journal_lines_list_json(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, journal_line_to_json(q, i))
        i = i + 1
    }
    return arr
}

// Всички journal_lines с валутните полета + датата и фирмата от заглавния ред
// (за справката отворени валутни позиции и преоценката).
fn journal_lines_fx_all(db: OrmDb) -> OrmQuery !IO !Net {
    let base: Vec<str> = vec_new()
    vec_push(base, "id")
    vec_push(base, "entry_id")
    vec_push(base, "account_id")
    vec_push(base, "direction")
    vec_push(base, "amount")
    vec_push(base, "currency")
    vec_push(base, "fx_quantity")
    vec_push(base, "fx_rate")
    vec_push(base, "counterpart_id")
    let lq = kv_select_all_order(db, journal_line_table(), "id", base)?
    if orm_ok_q(lq) == 0 {
        return lq
    }
    let ecols: Vec<str> = vec_new()
    vec_push(ecols, "id")
    vec_push(ecols, "entry_date")
    vec_push(ecols, "company_id")
    let eq = kv_select_all(orm_db_q(lq), journal_entry_table(), ecols)?
    if orm_ok_q(eq) == 0 {
        return lq
    }
    let show: Vec<str> = vec_new()
    vec_push(show, "id")
    vec_push(show, "entry_id")
    vec_push(show, "account_id")
    vec_push(show, "direction")
    vec_push(show, "amount")
    vec_push(show, "currency")
    vec_push(show, "fx_quantity")
    vec_push(show, "fx_rate")
    vec_push(show, "counterpart_id")
    let keys = kv_col_values(lq, "entry_id")
    let with_date = kv_attach(lq, show, keys, kv_map_of(eq, "id", "entry_date"), "entry_date")
    let cols2 = kv_cols_plus(show, "entry_date")
    return kv_attach(with_date, cols2, keys, kv_map_of(eq, "id", "company_id"), "company_id")
}

// KV изтрива по PK, затова редовете на записа минават през индекса на entry_id.
fn journal_lines_delete_by_entry(db: OrmDb, entry_id: i64) -> OrmExec !IO !Net {
    return kv_delete_where(db, journal_line_table(), "entry_id", int_to_str(entry_id))?
}

// journal_delete: пълно изтриване на запис — редове + заглавен ред.
// Ползва се при връщане на фактура към чернова и при нейното изтриване.
// Без сторно: счетоводството иска чисти обороти (виж conventions.md).
fn journal_delete_entry(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    let dl = journal_lines_delete_by_entry(db, id)?
    if orm_ok(dl) == 0 {
        return dl
    }
    return kv_delete_by_id(orm_db_exec(dl), journal_entry_table(), id)?
}

fn journal_entry_update(db: OrmDb, id: i64, entry_date: str, description: str, vat_type: str, counterpart_id: i64, counterpart_name: str, counterpart_vat_number: str, document_number: str, document_date: str, vat_period: str, total_amount: str, total_vat_amount: str) -> OrmExec !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "entry_date")
    vec_push(cols, "description")
    vec_push(cols, "vat_type")
    vec_push(cols, "counterpart_id")
    vec_push(cols, "counterpart_name")
    vec_push(cols, "counterpart_vat_number")
    vec_push(cols, "document_number")
    vec_push(cols, "document_date")
    vec_push(cols, "vat_period")
    vec_push(cols, "total_amount")
    vec_push(cols, "total_vat_amount")
    let vals: Vec<str> = vec_new()
    vec_push(vals, entry_date)
    vec_push(vals, description)
    vec_push(vals, vat_type)
    vec_push(vals, int_to_str(counterpart_id))
    vec_push(vals, counterpart_name)
    vec_push(vals, counterpart_vat_number)
    vec_push(vals, document_number)
    vec_push(vals, document_date)
    vec_push(vals, vat_period)
    vec_push(vals, total_amount)
    vec_push(vals, total_vat_amount)
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < 11 {
        vec_push(nulls, 0)
        i = i + 1
    }
    return kv_update_by_id(db, journal_entry_table(), id, cols, vals, nulls)?
}
