// models/inventory.baga — партиди (FIFO/LIFO) за складови артикули върху KV (rocksbaga).
//
// Сигнатурите са тези от SQL версията, затова actions/inventory*.baga не се пипат.
// KV WHERE гледа една колона (GET по вторичния индекс), значи партидата се вади
// по product_id / invoice_id / invoice_line_id с един GET; филтърът по остатък
// (quantity_remaining > 0) остава в приложението, както и преди.
// Партидата няма created_at — датата е received_date, затова тук няма щампи.

import "ormbaga/orm.baga"
import "std/str/str.baga"

fn lot_table() -> str {
    return "inventory_lots"
}

// Следващ PK: id-то го раздава броячът на таблицата, тук само се чете.
fn lot_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM inventory_lots")?
}

// Замества SELECT списъка — колоните и редът им са същите.
fn lot_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "product_id")
    vec_push(c, "invoice_id")
    vec_push(c, "invoice_line_id")
    vec_push(c, "received_date")
    vec_push(c, "quantity")
    vec_push(c, "quantity_remaining")
    vec_push(c, "unit_cost")
    vec_push(c, "location_id")
    return c
}

// FIFO: партидите на стоката се редят по id — при един и същ received_date
// редът на вмъкване е честната последователност.
fn lot_by_product(db: OrmDb, product_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, lot_table(), "product_id", int_to_str(product_id), "id", lot_cols())?
}

fn lot_insert(db: OrmDb, product_id: i64, invoice_id: i64, invoice_line_id: i64, received_date: str, quantity: str, quantity_remaining: str, unit_cost: str, location_id: i64) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "product_id")
    vec_push(cols, "invoice_id")
    vec_push(cols, "invoice_line_id")
    vec_push(cols, "received_date")
    vec_push(cols, "quantity")
    vec_push(cols, "quantity_remaining")
    vec_push(cols, "unit_cost")
    vec_push(cols, "location_id")
    let vals = vec_new()
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, int_to_str(invoice_id))
    vec_push(vals, int_to_str(invoice_line_id))
    vec_push(vals, received_date)
    vec_push(vals, quantity)
    vec_push(vals, quantity_remaining)
    vec_push(vals, unit_cost)
    vec_push(vals, int_to_str(location_id))
    return orm_insert_strs(db, lot_table(), cols, vals)?
}

// Цялата таблица, сортирана по product_id после id (двете възходящо).
fn lot_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order2(db, lot_table(), "product_id", "id", lot_cols())?
}

fn lot_set_remaining(db: OrmDb, id: i64, remaining: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "quantity_remaining")
    let vals = vec_new()
    vec_push(vals, remaining)
    return orm_update_by_id(db, lot_table(), id, cols, vals)?
}

fn lot_by_invoice(db: OrmDb, invoice_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, lot_table(), "invoice_id", int_to_str(invoice_id), "id", lot_cols())?
}

fn lot_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, lot_table(), id)?
}

// lot_by_invoice_line: партидата, създадена от конкретен ред на входяща
// фактура. Използва се при връщане към чернова, за да се махне точно
// тази партида — ако не е изписвана междувременно.
fn lot_by_invoice_line(db: OrmDb, invoice_line_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, lot_table(), "invoice_line_id", int_to_str(invoice_line_id), "id", lot_cols())?
}

