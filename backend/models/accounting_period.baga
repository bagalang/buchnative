// models/accounting_period.baga — счетоводни месеци (open/closed) по фирма.
// Липсващ ред = отворен период (като в su-doxis). Затварянето е индивидуално
// за всяка фирма — една фирма не затваря месеца на друга.

import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"

fn aper_table() -> str { return "accounting_periods" }

fn aper_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM accounting_periods")?
}

fn aper_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    o = jobj_i64(o, "year", orm_cell_by_i64(q, row, "year"))
    o = jobj_i64(o, "month", orm_cell_by_i64(q, row, "month"))
    o = jobj_str(o, "status", orm_cell_by(q, row, "status"))
    o = jobj_str(o, "closed_at", orm_cell_by(q, row, "closed_at"))
    o = jobj_str(o, "notes", orm_cell_by(q, row, "notes"))
    return o
}

fn aper_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "company_id")
    vec_push(c, "year")
    vec_push(c, "month")
    vec_push(c, "status")
    vec_push(c, "closed_at")
    vec_push(c, "notes")
    return c
}

fn aper_by_company_year(db: OrmDb, company_id: i64, year: i64) -> OrmQuery !IO !Net {
    let sc: Vec<str> = vec_new()
    vec_push(sc, "month")
    let dirs: Vec<i64> = vec_new()
    vec_push(dirs, 0)
    return kv_where2_dir(db, aper_table(), "company_id", int_to_str(company_id), "year", int_to_str(year), aper_cols(), sc, dirs)?
}

fn aper_insert(db: OrmDb, company_id: i64, year: i64, month: i64, status: str, closed_at: str, notes: str) -> OrmExec !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "year")
    vec_push(cols, "month")
    vec_push(cols, "status")
    vec_push(cols, "closed_at")
    vec_push(cols, "notes")
    let vals: Vec<str> = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, int_to_str(year))
    vec_push(vals, int_to_str(month))
    vec_push(vals, status)
    vec_push(vals, closed_at)
    vec_push(vals, notes)
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(cols) {
        vec_push(nulls, 0)
        i = i + 1
    }
    return kv_insert_exec(db, aper_table(), cols, vals, nulls)?
}

fn aper_list_json(q: OrmQuery, company_id: i64, year: i64) -> JObj {
    let mut arr = jarr_new()
    let mut m: i64 = 1
    while m <= 12 {
        let mut status = "open"
        let mut closed_at = ""
        let mut notes = ""
        let mut id: i64 = 0
        let mut i: i64 = 0
        while i < orm_nrows(q) {
            if orm_cell_by_i64(q, i, "month") == m {
                let st = orm_cell_by(q, i, "status")
                if st != "" {
                    status = st
                }
                closed_at = orm_cell_by(q, i, "closed_at")
                notes = orm_cell_by(q, i, "notes")
                id = orm_cell_by_i64(q, i, "id")
            }
            i = i + 1
        }
        let mut o = jobj_new()
        if id > 0 {
            o = jobj_i64(o, "id", id)
        }
        o = jobj_i64(o, "company_id", company_id)
        o = jobj_i64(o, "year", year)
        o = jobj_i64(o, "month", m)
        o = jobj_str(o, "status", status)
        o = jobj_str(o, "closed_at", closed_at)
        o = jobj_str(o, "notes", notes)
        arr = jarr_obj(arr, o)
        m = m + 1
    }
    let mut out = jobj_new()
    out = jobj_raw(out, "items", jarr_encode(arr))
    out = jobj_i64(out, "year", year)
    return out
}
