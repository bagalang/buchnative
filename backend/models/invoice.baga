// models/invoice.baga — invoices + invoice_lines върху KV (rocksbaga).
//
// Сигнатурите са тези от SQL версията, затова actions/*.baga не се пипат.
// KV няма SUM и няма JOIN: тоталите на header-а се събират с bagadecimal,
// а името на контрагента се дописва от map (както го правеше LEFT JOIN).
// NUMERIC се подава/чете като стринг (точност, без float).

import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "kvtime.baga"
import "bagadecimal/src/decimal.baga"
import "std/str/str.baga"
import "setting.baga"

fn invoice_table() -> str {
    return "invoices"
}

fn invoice_line_table() -> str {
    return "invoice_lines"
}

fn invoice_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "direction")
    vec_push(c, "number")
    vec_push(c, "document_type")
    vec_push(c, "original_invoice_id")
    vec_push(c, "issue_date")
    vec_push(c, "due_date")
    vec_push(c, "tax_event_date")
    vec_push(c, "accounting_month")
    vec_push(c, "counterpart_id")
    vec_push(c, "currency")
    vec_push(c, "currency_rate")
    vec_push(c, "net_amount")
    vec_push(c, "vat_amount")
    vec_push(c, "total_amount")
    vec_push(c, "status")
    vec_push(c, "payment_method")
    vec_push(c, "notes")
    vec_push(c, "discount_percent")
    vec_push(c, "discount_amount")
    vec_push(c, "vat_exemption_reason")
    vec_push(c, "journal_entry_id")
    vec_push(c, "location_id")
    vec_push(c, "company_id")
    vec_push(c, "vat_article")
    vec_push(c, "customs_statistical")
    vec_push(c, "customs_duty")
    vec_push(c, "customs_vat")
    vec_push(c, "created_at")
    return c
}

fn invoice_line_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "invoice_id")
    vec_push(c, "product_id")
    vec_push(c, "description")
    vec_push(c, "quantity")
    vec_push(c, "unit")
    vec_push(c, "unit_price")
    vec_push(c, "net_amount")
    vec_push(c, "vat_rate")
    vec_push(c, "vat_amount")
    vec_push(c, "total_amount")
    return c
}

fn invoice_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM invoices")?
}

fn invoice_line_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM invoice_lines")?
}

fn invoice_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "direction", orm_cell_by(q, row, "direction"))
    o = jobj_str(o, "number", orm_cell_by(q, row, "number"))
    o = jobj_str(o, "document_type", orm_cell_by(q, row, "document_type"))
    o = jobj_str(o, "issue_date", orm_cell_by(q, row, "issue_date"))
    o = jobj_str(o, "due_date", orm_cell_by(q, row, "due_date"))
    o = jobj_str(o, "tax_event_date", orm_cell_by(q, row, "tax_event_date"))
    o = jobj_str(o, "accounting_month", orm_cell_by(q, row, "accounting_month"))
    o = jobj_i64(o, "counterpart_id", orm_cell_by_i64(q, row, "counterpart_id"))
    o = jobj_str(o, "currency", orm_cell_by(q, row, "currency"))
    o = jobj_str(o, "currency_rate", orm_cell_by(q, row, "currency_rate"))
    o = jobj_str(o, "net_amount", orm_cell_by(q, row, "net_amount"))
    o = jobj_str(o, "vat_amount", orm_cell_by(q, row, "vat_amount"))
    o = jobj_str(o, "total_amount", orm_cell_by(q, row, "total_amount"))
    o = jobj_str(o, "status", orm_cell_by(q, row, "status"))
    o = jobj_str(o, "payment_method", orm_cell_by(q, row, "payment_method"))
    o = jobj_str(o, "notes", orm_cell_by(q, row, "notes"))
    o = jobj_str(o, "discount_percent", orm_cell_by(q, row, "discount_percent"))
    o = jobj_str(o, "discount_amount", orm_cell_by(q, row, "discount_amount"))
    o = jobj_str(o, "vat_exemption_reason", orm_cell_by(q, row, "vat_exemption_reason"))
    o = jobj_i64(o, "location_id", orm_cell_by_i64(q, row, "location_id"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    let oid = orm_cell_by_i64(q, row, "original_invoice_id")
    if oid > 0 {
        o = jobj_i64(o, "original_invoice_id", oid)
    }
    let jid = orm_cell_by_i64(q, row, "journal_entry_id")
    if jid > 0 {
        o = jobj_i64(o, "journal_entry_id", jid)
    }
    let mut cname = orm_cell_by(q, row, "counterpart_name")
    if cname == "" {
        cname = orm_cell_by(q, row, "name")
    }
    if cname != "" {
        o = jobj_str(o, "counterpart_name", cname)
    }
    let va = orm_cell_by(q, row, "vat_article")
    if va != "" {
        o = jobj_str(o, "vat_article", va)
    }
    let cs = orm_cell_by(q, row, "customs_statistical")
    if cs != "" && cs != "0" && cs != "0.00" {
        o = jobj_str(o, "customs_statistical", cs)
    }
    let cd = orm_cell_by(q, row, "customs_duty")
    if cd != "" && cd != "0" && cd != "0.00" {
        o = jobj_str(o, "customs_duty", cd)
    }
    let cv = orm_cell_by(q, row, "customs_vat")
    if cv != "" && cv != "0" && cv != "0.00" {
        o = jobj_str(o, "customs_vat", cv)
    }
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

fn invoice_line_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "invoice_id", orm_cell_by_i64(q, row, "invoice_id"))
    let pid = orm_cell_by_i64(q, row, "product_id")
    if pid > 0 {
        o = jobj_i64(o, "product_id", pid)
    }
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    o = jobj_str(o, "quantity", orm_cell_by(q, row, "quantity"))
    o = jobj_str(o, "unit", orm_cell_by(q, row, "unit"))
    o = jobj_str(o, "unit_price", orm_cell_by(q, row, "unit_price"))
    o = jobj_str(o, "net_amount", orm_cell_by(q, row, "net_amount"))
    o = jobj_str(o, "vat_rate", orm_cell_by(q, row, "vat_rate"))
    o = jobj_str(o, "vat_amount", orm_cell_by(q, row, "vat_amount"))
    o = jobj_str(o, "total_amount", orm_cell_by(q, row, "total_amount"))
    return o
}

fn invoice_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, invoice_table(), id, invoice_cols())?
}

// Името на контрагента в същия ред (без N+1): map id→name от counterparts.
fn invoice_all(db: OrmDb) -> OrmQuery !IO !Net {
    let q = kv_select_all_order(db, invoice_table(), "number", invoice_cols())?
    if orm_ok_q(q) == 0 {
        return q
    }
    let ccols: Vec<str> = vec_new()
    vec_push(ccols, "id")
    vec_push(ccols, "name")
    let cp = kv_select_all(orm_db_q(q), "counterparts", ccols)?
    if orm_ok_q(cp) == 0 {
        return q
    }
    return kv_attach(q, invoice_cols(), kv_col_values(q, "counterpart_id"), kv_map_of(cp, "id", "name"), "name")
}

fn invoice_by_period(db: OrmDb, accounting_month: str) -> OrmQuery !IO !Net {
    return kv_where_order2(db, invoice_table(), "accounting_month", accounting_month, "issue_date", "id", invoice_cols())?
}

fn invoice_lines_by_invoice(db: OrmDb, invoice_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, invoice_line_table(), "invoice_id", int_to_str(invoice_id), "id", invoice_line_cols())?
}

// Вмъква header с тотали 0 и статус draft; реда се връща с готовото id.
fn invoice_create_header(db: OrmDb, direction: str, number: str, document_type: str, original_invoice_id: i64, issue_date: str, due_date: str, tax_event_date: str, accounting_month: str, counterpart_id: i64, currency: str, currency_rate: str, payment_method: str, notes: str, discount_percent: str, discount_amount: str, vat_exemption_reason: str, sub: str) -> OrmQuery !IO !Net !Time {
    let mut company_id: i64 = 0
    let sq = setting_get_by_key(db, concat("активна_фирма:", sub))?
    if orm_ok_q(sq) == 0 {
        return OrmQErr(OrmQueryFail { err: orm_err_q(sq), tag: "", db: orm_db_q(sq) })
    }
    let d0 = orm_db_q(sq)
    if orm_nrows(sq) > 0 {
        company_id = parse_int(orm_cell_by(sq, 0, "value"))
    }
    let cols: Vec<str> = vec_new()
    vec_push(cols, "direction")
    vec_push(cols, "number")
    vec_push(cols, "document_type")
    vec_push(cols, "original_invoice_id")
    vec_push(cols, "issue_date")
    vec_push(cols, "due_date")
    vec_push(cols, "tax_event_date")
    vec_push(cols, "accounting_month")
    vec_push(cols, "counterpart_id")
    vec_push(cols, "currency")
    vec_push(cols, "currency_rate")
    vec_push(cols, "net_amount")
    vec_push(cols, "vat_amount")
    vec_push(cols, "total_amount")
    vec_push(cols, "status")
    vec_push(cols, "payment_method")
    vec_push(cols, "notes")
    vec_push(cols, "discount_percent")
    vec_push(cols, "discount_amount")
    vec_push(cols, "vat_exemption_reason")
    vec_push(cols, "company_id")
    vec_push(cols, "created_at")
    let vals: Vec<str> = vec_new()
    vec_push(vals, direction)
    vec_push(vals, number)
    vec_push(vals, document_type)
    vec_push(vals, int_to_str(original_invoice_id))
    vec_push(vals, issue_date)
    vec_push(vals, due_date)
    vec_push(vals, tax_event_date)
    vec_push(vals, accounting_month)
    vec_push(vals, int_to_str(counterpart_id))
    vec_push(vals, currency)
    vec_push(vals, currency_rate)
    vec_push(vals, "0")
    vec_push(vals, "0")
    vec_push(vals, "0")
    vec_push(vals, "draft")
    vec_push(vals, payment_method)
    vec_push(vals, notes)
    vec_push(vals, discount_percent)
    vec_push(vals, discount_amount)
    vec_push(vals, vat_exemption_reason)
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, kv_now_iso()?)
    return orm_insert_returning_strs(d0, invoice_table(), cols, vals)?
}

// Вмъква ред; product_id е nullable (product_null==1 → NULL).
fn invoice_line_insert(db: OrmDb, invoice_id: i64, product_id: i64, product_null: i64, description: str, quantity: str, unit: str, unit_price: str, net_amount: str, vat_rate: str, vat_amount: str, total_amount: str) -> OrmExec !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "invoice_id")
    vec_push(cols, "product_id")
    vec_push(cols, "description")
    vec_push(cols, "quantity")
    vec_push(cols, "unit")
    vec_push(cols, "unit_price")
    vec_push(cols, "net_amount")
    vec_push(cols, "vat_rate")
    vec_push(cols, "vat_amount")
    vec_push(cols, "total_amount")
    let vals: Vec<str> = vec_new()
    vec_push(vals, int_to_str(invoice_id))
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, description)
    vec_push(vals, quantity)
    vec_push(vals, unit)
    vec_push(vals, unit_price)
    vec_push(vals, net_amount)
    vec_push(vals, vat_rate)
    vec_push(vals, vat_amount)
    vec_push(vals, total_amount)
    let nulls: Vec<i64> = vec_new()
    vec_push(nulls, 0)
    vec_push(nulls, product_null)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    return orm_insert_full(db, invoice_line_table(), cols, vals, nulls)?
}

// dec_add с нулев fall-back: лош стринг не променя натрупаното.
fn invoice_dadd(acc: Decimal, s: str) -> Decimal {
    let p = dec_parse(s)
    if p.ok == 1 {
        let r = dec_add(acc, p.value)
        if r.ok == 1 {
            return r.value
        }
    }
    return acc
}

// Сума като NUMERIC(18,2): закръглено до 2 знака, винаги с десетичен разделител.
fn invoice_dsum(d: Decimal) -> str {
    let r = dec_round_dp(d, 2)
    let mut v = d
    if r.ok == 1 {
        v = r.value
    }
    let s = dec_to_string(v)
    let dot = str_find(s, ".")
    if dot < 0 {
        return concat(s, ".00")
    }
    let frac = len(s) - dot - 1
    if frac == 1 {
        return concat(s, "0")
    }
    return s
}

// KV няма SUM: тоталите на header-а се събират от редове с bagadecimal
// (NUMERIC(18,2) → 2 знака), после се записват с UPDATE по id.
fn invoice_recalc_totals(db: OrmDb, invoice_id: i64) -> OrmExec !IO !Net {
    let lq = kv_select_where(db, invoice_line_table(), "invoice_id", int_to_str(invoice_id), invoice_line_cols())?
    if orm_ok_q(lq) == 0 {
        return OrmEErr(OrmExecFail { err: orm_err_q(lq), tag: "", db: orm_db_q(lq) })
    }
    let d = orm_db_q(lq)
    let mut n = dec_zero()
    let mut v = dec_zero()
    let mut t = dec_zero()
    let mut i: i64 = 0
    while i < orm_nrows(lq) {
        n = invoice_dadd(n, orm_cell_by(lq, i, "net_amount"))
        v = invoice_dadd(v, orm_cell_by(lq, i, "vat_amount"))
        t = invoice_dadd(t, orm_cell_by(lq, i, "total_amount"))
        i = i + 1
    }
    let cols: Vec<str> = vec_new()
    vec_push(cols, "net_amount")
    vec_push(cols, "vat_amount")
    vec_push(cols, "total_amount")
    let vals: Vec<str> = vec_new()
    if orm_nrows(lq) == 0 {
        vec_push(vals, "0")
        vec_push(vals, "0")
        vec_push(vals, "0")
    } else {
        vec_push(vals, invoice_dsum(n))
        vec_push(vals, invoice_dsum(v))
        vec_push(vals, invoice_dsum(t))
    }
    let nulls: Vec<i64> = vec_new()
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    return kv_update_by_id(d, invoice_table(), invoice_id, cols, vals, nulls)?
}

// KV изтрива по PK, затова редовете минават през индекса на invoice_id.
fn invoice_delete_lines(db: OrmDb, invoice_id: i64) -> OrmExec !IO !Net {
    return kv_delete_where(db, invoice_line_table(), "invoice_id", int_to_str(invoice_id))?
}

fn invoice_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return kv_delete_by_id(db, invoice_table(), id)?
}

fn invoice_row_in_company(q: OrmQuery, row: i64, cid: i64) -> i64 {
    if cid <= 0 {
        return 1
    }
    let row_co = orm_cell_by_i64(q, row, "company_id")
    if row_co == 0 || row_co == cid {
        return 1
    }
    return 0
}

fn invoice_list_json_co(q: OrmQuery, cid: i64) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    let mut n: i64 = 0
    while i < orm_nrows(q) {
        if invoice_row_in_company(q, i, cid) == 1 {
            arr = jarr_obj(arr, invoice_to_json(q, i))
            n = n + 1
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", n)
    return o
}

fn invoice_list_json(q: OrmQuery) -> JObj {
    return invoice_list_json_co(q, 0)
}

fn invoice_lines_list_json(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, invoice_line_to_json(q, i))
        i = i + 1
    }
    return arr
}

fn invoice_pad10(n: i64) -> str {
    let s = int_to_str(n)
    if len(s) >= 10 {
        return s
    }
    let mut zeros = ""
    let mut i = 10 - len(s)
    while i > 0 {
        zeros = concat(zeros, "0")
        i = i - 1
    }
    return concat(zeros, s)
}

fn invoice_numbers_by_type(db: OrmDb) -> OrmQuery !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "number")
    vec_push(cols, "document_type")
    vec_push(cols, "direction")
    return kv_select_all(db, invoice_table(), cols)?
}

fn invoice_next_number_str(q: OrmQuery, document_type: str, direction: str) -> str {
    let mut maxn: i64 = 0
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by(q, i, "document_type") == document_type {
            if orm_cell_by(q, i, "direction") == direction {
                let n = parse_int(orm_cell_by(q, i, "number"))
                if n > maxn {
                    maxn = n
                }
            }
        }
        i = i + 1
    }
    return invoice_pad10(maxn + 1)
}

// Специални полета на документа: протокол по чл. 117 (vat_article) и
// митническа декларация (статистическа стойност, мито, митническо ДДС).
fn invoice_set_special(db: OrmDb, id: i64, vat_article: str, customs_statistical: str, customs_duty: str, customs_vat: str) -> OrmExec !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "vat_article")
    vec_push(cols, "customs_statistical")
    vec_push(cols, "customs_duty")
    vec_push(cols, "customs_vat")
    let vals: Vec<str> = vec_new()
    vec_push(vals, vat_article)
    vec_push(vals, customs_statistical)
    vec_push(vals, customs_duty)
    vec_push(vals, customs_vat)
    return orm_update_by_id(db, invoice_table(), id, cols, vals)?
}
