// models/product.baga — products (стоки/услуги) table helpers over ormbaga.
// Table DDL живее в schema.baga на buchnative. price/vat_rate/cost са NUMERIC —
// подават се като стрингове за точност (без float загуби).

import "ormbaga/orm.baga"
import "kvtime.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"

fn product_table() -> str {
    return "products"
}

// Следващ PK: таблицата е създадена преди P20 (без BIGSERIAL). NULL max → 0.
fn product_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM products")?
}

fn product_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "code", orm_cell_by(q, row, "code"))
    o = jobj_str(o, "description", orm_cell_by(q, row, "description"))
    o = jobj_str(o, "unit", orm_cell_by(q, row, "unit"))
    o = jobj_str(o, "price", orm_cell_by(q, row, "price"))
    o = jobj_str(o, "cost_price", orm_cell_by(q, row, "cost_price"))
    o = jobj_str(o, "vat_rate", orm_cell_by(q, row, "vat_rate"))
    o = jobj_i64(o, "is_service", orm_cell_by_i64(q, row, "is_service"))
    o = jobj_i64(o, "is_inventory", orm_cell_by_i64(q, row, "is_inventory"))
    o = jobj_i64(o, "inventory_account_id", orm_cell_by_i64(q, row, "inventory_account_id"))
    o = jobj_i64(o, "revenue_account_id", orm_cell_by_i64(q, row, "revenue_account_id"))
    o = jobj_str(o, "stock_quantity", orm_cell_by(q, row, "stock_quantity"))
    o = jobj_str(o, "stock_value", orm_cell_by(q, row, "stock_value"))
    let mut act = orm_cell_by_i64(q, row, "is_active")
    if orm_cell_by(q, row, "is_active") == "" {
        act = 1
    }
    o = jobj_i64(o, "is_active", act)
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    o = jobj_str(o, "cn8_code", orm_cell_by(q, row, "cn8_code"))
    o = jobj_str(o, "cn8_name", orm_cell_by(q, row, "cn8_name"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

// Dual-safe: без ::text кастове (граматиката на boila за кастове е по-тясна).
fn product_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "name")
    vec_push(c, "code")
    vec_push(c, "description")
    vec_push(c, "unit")
    vec_push(c, "price")
    vec_push(c, "cost_price")
    vec_push(c, "vat_rate")
    vec_push(c, "is_service")
    vec_push(c, "is_inventory")
    vec_push(c, "inventory_account_id")
    vec_push(c, "revenue_account_id")
    vec_push(c, "stock_quantity")
    vec_push(c, "stock_value")
    vec_push(c, "is_active")
    vec_push(c, "company_id")
    vec_push(c, "cn8_code")
    vec_push(c, "cn8_name")
    vec_push(c, "created_at")
    return c
}

fn product_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, product_table(), id, product_cols())?
}

fn product_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, product_table(), "id", product_cols())?
}

fn product_ins_cols() -> Vec<str> {
    let cols = vec_new()
    vec_push(cols, "name")
    vec_push(cols, "code")
    vec_push(cols, "description")
    vec_push(cols, "unit")
    vec_push(cols, "price")
    vec_push(cols, "cost_price")
    vec_push(cols, "vat_rate")
    vec_push(cols, "is_service")
    vec_push(cols, "is_inventory")
    vec_push(cols, "inventory_account_id")
    vec_push(cols, "revenue_account_id")
    vec_push(cols, "stock_quantity")
    vec_push(cols, "stock_value")
    vec_push(cols, "is_active")
    vec_push(cols, "company_id")
    vec_push(cols, "cn8_code")
    vec_push(cols, "cn8_name")
    return cols
}

fn product_vals(name: str, code: str, description: str, unit: str, price: str, cost_price: str, vat_rate: str, is_service: i64, is_inventory: i64, inventory_account_id: i64, revenue_account_id: i64, stock_quantity: str, stock_value: str, is_active: i64, company_id: i64, cn8_code: str, cn8_name: str) -> Vec<str> {
    let vals = vec_new()
    vec_push(vals, name)
    vec_push(vals, code)
    vec_push(vals, description)
    vec_push(vals, unit)
    vec_push(vals, price)
    vec_push(vals, cost_price)
    vec_push(vals, vat_rate)
    vec_push(vals, int_to_str(is_service))
    vec_push(vals, int_to_str(is_inventory))
    vec_push(vals, int_to_str(inventory_account_id))
    vec_push(vals, int_to_str(revenue_account_id))
    vec_push(vals, stock_quantity)
    vec_push(vals, stock_value)
    vec_push(vals, int_to_str(is_active))
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, cn8_code)
    vec_push(vals, cn8_name)
    return vals
}

fn product_create(db: OrmDb, name: str, code: str, description: str, unit: str, price: str, cost_price: str, vat_rate: str, is_service: i64, is_inventory: i64, inventory_account_id: i64, revenue_account_id: i64, stock_quantity: str, stock_value: str, is_active: i64, company_id: i64, cn8_code: str, cn8_name: str) -> OrmExec !IO !Net !Time {
    let cols = product_ins_cols()
    vec_push(cols, "created_at")
    let vals = product_vals(name, code, description, unit, price, cost_price, vat_rate, is_service, is_inventory, inventory_account_id, revenue_account_id, stock_quantity, stock_value, is_active, company_id, cn8_code, cn8_name)
    vec_push(vals, kv_now_iso()?)
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(cols) {
        vec_push(nulls, 0)
        i = i + 1
    }
    return kv_insert_exec(db, product_table(), cols, vals, nulls)?
}

fn product_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return kv_delete_by_id(db, product_table(), id)?
}

fn product_set_stock(db: OrmDb, id: i64, qty: str, value: str, cost_price: str) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "stock_quantity")
    vec_push(cols, "stock_value")
    vec_push(cols, "cost_price")
    let vals = vec_new()
    vec_push(vals, qty)
    vec_push(vals, value)
    vec_push(vals, cost_price)
    return kv_update_strs(db, product_table(), id, cols, vals)?
}

fn product_list_json_co(q: OrmQuery, cid: i64) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    let mut n: i64 = 0
    while i < orm_nrows(q) {
        let row_co = orm_cell_by_i64(q, i, "company_id")
        if cid <= 0 || row_co == 0 || row_co == cid {
            arr = jarr_obj(arr, product_to_json(q, i))
            n = n + 1
        }
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", n)
    return o
}

fn product_list_json(q: OrmQuery) -> JObj {
    return product_list_json_co(q, 0)
}
