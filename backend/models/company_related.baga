// models/company_related.baga — SAF-T свързани таблици на фирмата:
// обекти/поделения, действителни собственици, крайни предприятия-майки.
// KV (rocksbaga): WHERE по company_id е GET по вторичния индекс, ORDER BY id е
// kv_where_order. is_active се филтрира след GET-а — KVWhere гледа само една
// колона (същото ограничение имаше и в SQL: без две „=“ в WHERE).

import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "kvtime.baga"
import "std/str/str.baga"

fn cloc_table() -> str { return "company_locations" }
fn bown_table() -> str { return "beneficial_owners" }
fn upar_table() -> str { return "ultimate_parents" }

// Общите достъпи за трите таблици: таблица + списък колони (в реда на бившия
// SELECT), за да не се повтаря код за всяка.
fn rel_by_company(db: OrmDb, table: str, cols: Vec<str>, company_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, table, "company_id", int_to_str(company_id), "id", cols)?
}

fn rel_find(db: OrmDb, table: str, cols: Vec<str>, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, table, id, cols)?
}

// id-то го раздава броячът на таблицата при insert, не ръчно MAX(id)+1.
fn rel_insert(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>) -> OrmExec !IO !Net {
    return orm_insert_strs(db, table, cols, vals)?
}

fn rel_soft_delete(db: OrmDb, table: str, id: i64) -> OrmExec !IO !Net {
    let cols = vec_new()
    vec_push(cols, "is_active")
    let vals = vec_new()
    vec_push(vals, "0")
    return orm_update_by_id(db, table, id, cols, vals)?
}

fn cloc_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "company_id")
    vec_push(c, "name")
    vec_push(c, "location_type")
    vec_push(c, "street_name")
    vec_push(c, "building_number")
    vec_push(c, "city")
    vec_push(c, "post_code")
    vec_push(c, "region")
    vec_push(c, "country")
    vec_push(c, "is_main")
    vec_push(c, "is_active")
    vec_push(c, "created_at")
    return c
}

fn bown_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "company_id")
    vec_push(c, "first_name_bg")
    vec_push(c, "last_name_bg")
    vec_push(c, "egn")
    vec_push(c, "first_name_latin")
    vec_push(c, "last_name_latin")
    vec_push(c, "country")
    vec_push(c, "ownership_percentage")
    vec_push(c, "is_active")
    vec_push(c, "created_at")
    return c
}

fn upar_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "company_id")
    vec_push(c, "name_bg")
    vec_push(c, "uic")
    vec_push(c, "name_latin")
    vec_push(c, "country")
    vec_push(c, "is_active")
    vec_push(c, "created_at")
    return c
}

fn cloc_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "location_type", orm_cell_by(q, row, "location_type"))
    o = jobj_str(o, "street_name", orm_cell_by(q, row, "street_name"))
    o = jobj_str(o, "building_number", orm_cell_by(q, row, "building_number"))
    o = jobj_str(o, "city", orm_cell_by(q, row, "city"))
    o = jobj_str(o, "post_code", orm_cell_by(q, row, "post_code"))
    o = jobj_str(o, "region", orm_cell_by(q, row, "region"))
    o = jobj_str(o, "country", orm_cell_by(q, row, "country"))
    o = jobj_i64(o, "is_main", orm_cell_by_i64(q, row, "is_main"))
    o = jobj_i64(o, "is_active", orm_cell_by_i64(q, row, "is_active"))
    return o
}

fn bown_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    o = jobj_str(o, "first_name_bg", orm_cell_by(q, row, "first_name_bg"))
    o = jobj_str(o, "last_name_bg", orm_cell_by(q, row, "last_name_bg"))
    o = jobj_str(o, "egn", orm_cell_by(q, row, "egn"))
    o = jobj_str(o, "first_name_latin", orm_cell_by(q, row, "first_name_latin"))
    o = jobj_str(o, "last_name_latin", orm_cell_by(q, row, "last_name_latin"))
    o = jobj_str(o, "country", orm_cell_by(q, row, "country"))
    o = jobj_str(o, "ownership_percentage", orm_cell_by(q, row, "ownership_percentage"))
    o = jobj_i64(o, "is_active", orm_cell_by_i64(q, row, "is_active"))
    return o
}

fn upar_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    o = jobj_str(o, "name_bg", orm_cell_by(q, row, "name_bg"))
    o = jobj_str(o, "uic", orm_cell_by(q, row, "uic"))
    o = jobj_str(o, "name_latin", orm_cell_by(q, row, "name_latin"))
    o = jobj_str(o, "country", orm_cell_by(q, row, "country"))
    o = jobj_i64(o, "is_active", orm_cell_by_i64(q, row, "is_active"))
    return o
}

fn rel_filter_active(q: OrmQuery, kind: str) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by_i64(q, i, "is_active") != 0 {
            if kind == "cloc" {
                arr = jarr_obj(arr, cloc_to_json(q, i))
            }
            if kind == "bown" {
                arr = jarr_obj(arr, bown_to_json(q, i))
            }
            if kind == "upar" {
                arr = jarr_obj(arr, upar_to_json(q, i))
            }
        }
        i = i + 1
    }
    return arr
}

fn cloc_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    return rel_by_company(db, cloc_table(), cloc_cols(), company_id)?
}

fn bown_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    return rel_by_company(db, bown_table(), bown_cols(), company_id)?
}

fn upar_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    return rel_by_company(db, upar_table(), upar_cols(), company_id)?
}

fn cloc_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return rel_find(db, cloc_table(), cloc_cols(), id)?
}

fn bown_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return rel_find(db, bown_table(), bown_cols(), id)?
}

fn upar_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return rel_find(db, upar_table(), upar_cols(), id)?
}

fn cloc_type_ok(t: str) -> i64 {
    if t == "OFFICE" || t == "STORE" || t == "WAREHOUSE" || t == "BRANCH" || t == "OTHER" {
        return 1
    }
    return 0
}

// created_at беше DEFAULT NOW() в DDL-а; KV няма default, затова се щампова
// тук — оттам и !Time в сигнатурите на трите create.
fn cloc_create(db: OrmDb, company_id: i64, name: str, location_type: str, street_name: str, building_number: str, city: str, post_code: str, region: str, country: str, is_main: i64) -> OrmExec !IO !Net !Time {
    let cols = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "name")
    vec_push(cols, "location_type")
    vec_push(cols, "street_name")
    vec_push(cols, "building_number")
    vec_push(cols, "city")
    vec_push(cols, "post_code")
    vec_push(cols, "region")
    vec_push(cols, "country")
    vec_push(cols, "is_main")
    vec_push(cols, "is_active")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, name)
    vec_push(vals, location_type)
    vec_push(vals, street_name)
    vec_push(vals, building_number)
    vec_push(vals, city)
    vec_push(vals, post_code)
    vec_push(vals, region)
    vec_push(vals, country)
    vec_push(vals, int_to_str(is_main))
    vec_push(vals, "1")
    vec_push(vals, kv_now_iso()?)
    return rel_insert(db, cloc_table(), cols, vals)?
}

fn bown_create(db: OrmDb, company_id: i64, first_name_bg: str, last_name_bg: str, egn: str, first_name_latin: str, last_name_latin: str, country: str, ownership_percentage: str) -> OrmExec !IO !Net !Time {
    let cols = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "first_name_bg")
    vec_push(cols, "last_name_bg")
    vec_push(cols, "egn")
    vec_push(cols, "first_name_latin")
    vec_push(cols, "last_name_latin")
    vec_push(cols, "country")
    vec_push(cols, "ownership_percentage")
    vec_push(cols, "is_active")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, first_name_bg)
    vec_push(vals, last_name_bg)
    vec_push(vals, egn)
    vec_push(vals, first_name_latin)
    vec_push(vals, last_name_latin)
    vec_push(vals, country)
    vec_push(vals, ownership_percentage)
    vec_push(vals, "1")
    vec_push(vals, kv_now_iso()?)
    return rel_insert(db, bown_table(), cols, vals)?
}

fn upar_create(db: OrmDb, company_id: i64, name_bg: str, uic: str, name_latin: str, country: str) -> OrmExec !IO !Net !Time {
    let cols = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "name_bg")
    vec_push(cols, "uic")
    vec_push(cols, "name_latin")
    vec_push(cols, "country")
    vec_push(cols, "is_active")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, name_bg)
    vec_push(vals, uic)
    vec_push(vals, name_latin)
    vec_push(vals, country)
    vec_push(vals, "1")
    vec_push(vals, kv_now_iso()?)
    return rel_insert(db, upar_table(), cols, vals)?
}

fn cloc_soft_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return rel_soft_delete(db, cloc_table(), id)?
}

fn bown_soft_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
