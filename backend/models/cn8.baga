// Само ASCII буквите се принижават — кирилицата в каталога е вече със
// малки, а латиницата (laptop, usb, hdmi) трябва да е без значение от регистъра.
fn cn8_lower(s: str) -> str {
    let mut out = ""
    let mut i: i64 = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c >= 65 && c <= 90 {
            out = concat(out, chr(c + 32))
        } else {
            out = concat(out, substr(s, i, i + 1))
        }
        i = i + 1
    }
    return out
}

fn cn8_name_of(code: str) -> str {
    let cat = cn8_catalog()
    let mut i: i64 = 0
    while i < vec_len(cat) {
        let line = vec_get(cat, i)
        let bar = str_find(line, "|")
        if substr(line, 0, bar) == code {
            return substr(line, bar + 1, len(line))
        }
        i = i + 1
    }
    return ""
}

fn cn8_vec_has(v: Vec<str>, x: str) -> i64 {
    let mut i: i64 = 0
    while i < vec_len(v) {
        if vec_get(v, i) == x {
            return 1
        }
        i = i + 1
    }
    return 0
}

// Търсене по търговска дума, код или описание. Връща редове "код|описание".
fn cn8_search(q: str) -> Vec<str> {
    let needle = cn8_lower(str_trim(q))
    let mut out: Vec<str> = vec_new()
    if needle == "" {
        return out
    }
    let syn = cn8_synonyms()
    let mut i: i64 = 0
    while i < vec_len(syn) {
        let line = vec_get(syn, i)
        let bar = str_find(line, "|")
        let word = substr(line, 0, bar)
        let code = substr(line, bar + 1, len(line))
        if str_find(cn8_lower(word), needle) >= 0 {
            let hit = concat(code, concat("|", cn8_name_of(code)))
            if cn8_vec_has(out, hit) == 0 {
                vec_push(out, hit)
            }
        }
        i = i + 1
    }
    let cat = cn8_catalog()
    i = 0
    while i < vec_len(cat) {
        let line = vec_get(cat, i)
        let bar = str_find(line, "|")
        let code = substr(line, 0, bar)
        let name = substr(line, bar + 1, len(line))
        if str_find(code, needle) >= 0 || str_find(cn8_lower(name), needle) >= 0 {
            if cn8_vec_has(out, line) == 0 {
                vec_push(out, line)
            }
        }
        i = i + 1
    }
    if vec_len(out) > 30 {
        let mut t: Vec<str> = vec_new()
        i = 0
        while i < 30 {
            vec_push(t, vec_get(out, i))
            i = i + 1
        }
        return t
    }
    return out
}

