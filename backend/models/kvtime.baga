// models/kvtime.baga — времеви щампи за KV backend-а.
//
// SQL версията разчиташе на DEFAULT NOW() в DDL-а. В KV няма такъв механизъм,
// затова редовете се щамповат тук. Един модул, за да е еднаква политиката за
// всички таблици (UTC ISO).

import "chronobaga/src/chrono.baga"
import "std/time/time.baga"

fn kv_now_iso() -> str !Time {
    let t = ts_now()?
    if t.ok == 0 {
        return ""
    }
    return ts_to_iso(t.value)
}

fn kv_today_iso() -> str !Time {
    let d = dt_today()?
    if d.ok == 0 {
        return ""
    }
    return dt_to_iso(d.value)
}
