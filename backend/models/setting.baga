// models/setting.baga — настройки (ключ/стойност) върху KV backend-а.
//
// Ъпсъртът по ключ е същият като в SQL версията, но търсенето минава през
// индекса по "key", не през SELECT.

import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"

fn setting_table() -> str {
    return "settings"
}

fn setting_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM settings")?
}

fn setting_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "key")
    vec_push(c, "value")
    return c
}

fn setting_get_by_key(db: OrmDb, key: str) -> OrmQuery !IO !Net {
    return kv_where_star(db, setting_table(), "key", key)?
}

// Ъпсърт по ключ: съществуващ ред → ОБНОВЯВАНЕ, иначе вмъкване.
fn setting_set_by_key(db: OrmDb, key: str, value: str) -> OrmExec !IO !Net {
    let q = setting_get_by_key(db, key)?
    if orm_ok_q(q) == 0 {
        return OrmEErr(OrmExecFail { err: orm_err_q(q), tag: "", db: orm_db_q(q) })
    }
    if orm_nrows(q) > 0 {
        let id = orm_cell_by_i64(q, 0, "id")
        let cols: Vec<str> = vec_new()
        vec_push(cols, "value")
        let vals: Vec<str> = vec_new()
        vec_push(vals, value)
        return orm_update_by_id(orm_db_q(q), setting_table(), id, cols, vals)?
    }
    let cols: Vec<str> = vec_new()
    vec_push(cols, "key")
    vec_push(cols, "value")
    let vals: Vec<str> = vec_new()
    vec_push(vals, key)
    vec_push(vals, value)
    let nulls: Vec<i64> = vec_new()
    vec_push(nulls, 0)
    vec_push(nulls, 0)
    return kv_insert_exec(orm_db_q(q), setting_table(), cols, vals, nulls)?
}

fn setting_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, setting_table(), "key", setting_cols())?
}

fn setting_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "key", orm_cell_by(q, row, "key"))
    o = jobj_str(o, "value", orm_cell_by(q, row, "value"))
    return o
}

fn setting_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, setting_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}

fn setting_map_get(q: OrmQuery, key: str) -> str {
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        if orm_cell_by(q, i, "key") == key {
            return orm_cell_by(q, i, "value")
        }
        i = i + 1
    }
    return ""
}
