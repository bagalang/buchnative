// models/user.baga — потребители (email login, роля, супер-админ).

import "ormbaga/orm.baga"
import "kvtime.baga"
import "fmrbaga/jsonx.baga"
import "std/str/str.baga"
import "std/crypto/sha256.baga"
import "std/crypto/hmac.baga"
import "std/random/random.baga"
import "std/bytes/bytes.baga"

fn user_table() -> str {
    return "users"
}

fn user_next_id(db: OrmDb) -> OrmCount !IO !Net {
    return kv_count_sql(db, "SELECT MAX(id) AS count FROM users")?
}

// PBKDF2-HMAC-SHA256, 100k итерации (~0.9s на C backend) — преди това беше
// бърз sha256 със статичен префикс. Формат: pbkdf2_sha256$<iters>$<salt_hex>$<dk_hex>
fn user_pbkdf2_iters() -> i64 {
    return 100000
}

fn user_hex_to_bytes(h: str) -> bytes {
    let mut out = bytes_new(0)
    let mut i: i64 = 0
    while i + 1 < len(h) {
        out = bytes_push(out, hex_val(char_at(h, i)) * 16 + hex_val(char_at(h, i + 1)))
        i = i + 2
    }
    return out
}

fn user_bytes_to_hex(b: bytes) -> str {
    let mut v: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < bytes_len(b) {
        vec_push(v, bytes_at(b, i))
        i = i + 1
    }
    return bytes_to_hex(v)
}

fn user_pbkdf2(pw: bytes, salt: bytes, iters: i64) -> bytes {
    let mut msg = bytes_new(0)
    let mut i: i64 = 0
    while i < bytes_len(salt) {
        msg = bytes_push(msg, bytes_at(salt, i))
        i = i + 1
    }
    msg = bytes_push(bytes_push(bytes_push(msg, 0), 0), 0)
    msg = bytes_push(msg, 1)
    let mut u = hmac_sha256_b(pw, msg)
    let mut t = u
    i = 1
    while i < iters {
        u = hmac_sha256_b(pw, u)
        let mut acc = bytes_new(0)
        let mut j: i64 = 0
        while j < bytes_len(u) {
            acc = bytes_push(acc, bytes_at(u, j) ^ bytes_at(t, j))
            j = j + 1
        }
        t = acc
        i = i + 1
    }
    return t
}

fn user_hash_password(email: str, password: str) -> str !Random {
    let salt_raw = random_bytes(16)?
    let mut salt = bytes_new(0)
    let mut i: i64 = 0
    while i < vec_len(salt_raw) {
        salt = bytes_push(salt, vec_get(salt_raw, i))
        i = i + 1
    }
    let pw = bytes_of_str(concat(email, concat("|", password)))
    let dk = user_pbkdf2(pw, salt, user_pbkdf2_iters())
    return concat("pbkdf2_sha256$", concat(int_to_str(user_pbkdf2_iters()), concat("$", concat(user_bytes_to_hex(salt), concat("$", user_bytes_to_hex(dk))))))
}

// Constant-time сравнение на низове (за хешове).
fn user_str_eq_ct(a: str, b: str) -> i64 {
    if len(a) != len(b) {
        return 0
    }
    let mut x: i64 = 0
    let mut i: i64 = 0
    while i < len(a) {
        x = x | (char_at(a, i) ^ char_at(b, i))
        i = i + 1
    }
    if x == 0 {
        return 1
    }
    return 0
}

// Проверка срещу записания хеш: нов формат pbkdf2_sha256$..., иначе legacy
// sha256("buchnative|"+email+"|"+password) — старите хешове още се разпознават
// (препоръчително е rehash при следващ успешен вход).
fn user_check_password(email: str, password: str, stored: str) -> i64 {
    if str_starts_with(stored, "pbkdf2_sha256$") == 1 {
        let parts = str_split(stored, "$")
        if vec_len(parts) != 4 {
            return 0
        }
        let iters = parse_int(vec_get(parts, 1))
        if iters < 1 {
            return 0
        }
        let salt = user_hex_to_bytes(vec_get(parts, 2))
        let want = vec_get(parts, 3)
        let pw = bytes_of_str(concat(email, concat("|", password)))
        let dk = user_pbkdf2(pw, salt, iters)
        return user_str_eq_ct(user_bytes_to_hex(dk), want)
    }
    let want = sha256_hex(concat(concat("buchnative|", email), concat("|", password)))
    return user_str_eq_ct(want, stored)
}

// Дали записаният хеш е от стария (слаб) формат.
fn user_hash_is_legacy(stored: str) -> i64 {
    if str_starts_with(stored, "pbkdf2_sha256$") == 1 {
        return 0
    }
    return 1
}

fn user_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "email")
    vec_push(c, "name")
    vec_push(c, "password_hash")
    vec_push(c, "role")
    vec_push(c, "is_active")
    vec_push(c, "is_super_admin")
    vec_push(c, "role_id")
    vec_push(c, "totp_enabled")
    vec_push(c, "totp_secret_b32")
    vec_push(c, "totp_pending_b32")
    vec_push(c, "created_at")
    return c
}

fn user_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_str(o, "email", orm_cell_by(q, row, "email"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_str(o, "role", orm_cell_by(q, row, "role"))
    o = jobj_i64(o, "is_active", orm_cell_by_i64(q, row, "is_active"))
    o = jobj_i64(o, "is_super_admin", orm_cell_by_i64(q, row, "is_super_admin"))
    o = jobj_i64(o, "role_id", orm_cell_by_i64(q, row, "role_id"))
    o = jobj_i64(o, "totp_enabled", orm_cell_by_i64(q, row, "totp_enabled"))
    let ca = orm_cell_by(q, row, "created_at")
    if ca != "" {
        o = jobj_str(o, "created_at", ca)
    }
    return o
}

fn user_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, user_table(), id, user_cols())?
}

fn user_by_email(db: OrmDb, email: str) -> OrmQuery !IO !Net {
    return kv_where_star(db, user_table(), "email", email)?
}

fn user_all(db: OrmDb) -> OrmQuery !IO !Net {
    return kv_select_all_order(db, user_table(), "name", user_cols())?
}

fn user_create(db: OrmDb, email: str, name: str, password_hash: str, role: str, is_active: i64, is_super_admin: i64, role_id: i64) -> OrmQuery !IO !Net !Time {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "email")
    vec_push(cols, "name")
    vec_push(cols, "password_hash")
    vec_push(cols, "role")
    vec_push(cols, "is_active")
    vec_push(cols, "is_super_admin")
    vec_push(cols, "role_id")
    vec_push(cols, "created_at")
    let vals: Vec<str> = vec_new()
    vec_push(vals, email)
    vec_push(vals, name)
    vec_push(vals, password_hash)
    vec_push(vals, role)
    vec_push(vals, int_to_str(is_active))
    vec_push(vals, int_to_str(is_super_admin))
    vec_push(vals, int_to_str(role_id))
    vec_push(vals, kv_now_iso()?)
    let nulls: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(cols) {
        vec_push(nulls, 0)
        i = i + 1
    }
    return kv_insert(db, user_table(), cols, vals, nulls)?
}

fn user_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return kv_delete_by_id(db, user_table(), id)?
}

fn user_list_json(q: OrmQuery) -> JObj {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, user_to_json(q, i))
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_raw(o, "items", jarr_encode(arr))
    o = jobj_i64(o, "count", orm_nrows(q))
    return o
}

// Смяна на парола: хешът зависи от имейла, затова се преизчислява.
fn user_set_password(db: OrmDb, id: i64, email: str, password: str) -> OrmExec !IO !Net !Random {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "password_hash")
    let vals: Vec<str> = vec_new()
    vec_push(vals, user_hash_password(email, password))
    return orm_update_by_id(db, user_table(), id, cols, vals)?
}

// Смяна на имейл: паролата се прехешира с новия имейл.
fn user_set_email(db: OrmDb, id: i64, new_email: str, password: str) -> OrmExec !IO !Net !Random {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "email")
    vec_push(cols, "password_hash")
    let vals: Vec<str> = vec_new()
    vec_push(vals, new_email)
    vec_push(vals, user_hash_password(new_email, password))
    return orm_update_by_id(db, user_table(), id, cols, vals)?
}

fn user_set_name(db: OrmDb, id: i64, name: str) -> OrmExec !IO !Net {
    let cols: Vec<str> = vec_new()
    vec_push(cols, "name")
    let vals: Vec<str> = vec_new()
    vec_push(vals, name)
    return orm_update_by_id(db, user_table(), id, cols, vals)?
}
