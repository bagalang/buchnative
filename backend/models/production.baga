    o = jobj_str(o, "amount", orm_cell_by(q, row, "amount"))
    return o
}

fn recipe_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, recipe_table(), id, recipe_cols())?
}

fn pord_find(db: OrmDb, id: i64) -> OrmQuery !IO !Net {
    return kv_select_by_id(db, pord_table(), id, pord_cols())?
}

// Рецептите на фирмата: WHERE company_id = ? ORDER BY name, id — двете са
// възходящи, затова kv_where_order2 (името е текстов ключ, id се подравнява).
fn recipe_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order2(db, recipe_table(), "company_id", int_to_str(company_id), "name", "id", recipe_cols())?
}

fn pord_by_company(db: OrmDb, company_id: i64) -> OrmQuery !IO !Net {
    return kv_where_dir(db, pord_table(), "company_id", int_to_str(company_id), pord_cols(), pord_sort_cols(), pord_sort_desc())?
}

// Децата се четат по вторичния индекс на бащата (GET, не скан), поредбата е по id.
fn rline_by_recipe(db: OrmDb, recipe_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, rline_table(), "recipe_id", int_to_str(recipe_id), "id", rline_cols())?
}

fn pline_by_order(db: OrmDb, order_id: i64) -> OrmQuery !IO !Net {
    return kv_where_order(db, pline_table(), "order_id", int_to_str(order_id), "id", pline_cols())?
}

// Следващ PK / номер на поръчка: броячът се ЧЕТЕ (не INCR), за да не дупчи
// номерацията при всяка справка.
fn mfg_next(db: OrmDb, table: str) -> OrmCount !IO !Net {
    return kv_count_sql(db, concat("SELECT MAX(id) AS count FROM ", table))?
}

// Вмъква и връща реда с готовото id (каквото даваше RETURNING *).
fn mfg_insert(db: OrmDb, table: str, cols: Vec<str>, vals: Vec<str>) -> OrmQuery !IO !Net {
    return orm_insert_returning_strs(db, table, cols, vals)?
}

// created_at: KV няма DEFAULT NOW(), щампата се слага в модела.
fn recipe_create(db: OrmDb, company_id: i64, code: str, name: str, output_product_id: i64, output_quantity: str, output_unit: str, notes: str) -> OrmQuery !IO !Net !Time {
    let cols = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "code")
    vec_push(cols, "name")
    vec_push(cols, "output_product_id")
    vec_push(cols, "output_quantity")
    vec_push(cols, "output_unit")
    vec_push(cols, "notes")
    vec_push(cols, "is_active")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, code)
    vec_push(vals, name)
    vec_push(vals, int_to_str(output_product_id))
    vec_push(vals, output_quantity)
    vec_push(vals, output_unit)
    vec_push(vals, notes)
    vec_push(vals, "1")
    vec_push(vals, kv_now_iso()?)
    return mfg_insert(db, recipe_table(), cols, vals)?
}

fn rline_create(db: OrmDb, recipe_id: i64, product_id: i64, quantity: str, unit: str, wastage: str, line_no: i64) -> OrmQuery !IO !Net {
    let cols = vec_new()
    vec_push(cols, "recipe_id")
    vec_push(cols, "product_id")
    vec_push(cols, "quantity")
    vec_push(cols, "unit")
    vec_push(cols, "wastage_percent")
    vec_push(cols, "line_no")
    let vals = vec_new()
    vec_push(vals, int_to_str(recipe_id))
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, quantity)
    vec_push(vals, unit)
    vec_push(vals, wastage)
    vec_push(vals, int_to_str(line_no))
    return mfg_insert(db, rline_table(), cols, vals)?
}

fn pord_create(db: OrmDb, company_id: i64, number: str, recipe_id: i64, output_product_id: i64, quantity: str, location_id: i64, order_date: str, notes: str) -> OrmQuery !IO !Net !Time {
    let cols = vec_new()
    vec_push(cols, "company_id")
    vec_push(cols, "number")
    vec_push(cols, "recipe_id")
    vec_push(cols, "output_product_id")
    vec_push(cols, "quantity")
    vec_push(cols, "location_id")
    vec_push(cols, "order_date")
    vec_push(cols, "status")
    vec_push(cols, "notes")
    vec_push(cols, "material_cost")
    vec_push(cols, "journal_entry_id")
    vec_push(cols, "created_at")
    let vals = vec_new()
    vec_push(vals, int_to_str(company_id))
    vec_push(vals, number)
    vec_push(vals, int_to_str(recipe_id))
    vec_push(vals, int_to_str(output_product_id))
    vec_push(vals, quantity)
    vec_push(vals, int_to_str(location_id))
    vec_push(vals, order_date)
    vec_push(vals, "draft")
    vec_push(vals, notes)
    vec_push(vals, "0")
    vec_push(vals, "0")
    vec_push(vals, kv_now_iso()?)
    return mfg_insert(db, pord_table(), cols, vals)?
}

fn pline_create(db: OrmDb, order_id: i64, product_id: i64, product_name: str, quantity: str, unit: str) -> OrmQuery !IO !Net {
    let cols = vec_new()
    vec_push(cols, "order_id")
    vec_push(cols, "product_id")
    vec_push(cols, "product_name")
    vec_push(cols, "quantity")
    vec_push(cols, "unit")
    vec_push(cols, "unit_cost")
    vec_push(cols, "amount")
    let vals = vec_new()
    vec_push(vals, int_to_str(order_id))
    vec_push(vals, int_to_str(product_id))
    vec_push(vals, product_name)
    vec_push(vals, quantity)
    vec_push(vals, unit)
    vec_push(vals, "0")
    vec_push(vals, "0")
    return mfg_insert(db, pline_table(), cols, vals)?
}

// KV изтрива по PK, затова редовете минават през индекса на бащата.
fn rline_delete_by_recipe(db: OrmDb, recipe_id: i64) -> OrmExec !IO !Net {
    return kv_delete_where(db, rline_table(), "recipe_id", int_to_str(recipe_id))?
}

fn pline_delete_by_order(db: OrmDb, order_id: i64) -> OrmExec !IO !Net {
    return kv_delete_where(db, pline_table(), "order_id", int_to_str(order_id))?
}

fn recipe_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, recipe_table(), id)?
}

fn pord_delete(db: OrmDb, id: i64) -> OrmExec !IO !Net {
    return orm_delete_by_id(db, pord_table(), id)?
}

fn rline_list_json(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, rline_to_json(q, i))
        i = i + 1
    }
    return arr
}

fn pline_list_json(q: OrmQuery) -> JArr {
    let mut arr = jarr_new()
    let mut i: i64 = 0
    while i < orm_nrows(q) {
        arr = jarr_obj(arr, pline_to_json(q, i))
        i = i + 1
    }
    return arr
}
