// models/production.baga — рецепти (BOM) и производствени поръчки върху KV (rocksbaga).
//
// Сигнатурите са тези от SQL версията, затова actions/recipes.baga и
// actions/production*.baga не се пипат: kv_select_* попълва същия OrmQuery,
// който orm_cell_by/orm_nrows/orm_db_q четат. boilaDB клоните изчезнаха —
// id-то го раздава броячът на таблицата, не моделът.
// Суми и количества са NUMERIC като стринг.

import "ormbaga/orm.baga"
import "fmrbaga/jsonx.baga"
import "kvtime.baga"
import "std/str/str.baga"

fn recipe_table() -> str { return "recipes" }
fn rline_table() -> str { return "recipe_lines" }
fn pord_table() -> str { return "production_orders" }
fn pline_table() -> str { return "production_order_lines" }

// Колоните на реда — заместват SELECT списъците, в същия ред като SQL-а,
// за да чете action-ът една и съща колона по име.
fn recipe_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "company_id")
    vec_push(c, "code")
    vec_push(c, "name")
    vec_push(c, "output_product_id")
    vec_push(c, "output_quantity")
    vec_push(c, "output_unit")
    vec_push(c, "notes")
    vec_push(c, "is_active")
    vec_push(c, "created_at")
    return c
}

fn rline_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "recipe_id")
    vec_push(c, "product_id")
    vec_push(c, "quantity")
    vec_push(c, "unit")
    vec_push(c, "wastage_percent")
    vec_push(c, "line_no")
    return c
}

fn pord_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "company_id")
    vec_push(c, "number")
    vec_push(c, "recipe_id")
    vec_push(c, "output_product_id")
    vec_push(c, "quantity")
    vec_push(c, "location_id")
    vec_push(c, "order_date")
    vec_push(c, "status")
    vec_push(c, "notes")
    vec_push(c, "material_cost")
    vec_push(c, "journal_entry_id")
    vec_push(c, "created_at")
    return c
}

fn pline_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    vec_push(c, "order_id")
    vec_push(c, "product_id")
    vec_push(c, "product_name")
    vec_push(c, "quantity")
    vec_push(c, "unit")
    vec_push(c, "unit_cost")
    vec_push(c, "amount")
    return c
}

// ORDER BY id DESC за списъка с поръчки (най-новата първа): kv_where_dir
// иска колони и посоки като два вектора, 1 = DESC.
fn pord_sort_cols() -> Vec<str> {
    let c: Vec<str> = vec_new()
    vec_push(c, "id")
    return c
}

fn pord_sort_desc() -> Vec<i64> {
    let d: Vec<i64> = vec_new()
    vec_push(d, 1)
    return d
}

fn recipe_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "company_id", orm_cell_by_i64(q, row, "company_id"))
    o = jobj_str(o, "code", orm_cell_by(q, row, "code"))
    o = jobj_str(o, "name", orm_cell_by(q, row, "name"))
    o = jobj_i64(o, "output_product_id", orm_cell_by_i64(q, row, "output_product_id"))
    o = jobj_str(o, "output_quantity", orm_cell_by(q, row, "output_quantity"))
    o = jobj_str(o, "output_unit", orm_cell_by(q, row, "output_unit"))
    o = jobj_str(o, "notes", orm_cell_by(q, row, "notes"))
    o = jobj_i64(o, "is_active", orm_cell_by_i64(q, row, "is_active"))
    return o
}

fn rline_to_json(q: OrmQuery, row: i64) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", orm_cell_by_i64(q, row, "id"))
    o = jobj_i64(o, "recipe_id", orm_cell_by_i64(q, row, "recipe_id"))
    o = jobj_i64(o, "product_id", orm_cell_by_i64(q, row, "product_id"))
    o = jobj_str(o, "quantity", orm_cell_by(q, row, "quantity"))
    o = jobj_str(o, "unit", orm_cell_by(q, row, "unit"))
    o = jobj_str(o, "wastage_percent", orm_cell_by(q, row, "wastage_percent"))
    o = jobj_i64(o, "line_no", orm_cell_by_i64(q, row, "line_no"))
    return o
}

