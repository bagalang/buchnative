// schema.baga — миграции на buchnative (принадлежат на приложението, не на framework-а).
//
// Единствено на PostgreSQL DDL: SERIAL/NOT NULL/DEFAULT от фаза 1. Исторически
// съществуваше и boilaDB набор (BoilaSQL нямаше SERIAL/DEFAULT/NOT NULL), но
// buchnative вече не се използва с boilaDB — наборът е премахнат, заедно с
// дублиращите го CREATE/ALTER. На rocksbaga (ORM_BACKEND=drock) няма DDL —
// редовете са JSON и колоните се появяват при първия запис (виж schema_kv.baga).
//
// Списъците са в schema_pg_a/b/c (filesize gate 600).

import "ormbaga/migrate.baga"
import "schema_pg_a.baga"
import "schema_pg_b.baga"
import "schema_pg_c.baga"

fn mig_append(dst: MigrationSet, src: MigrationSet) -> MigrationSet {
    let mut out = dst
    let mut i: i64 = 0
    while i < migrate_len(src) {
        let m = migrate_at(src, i)
        out = migrate_add(out, m.version, m.name, m.up, m.down)
        i = i + 1
    }
    return out
}

fn buchnative_migrations() -> MigrationSet {
    return mig_append(mig_append(buchnative_migrations_a(), buchnative_migrations_b()), buchnative_migrations_c())
}
