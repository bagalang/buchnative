// time.baga — wall-clock helpers over chronobaga (UTC ISO).

import "chronobaga/src/chrono.baga"
import "std/time/time.baga"

fn bn_now_iso() -> str !Time {
    let t = ts_now()?
    if t.ok == 0 {
        return ""
    }
    return ts_to_iso(t.value)
}

fn bn_today() -> str !Time {
    let d = dt_today()?
    if d.ok == 0 {
        return ""
    }
    return dt_to_iso(d.value)
}

fn bn_today_period() -> str !Time {
    let t = bn_today()?
    if len(t) < 7 {
        return t
    }
    return substr(t, 0, 7)
}
