// report_util.baga — натрупване на салда в период от годината.
//
// Салдата са инкрементални по месец. За баланс (НСС2) трябва начално салдо +
// натрупани месеци от началото на годината до дадения период.

import "store.baga"
import "store_scan.baga"
import "json.baga"
import "money.baga"
import "model_account.baga"
import "model_journal.baga"
import "model_opening.baga"
import "std/str/str.baga"

fn bn_months_upto(upto: str) -> Vec<str> {
    let out: Vec<str> = vec_new()
    let mut n = parse_int(substr(upto, 5, 7))
    if n < 1 {
        n = 1
    }
    if n > 12 {
        n = 12
    }
    let mut i: i64 = 1
    while i <= n {
        let mut m = int_to_str(i)
        if len(m) < 2 {
            m = concat("0", m)
        }
        vec_push(out, m)
        i = i + 1
    }
    return out
}

// Натрупано салдо по сметка от началото на годината до периода включително.
fn bn_bal_cumulative(db: DrokDB, co: i64, year: str, upto: str, account: str) -> BnBalance !Net !IO {
    let months = bn_months_upto(upto)?
    let acc = bn_bal_zero(co, upto, account)
    let mut i: i64 = 0
    while i < vec_len(months) {
        let period = concat(year, concat("-", vec_get(months, i)))
        let b = bn_bal_load(db, co, period, account)?
        acc.debit = bn_money_add(acc.debit, b.debit)
        acc.credit = bn_money_add(acc.credit, b.credit)
        acc.lines = acc.lines + b.lines
        i = i + 1
    }
    let ob = bn_ob_load(db, co, account, year)?
    acc.debit = bn_money_add(acc.debit, ob.debit)
    acc.credit = bn_money_add(acc.credit, ob.credit)
    if bn_ac_side(bn_ac_load(db, co, account)?.cls) == "debit" {
        acc.balance = bn_money_sub(acc.debit, acc.credit)
    } else {
        acc.balance = bn_money_sub(acc.credit, acc.debit)
    }
    return acc
}

// Периодично салдо по сметка (само този месец).
fn bn_bal_period(db: DrokDB, co: i64, period: str, account: str) -> BnBalance !Net !IO {
    return bn_bal_load(db, co, period, account)?
}

// Периодични салда по сметки с даден клас.
fn bn_bal_by_class(db: DrokDB, co: i64, period: str, cls: i64) -> Vec<BnBalance> !Net !IO {
    let keys = bn_scan_key_strs(db, bn_k_bal_prefix(co, period))?
    let prefix = bn_k_bal_prefix(co, period)
    let out: Vec<BnBalance> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(keys) {
        let account = substr(vec_get(keys, i), len(prefix), len(vec_get(keys, i)))
        let a = bn_ac_load(db, co, account)?
        if a.cls == cls {
            vec_push(out, bn_bal_load(db, co, period, account)?)
        }
        i = i + 1
    }
    return out
}

// Натрупани салда по сметки с даден клас.
fn bn_bal_cum_by_class(db: DrokDB, co: i64, year: str, upto: str, cls: i64) -> Vec<BnBalance> !Net !IO {
    let accounts = bn_ac_all(db, co)?
    let out: Vec<BnBalance> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(accounts) {
        let a = vec_get(accounts, i)
        if a.cls == cls {
            vec_push(out, bn_bal_cumulative(db, co, year, upto, a.code)?)
        }
        i = i + 1
    }
    return out
}

// Знакова сума на сметка според страната: активи/разходи → дебит, пасиви/приходи → кредит.
fn bn_bal_signed(b: BnBalance) -> str {
    if bn_ac_side(bn_bal_class(b.account)) == "debit" {
        return bn_money_sub(b.debit, b.credit)
    }
    return bn_money_sub(b.credit, b.debit)
}
