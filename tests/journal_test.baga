// journal_test.baga — интеграционен тест на дневника, салдата и отчетите.
//
// Нужен е работещ rocksbaga на DROCK_PORT (по подразбиране 16579). Тестът
// работи върху отделна фирма (id 900001), за да не засега други данни.
//
//   DROCK_PORT=16579 ./baga -I . -I app-product app-product/buchnative/tests/journal_test.baga

import "../store.baga"
import "../json.baga"
import "../money.baga"
import "../time.baga"
import "../model_company.baga"
import "../model_account.baga"
import "../model_counterpart.baga"
import "../model_journal.baga"
import "../model_journal_query.baga"
import "../model_invoice.baga"
import "../model_period.baga"
import "../model_opening.baga"
import "../report_trial.baga"
import "../report_ledger.baga"
import "../report_fs.baga"
import "std/json/json.baga"
import "std/os/os.baga"
import "std/str/str.baga"

fn need(cond: bool, fails: Map<str, i64>, label: str) {
    if cond == false {
        print(concat("FAIL ", label))
        map_set(fails, label, 1)
    }
}

fn need_i(cond: i64, fails: Map<str, i64>, label: str) {
    if cond == 0 {
        print(concat("FAIL ", label))
        map_set(fails, label, 1)
    }
}

fn bn_t_lines(a1: str, d1: str, c1: str, a2: str, d2: str, c2: str) -> Vec<BnLine> {
    let out: Vec<BnLine> = vec_new()
    let l1 = bn_line_zero()
    l1.account = a1
    l1.debit = d1
    l1.credit = c1
    vec_push(out, l1)
    let l2 = bn_line_zero()
    l2.account = a2
    l2.debit = d2
    l2.credit = c2
    vec_push(out, l2)
    return out
}

fn bn_t_flush(db: DrokDB, co: i64) -> i64 !Net !IO {
    // Изчиства ключовете на фирмата от предишни прогони.
    let prefixes: Vec<str> = vec_new()
    vec_push(prefixes, bn_k_je_prefix(co, "2026-11"))
    vec_push(prefixes, concat("bn:jl:", int_to_str(co)))
    vec_push(prefixes, bn_k_bal_prefix(co, "2026-11"))
    vec_push(prefixes, bn_k_bal_prefix(co, "2026-10"))
    vec_push(prefixes, concat("bn:seq:", int_to_str(co)))
    vec_push(prefixes, concat("bn:acc:", int_to_str(co)))
    vec_push(prefixes, concat("bn:cp:", int_to_str(co)))
    vec_push(prefixes, concat("bn:inv:", int_to_str(co)))
    vec_push(prefixes, concat("bn:per:", int_to_str(co)))
    vec_push(prefixes, concat("bn:ob:", int_to_str(co)))
    vec_push(prefixes, bn_k_co(co))
    let doomed: Vec<str> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(prefixes) {
        let ks = bn_scan_key_strs(db, vec_get(prefixes, i))?
        let mut j: i64 = 0
        while j < vec_len(ks) {
            vec_push(doomed, vec_get(ks, j))
            j = j + 1
        }
        i = i + 1
    }
    if vec_len(doomed) > 0 {
        bn_del_many(db, doomed)?
    }
    return 0
}

fn main() -> i64 !Net !IO !Time !Par {
    let fails: Map<str, i64> = map_new()
    let db = bn_open_env()?
    if drock_ok(db) == 0 {
        print(concat("SKIP journal_test: ", drock_last_error(db)))
        return 0
    }
    let co: i64 = 900001
    bn_t_flush(db, co)?
    let c0 = BnCompany { id: co, name: "Тестова фирма", eik: "", vat: "", city: "", address: "", owner: "", created_at: "2026-11-02T10:00:00" }
    bn_co_save(db, c0)?

    // ── сметкоплан ──
    bn_ac_seed(db, co)?
    need_i(bn_ac_exists(db, co, "211")?, fails, "account 211")
    need_i(bn_ac_exists(db, co, "301")?, fails, "account 301")
    need(bn_ac_side(2) == "debit", fails, "class 2 is debit")
    need(bn_ac_side(3) == "credit", fails, "class 3 is credit")

    // ── начално салдо ──
    let ob = bn_ob_zero(co, "2026", "231")
    ob.debit = "100000.00"
    bn_ob_save(db, ob)?
    let obl = bn_ob_load(db, co, "231", "2026")?
    need(obl.debit == "100000.00", fails, "opening balance stored")
    let ob2 = bn_ob_zero(co, "2026", "301")
    ob2.credit = "100000.00"
    bn_ob_save(db, ob2)?

    // ── проводка ──
    let l1 = bn_t_lines("231", "100000.00", "0.00", "301", "0.00", "100000.00")
    let r1 = bn_je_post(db, co, "2026-11-02", "opening", "OB-1", "Въведен капитал", l1, "test", "2026-11-02T10:00:00")?
    need(r1.ok == 1, fails, "post ok")
    need(r1.number == 1, fails, "first entry number is 1")

    let bal231 = bn_bal_load(db, co, "2026-11", "231")?
    need(bal231.debit == "100000.00", fails, "balance 231 debit")
    need(bal231.lines == 1, fails, "balance 231 line count")

    // ── валидации ──
    let bad1 = bn_t_lines("211", "100.00", "0.00", "701", "0.00", "90.00")
    let rb1 = bn_je_post(db, co, "2026-11-03", "x", "X1", "небалансирана", bad1, "test", "")?
    need(rb1.ok == 0, fails, "unbalanced rejected")

    let bad2 = bn_t_lines("211", "100.00", "100.00", "701", "0.00", "100.00")
    let rb2 = bn_je_post(db, co, "2026-11-03", "x", "X2", "дебит+кредит", bad2, "test", "")?
    need(rb2.ok == 0, fails, "debit+credit rejected")

    let bad3 = bn_t_lines("999", "100.00", "0.00", "701", "0.00", "100.00")
    let rb3 = bn_je_post(db, co, "2026-11-03", "x", "X3", "невалидна сметка", bad3, "test", "")?
    need(rb3.ok == 0, fails, "unknown account rejected")

    let bad4: Vec<BnLine> = vec_new()
    let one = bn_line_zero()
    one.account = "211"
    one.debit = "1.00"
    vec_push(bad4, one)
    let rb4 = bn_je_post(db, co, "2026-11-03", "x", "X4", "един ред", bad4, "test", "")?
    need(rb4.ok == 0, fails, "single line rejected")

    // ── затворен период ──
    let l2 = bn_t_lines("211", "1200.00", "0.00", "701", "0.00", "1200.00")
    let r2 = bn_je_post(db, co, "2026-10-05", "sale", "S-1", "Продажба", l2, "test", "")?
    need(r2.ok == 1, fails, "post to 2026-10")
    bn_per_close(db, co, "2026-10")?
    let r3 = bn_je_post(db, co, "2026-10-06", "sale", "S-2", "след затваряне", l2, "test", "")?
    need(r3.ok == 0, fails, "closed period rejected")
    bn_per_reopen(db, co, "2026-10")?

    // ── оборотна ведомост ──
    let trial = bn_trial_json(db, co, "2026-11")?
    let ttxt = jobj_encode(trial)
    need(str_find(ttxt, "\"balanced\":\"1\"") >= 0, fails, "trial balanced")
    need(str_find(ttxt, "100000.00") >= 0, fails, "trial shows opening")

    // ── главна книга ──
    let led = bn_ledger_json(db, co, "231", "2026-11")?
    let ltxt = jobj_encode(led)
    need(str_find(ltxt, "\"number\":1") >= 0, fails, "ledger has entry 1")
    need(str_find(ltxt, "100000.00") >= 0, fails, "ledger running balance")

    // ── НСС1 ──
    let pl = bn_fs_pl_json(db, co, "2026-11")?
    let ptxt = jobj_encode(pl)
    need(str_find(ptxt, "\"total_income\":\"0.00\"") >= 0, fails, "pl income zero in nov")

    // ── НСС2 ──
    let bs = bn_fs_bs_json(db, co, "2026-11")?
    let btxt = jobj_encode(bs)
    need(str_find(btxt, "\"balanced\":\"1\"") >= 0, fails, "bs balanced")

    // ── фактура + автопроводка ──
    let cp_id = bn_next_id(db, "cp")?
    let cp = bn_cp_zero()
    cp.id = cp_id
    cp.name = "ООД Тест"
    cp.is_customer = 1
    bn_cp_save(db, co, cp)?

    let inv_lines: Vec<BnInvoiceLine> = vec_new()
    let il = bn_inv_line_zero()
    il.name = "Стока А"
    il.qty = "10.00"
    il.price = "50.00"
    il.vat_pct = "20.00"
    vec_push(inv_lines, il)
    let inv = bn_inv_zero()
    inv.id = bn_next_id(db, "inv")?
    inv.company = co
    inv.number = "INV-T1"
    inv.kind = "sale"
    inv.date = "2026-11-15"
    inv.period = "2026-11"
    inv.counterpart = cp_id
    inv.counterpart_name = "ООД Тест"
    inv.lines = inv_lines
    let inv2 = bn_inv_recompute(inv)
    need(inv2.net == "500.00", fails, "invoice net")
    need(inv2.vat == "100.00", fails, "invoice vat")
    need(inv2.total == "600.00", fails, "invoice total")
    bn_inv_save(db, co, inv2)?

    let ip = bn_inv_post(db, co, inv2.id, "test", "")?
    need(ip.ok == 1, fails, "invoice posted")
    let inv3 = bn_inv_load(db, co, inv2.id)?
    need(inv3.status == "posted", fails, "invoice status posted")
    need(inv3.journal_entry > 0, fails, "invoice journal entry")

    // Проводката на фактурата: Дт 211 / Кт 701 + Кт 521
    let e = bn_je_get(db, co, "2026-11", inv3.journal_entry)?
    need(vec_len(e.lines) == 3, fails, "invoice posting has 3 lines")
    let mut has211: i64 = 0
    let mut has701: i64 = 0
    let mut has521: i64 = 0
    let mut i: i64 = 0
    while i < vec_len(e.lines) {
        if vec_get(e.lines, i).account == "211" {
            has211 = 1
        }
        if vec_get(e.lines, i).account == "701" {
            has701 = 1
        }
        if vec_get(e.lines, i).account == "521" {
            has521 = 1
        }
        i = i + 1
    }
    need_i(has211, fails, "sale posting debits 211")
    need_i(has701, fails, "sale posting credits 701")
    need_i(has521, fails, "sale posting credits 521")

    // ── НСС1 след продажба ──
    let pl2 = bn_fs_pl_json(db, co, "2026-11")?
    let pl2txt = jobj_encode(pl2)
    need(str_find(pl2txt, "\"total_income\":\"500.00\"") >= 0, fails, "pl income 500")
    need(str_find(pl2txt, "\"kind\":\"profit\"") >= 0, fails, "pl is profit")

    // ── баланс след продажба ──
    let bs2 = bn_fs_bs_json(db, co, "2026-11")?
    let bs2txt = jobj_encode(bs2)
    need(str_find(bs2txt, "\"balanced\":\"1\"") >= 0, fails, "bs balanced after sale")

    // ── сторно ──
    let rs = bn_je_reverse(db, co, "2026-11", inv3.journal_entry, "test", "")?
    need(rs.ok == 1, fails, "reverse ok")
    let e2 = bn_je_get(db, co, "2026-11", rs.number)?
    need(e2.doc_type == "storno", fails, "storno doc type")
    let bal211b = bn_bal_load(db, co, "2026-11", "211")?
    need(bn_money_eq(bal211b.balance, "0.00") == 1, fails, "storno zeroes 211 balance")

    // ── повторна сметка в записа ──
    let dup: Vec<BnLine> = vec_new()
    let d1 = bn_line_zero()
    d1.account = "211"
    d1.debit = "100.00"
    vec_push(dup, d1)
    let d2 = bn_line_zero()
    d2.account = "211"
    d2.debit = "50.00"
    vec_push(dup, d2)
    let d3 = bn_line_zero()
    d3.account = "701"
    d3.credit = "150.00"
    vec_push(dup, d3)
    let rd = bn_je_post(db, co, "2026-11-12", "x", "DUP", "повторна сметка", dup, "test", "")?
    need(rd.ok == 1, fails, "duplicate account post ok")
    // 211 има 600 дебит и 600 кредит от фактурата и нейното сторно, плюс 150
    // от повторната сметка — салдото трябва да е точно 150, не 300.
    let bal211dup = bn_bal_load(db, co, "2026-11", "211")?
    let dup_balance = bn_money_sub(bal211dup.debit, bal211dup.credit)
    need(bn_money_eq(dup_balance, "150.00") == 1, fails, "duplicate account aggregated")
    // Главна книга пази всяка линия: 600 (фактура) + 600 (сторно) + 100 + 50.
    let dup_rows = bn_ledger_rows(db, co, "211", "2026-11")?
    need(vec_len(dup_rows) == 4, fails, "ledger keeps both duplicate lines")

    // ── номер на запис: номерност без дупки ──
    let last = bn_je_get(db, co, "2026-11", rs.number)?
    need(last.number == rs.number, fails, "entry number stable")

    drock_close(db)?
    if map_len(fails) == 0 {
        print("journal_test: ok")
        return 0
    }
    print(concat("journal_test: ", concat(int_to_str(map_len(fails)), " failure(s)")))
    return 1
}
