// money_test.baga — чисти тестове на десетичните пари (без сървър).
//
//   ./baga -I . -I app-product app-product/buchnative/tests/money_test.baga

import "../money.baga"
import "std/str/str.baga"

fn main() -> i64 {
    let mut bad: i64 = 0

    if bn_money_add("1.005", "2.005") != "3.01" {
        print("FAIL add rounding")
        bad = bad + 1
    }
    if bn_money_sub("10.00", "0.01") != "9.99" {
        print("FAIL sub")
        bad = bad + 1
    }
    if bn_money_mul("10.00", "1.2") != "12.00" {
        print("FAIL mul")
        bad = bad + 1
    }
    if bn_money_div("1.00", "3.00") != "0.33" {
        print("FAIL div rounding")
        bad = bad + 1
    }
    if bn_money_div("1.00", "0.00") != "0.00" {
        print("FAIL div by zero")
        bad = bad + 1
    }
    if bn_money_neg("5.00") != "-5.00" {
        print("FAIL neg")
        bad = bad + 1
    }
    if bn_money_abs("-5.00") != "5.00" {
        print("FAIL abs")
        bad = bad + 1
    }
    if bn_money_is_zero("0.00") != 1 {
        print("FAIL is_zero")
        bad = bad + 1
    }
    if bn_money_cmp("1.00", "2.00") >= 0 {
        print("FAIL cmp")
        bad = bad + 1
    }
    if bn_money_percent("1000.00", "20.00") != "200.00" {
        print("FAIL percent")
        bad = bad + 1
    }
    if bn_money_round2("1.005") != "1.01" {
        print("FAIL round2")
        bad = bad + 1
    }
    // Сума на списък
    let items: Vec<str> = vec_new()
    vec_push(items, "1.10")
    vec_push(items, "2.20")
    vec_push(items, "3.30")
    if bn_money_sum(items) != "6.60" {
        print("FAIL sum")
        bad = bad + 1
    }
    // Невалиден текст не отравя — става 0.00
    if bn_money_is_valid("abc") != 0 {
        print("FAIL is_valid")
        bad = bad + 1
    }
    if bn_money_add("abc", "1.00") != "1.00" {
        print("FAIL invalid becomes zero")
        bad = bad + 1
    }
    // Без f64: 0.1 + 0.2 трябва да е точно 0.30
    if bn_money_add("0.10", "0.20") != "0.30" {
        print("FAIL decimal exactness")
        bad = bad + 1
    }

    if bad == 0 {
        print("money_test: ok")
        return 0
    }
    print(concat("money_test: ", concat(int_to_str(bad), " failure(s)")))
    return 1
}
