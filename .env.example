# buchnative — настройки (копрай в .env и промени)
#
# Свързване към rocksbaga (RESP2 сървърът, на app-product/rocksbaga)
DROCK_HOST=127.0.0.1
DROCK_PORT=16579
# Колко връзки към rocksbaga държи сървърът (FMR_WORKERS ≤ това)
DROCK_POOL=8

# HTTP API
PORT=8090
FMR_WORKERS=4
FMR_LOG=1
FMR_CORS=*
# Идл таймаут на keep-alive конекция (сек); 0 = без таймаут
BN_IDLE_S=30
FMR_JWT_SECRET=change-me-before-vps
# JWT живейни секунди (минимум 300)
FMR_JWT_TTL_SEC=604800

# Bootstrap супер-админ (създава се с `buchnative seed`)
BN_ADMIN_EMAIL=superadmin
BN_ADMIN_PASSWORD=123+123
# Bootstrap фирма и сметкоплан
BN_SEED_COMPANY=BN-DEMO
BN_SEED_CHART=bg-basic
