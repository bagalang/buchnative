// report_fs.baga — финансови отчети по НСС: резултат (НСС1) и баланс (НСС2).
//
// НСС1 за период: приходи (клас 7) минус разходи (клас 6).
// НСС2 към края на период: начално салдо + натрупани месеци от годината.

import "store.baga"
import "json.baga"
import "money.baga"
import "fmrbaga/jsonx.baga"
import "model_account.baga"
import "model_journal.baga"
import "report_util.baga"
import "std/json/json.baga"
import "std/str/str.baga"

struct BnFsRow {
    code: str,
    name: str,
    amount: str
}

fn bn_fs_row_zero() -> BnFsRow {
    return BnFsRow { code: "", name: "", amount: "0.00" }
}

fn bn_fs_row_to_json(r: BnFsRow) -> JObj {
    let mut o = jobj_new()
    o = jobj_str(o, "code", r.code)
    o = jobj_str(o, "name", r.name)
    o = jobj_str(o, "amount", r.amount)
    return o
}

fn bn_fs_row(b: BnBalance, a: BnAccount) -> BnFsRow {
    let r = bn_fs_row_zero()
    r.code = a.code
    r.name = a.name
    r.amount = bn_money_abs(bn_bal_signed(b))
    return r
}

// ── НСС1: отчет за финансовия резултат ────────────────────────────────────

fn bn_fs_pl_json(db: DrokDB, co: i64, period: str) -> JObj !Net !IO {
    let year = bn_year_of(period)
    let income = bn_bal_by_class(db, co, period, 7)?
    let expense = bn_bal_by_class(db, co, period, 6)?
    let mut ia = jarr_new()
    let mut ea = jarr_new()
    let mut ti = bn_money_zero()
    let mut te = bn_money_zero()
    let mut i: i64 = 0
    while i < vec_len(income) {
        let a = bn_ac_load(db, co, vec_get(income, i).account)?
        let signed = bn_bal_signed(vec_get(income, i))
        if bn_money_gt(signed, bn_money_zero()) == 1 {
            ia = jarr_obj(ia, bn_fs_row_to_json(bn_fs_row(vec_get(income, i), a)))
            ti = bn_money_add(ti, signed)
        }
        i = i + 1
    }
    let mut j: i64 = 0
    while j < vec_len(expense) {
        let a = bn_ac_load(db, co, vec_get(expense, j).account)?
        let signed = bn_bal_signed(vec_get(expense, j))
        if bn_money_gt(signed, bn_money_zero()) == 1 {
            ea = jarr_obj(ea, bn_fs_row_to_json(bn_fs_row(vec_get(expense, j), a)))
            te = bn_money_add(te, signed)
        }
        j = j + 1
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "company", co)
    o = jobj_str(o, "period", period)
    o = jobj_str(o, "year", year)
    o = jobj_arr(o, "income", ia)
    o = jobj_str(o, "total_income", ti)
    o = jobj_arr(o, "expense", ea)
    o = jobj_str(o, "total_expense", te)
    o = jobj_str(o, "result", bn_money_sub(ti, te))
    if bn_money_gt(ti, te) == 1 {
        o = jobj_str(o, "kind", "profit")
    } else {
        o = jobj_str(o, "kind", "loss")
    }
    return o
}

// Натрупан НСС1 за годината до периода.
fn bn_fs_pl_year_json(db: DrokDB, co: i64, period: str) -> JObj !Net !IO {
    let year = bn_year_of(period)
    let income = bn_bal_cum_by_class(db, co, year, period, 7)?
    let expense = bn_bal_cum_by_class(db, co, year, period, 6)?
    let mut ia = jarr_new()
    let mut ea = jarr_new()
    let mut ti = bn_money_zero()
    let mut te = bn_money_zero()
    let mut i: i64 = 0
    while i < vec_len(income) {
        let a = bn_ac_load(db, co, vec_get(income, i).account)?
        let signed = bn_bal_signed(vec_get(income, i))
        if bn_money_gt(signed, bn_money_zero()) == 1 {
            ia = jarr_obj(ia, bn_fs_row_to_json(bn_fs_row(vec_get(income, i), a)))
            ti = bn_money_add(ti, signed)
        }
        i = i + 1
    }
    let mut j: i64 = 0
    while j < vec_len(expense) {
        let a = bn_ac_load(db, co, vec_get(expense, j).account)?
        let signed = bn_bal_signed(vec_get(expense, j))
        if bn_money_gt(signed, bn_money_zero()) == 1 {
            ea = jarr_obj(ea, bn_fs_row_to_json(bn_fs_row(vec_get(expense, j), a)))
            te = bn_money_add(te, signed)
        }
        j = j + 1
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "company", co)
    o = jobj_str(o, "period", period)
    o = jobj_str(o, "year", year)
    o = jobj_str(o, "scope", "year-to-date")
    o = jobj_arr(o, "income", ia)
    o = jobj_str(o, "total_income", ti)
    o = jobj_arr(o, "expense", ea)
    o = jobj_str(o, "total_expense", te)
    o = jobj_str(o, "result", bn_money_sub(ti, te))
    if bn_money_gt(ti, te) == 1 {
        o = jobj_str(o, "kind", "profit")
    } else {
        o = jobj_str(o, "kind", "loss")
    }
    return o
}

// ── НСС2: баланс ──────────────────────────────────────────────────────────

// Натрупан резултат за годината — трети се като част от пасива.
fn bn_fs_result(db: DrokDB, co: i64, year: str, period: str) -> str !Net !IO {
    let income = bn_bal_cum_by_class(db, co, year, period, 7)?
    let expense = bn_bal_cum_by_class(db, co, year, period, 6)?
    let mut ti = bn_money_zero()
    let mut te = bn_money_zero()
    let mut i: i64 = 0
    while i < vec_len(income) {
        ti = bn_money_add(ti, bn_bal_signed(vec_get(income, i)))
        i = i + 1
    }
    let mut j: i64 = 0
    while j < vec_len(expense) {
        te = bn_money_add(te, bn_bal_signed(vec_get(expense, j)))
        j = j + 1
    }
    return bn_money_sub(ti, te)
}

fn bn_fs_bs_json(db: DrokDB, co: i64, period: str) -> JObj !Net !IO {
    let year = bn_year_of(period)
    let assets = bn_fs_side(db, co, year, period, 1)?
    let assets2 = bn_fs_side(db, co, year, period, 2)?
    let equity = bn_fs_side(db, co, year, period, 3)?
    let liab4 = bn_fs_side(db, co, year, period, 4)?
    let liab5 = bn_fs_side(db, co, year, period, 5)?
    let result = bn_fs_result(db, co, year, period)?
    let total_assets = bn_money_add(assets.total, assets2.total)
    let total_liab = bn_money_add(bn_money_add(equity.total, liab4.total), liab5.total)
    let total_passive = bn_money_add(total_liab, result)
    let mut o = jobj_new()
    o = jobj_i64(o, "company", co)
    o = jobj_str(o, "period", period)
    o = jobj_str(o, "year", year)
    o = jobj_arr(o, "long_term_assets", assets.rows)
    o = jobj_arr(o, "current_assets", assets2.rows)
    o = jobj_str(o, "total_assets", total_assets)
    o = jobj_arr(o, "equity", equity.rows)
    o = jobj_str(o, "total_equity", equity.total)
    o = jobj_arr(o, "long_term_liabilities", liab4.rows)
    o = jobj_arr(o, "current_liabilities", liab5.rows)
    o = jobj_str(o, "total_liabilities", bn_money_add(liab4.total, liab5.total))
    o = jobj_str(o, "result", result)
    if bn_money_gt(result, bn_money_zero()) == 1 {
        o = jobj_str(o, "result_kind", "profit")
    } else {
        o = jobj_str(o, "result_kind", "loss")
    }
    o = jobj_str(o, "total_passive", total_passive)
    if bn_money_eq(total_assets, total_passive) == 1 {
        o = jobj_str(o, "balanced", "1")
    } else {
        o = jobj_str(o, "balanced", "0")
    }
    return o
}

struct BnFsSide {
    rows: JArr,
    total: str
}

fn bn_fs_side(db: DrokDB, co: i64, year: str, period: str, cls: i64) -> BnFsSide !Net !IO {
    let bals = bn_bal_cum_by_class(db, co, year, period, cls)?
    let mut a = jarr_new()
    let mut total = bn_money_zero()
    let mut i: i64 = 0
    while i < vec_len(bals) {
        let acc = bn_ac_load(db, co, vec_get(bals, i).account)?
        let signed = bn_bal_signed(vec_get(bals, i))
        if bn_money_gt(signed, bn_money_zero()) == 1 {
            a = jarr_obj(a, bn_fs_row_to_json(bn_fs_row(vec_get(bals, i), acc)))
            total = bn_money_add(total, signed)
        }
        i = i + 1
    }
    return BnFsSide { rows: a, total: total }
}
