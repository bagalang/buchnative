// model_counterpart.baga — контрагенти (клиенти и доставчици).

import "store.baga"
import "json.baga"
import "fmrbaga/jsonx.baga"
import "std/json/json.baga"
import "std/str/str.baga"

struct BnCounterpart {
    id: i64,
    name: str,
    eik: str,
    vat: str,
    city: str,
    address: str,
    email: str,
    phone: str,
    is_customer: i64,
    is_supplier: i64,
    created_at: str
}

fn bn_cp_zero() -> BnCounterpart {
    return BnCounterpart { id: 0, name: "", eik: "", vat: "", city: "", address: "", email: "", phone: "", is_customer: 0, is_supplier: 0, created_at: "" }
}

fn bn_cp_from_json(d: JsonDoc, root: i64) -> BnCounterpart {
    return BnCounterpart {
        id: bn_j_i64(d, root, "id"),
        name: bn_j_str(d, root, "name"),
        eik: bn_j_str(d, root, "eik"),
        vat: bn_j_str(d, root, "vat"),
        city: bn_j_str(d, root, "city"),
        address: bn_j_str(d, root, "address"),
        email: bn_j_str(d, root, "email"),
        phone: bn_j_str(d, root, "phone"),
        is_customer: bn_j_i64(d, root, "is_customer"),
        is_supplier: bn_j_i64(d, root, "is_supplier"),
        created_at: bn_j_str(d, root, "created_at")
    }
}

fn bn_cp_to_json(c: BnCounterpart) -> JObj {
    let mut o = jobj_new()
    o = jobj_i64(o, "id", c.id)
    o = jobj_str(o, "name", c.name)
    o = jobj_str(o, "eik", c.eik)
    o = jobj_str(o, "vat", c.vat)
    o = jobj_str(o, "city", c.city)
    o = jobj_str(o, "address", c.address)
    o = jobj_str(o, "email", c.email)
    o = jobj_str(o, "phone", c.phone)
    o = jobj_i64(o, "is_customer", c.is_customer)
    o = jobj_i64(o, "is_supplier", c.is_supplier)
    o = jobj_str(o, "created_at", c.created_at)
    return o
}

fn bn_cp_json_str(c: BnCounterpart) -> str {
    return jobj_encode(bn_cp_to_json(c))
}

fn bn_cp_load(db: DrokDB, co: i64, id: i64) -> BnCounterpart !Net !IO {
    let s = bn_get_str(db, bn_k_cp(co, id))?
    if s == "" {
        return bn_cp_zero()
    }
    let d = json_parse(s)
    return bn_cp_from_json(d, bn_j_root(d))
}

fn bn_cp_exists(db: DrokDB, co: i64, id: i64) -> i64 !Net !IO {
    return bn_exists(db, bn_k_cp(co, id))?
}

fn bn_cp_save(db: DrokDB, co: i64, c: BnCounterpart) -> i64 !Net !IO {
    let ids = bn_list_parse(bn_get_str(db, bn_k_cp_all(co))?)
    let n = bn_list_add(ids, int_to_str(c.id))
    let ks: Vec<str> = vec_new()
    let vs: Vec<str> = vec_new()
    vec_push(ks, bn_k_cp(co, c.id))
    vec_push(vs, bn_cp_json_str(c))
    vec_push(ks, bn_k_cp_all(co))
    vec_push(vs, bn_list_encode(n))
    return bn_mset(db, ks, vs)?
}

fn bn_cp_ids(db: DrokDB, co: i64) -> Vec<i64> !Net !IO {
    let raw = bn_list_parse(bn_get_str(db, bn_k_cp_all(co))?)
    let out: Vec<i64> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(raw) {
        vec_push(out, parse_int(vec_get(raw, i)))
        i = i + 1
    }
    return out
}

fn bn_cp_all(db: DrokDB, co: i64) -> Vec<BnCounterpart> !Net !IO {
    let ids = bn_cp_ids(db, co)?
    let out: Vec<BnCounterpart> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(ids) {
        let c = bn_cp_load(db, co, vec_get(ids, i))?
        if c.id > 0 {
            vec_push(out, c)
        }
        i = i + 1
    }
    return out
}

fn bn_cp_delete(db: DrokDB, co: i64, id: i64) -> i64 !Net !IO {
    bn_del(db, bn_k_cp(co, id))?
    let ids = bn_list_parse(bn_get_str(db, bn_k_cp_all(co))?)
    let n = bn_list_del(ids, int_to_str(id))
    return bn_put_str(db, bn_k_cp_all(co), bn_list_encode(n))?
}
