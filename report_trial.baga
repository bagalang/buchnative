// report_trial.baga — оборотна ведомост за период.
//
// Салдата са инкрементални (записани в същия MSET като проводката), така че
// отчетът е един префикс-скан + едно MGET — без обхождане на дневника.

import "store.baga"
import "store_scan.baga"
import "json.baga"
import "money.baga"
import "fmrbaga/jsonx.baga"
import "model_account.baga"
import "model_journal.baga"
import "std/json/json.baga"
import "std/str/str.baga"

struct BnTrialRow {
    code: str,
    name: str,
    cls: i64,
    debit: str,
    credit: str,
    balance: str,
    side: str
}

fn bn_trial_row_zero() -> BnTrialRow {
    return BnTrialRow { code: "", name: "", cls: 0, debit: "0.00", credit: "0.00", balance: "0.00", side: "" }
}

fn bn_trial_row_to_json(r: BnTrialRow) -> JObj {
    let mut o = jobj_new()
    o = jobj_str(o, "code", r.code)
    o = jobj_str(o, "name", r.name)
    o = jobj_i64(o, "cls", r.cls)
    o = jobj_str(o, "debit", r.debit)
    o = jobj_str(o, "credit", r.credit)
    o = jobj_str(o, "balance", r.balance)
    o = jobj_str(o, "side", r.side)
    return o
}

fn bn_trial_rows(db: DrokDB, co: i64, period: str) -> Vec<BnTrialRow> !Net !IO {
    let keys = bn_scan_key_strs(db, bn_k_bal_prefix(co, period))?
    let out: Vec<BnTrialRow> = vec_new()
    let mut i: i64 = 0
    while i < vec_len(keys) {
        let key = vec_get(keys, i)
        let account = substr(key, len(bn_k_bal_prefix(co, period)), len(key))
        let b = bn_bal_load(db, co, period, account)?
        let r = bn_trial_row_zero()
        r.code = account
        r.name = bn_ac_load(db, co, account)?.name
        r.cls = bn_ac_load(db, co, account)?.cls
        r.debit = b.debit
        r.credit = b.credit
        r.balance = b.balance
        r.side = bn_ac_side(r.cls)
        if bn_money_gt(b.debit, bn_money_zero()) == 1 || bn_money_gt(b.credit, bn_money_zero()) == 1 {
            vec_push(out, r)
        }
        i = i + 1
    }
    return out
}

fn bn_trial_json(db: DrokDB, co: i64, period: str) -> JObj !Net !IO {
    let rows = bn_trial_rows(db, co, period)?
    let mut a = jarr_new()
    let mut tdebit = bn_money_zero()
    let mut tcredit = bn_money_zero()
    let mut i: i64 = 0
    while i < vec_len(rows) {
        let r = vec_get(rows, i)
        a = jarr_obj(a, bn_trial_row_to_json(r))
        tdebit = bn_money_add(tdebit, r.debit)
        tcredit = bn_money_add(tcredit, r.credit)
        i = i + 1
    }
    let mut o = jobj_new()
    o = jobj_i64(o, "company", co)
    o = jobj_str(o, "period", period)
    o = jobj_arr(o, "rows", a)
    o = jobj_str(o, "total_debit", tdebit)
    o = jobj_str(o, "total_credit", tcredit)
    if bn_money_eq(tdebit, tcredit) == 1 {
        o = jobj_str(o, "balanced", "1")
    } else {
        o = jobj_str(o, "balanced", "0")
    }
    return o
}

// Оборотна ведомост за цяла година (месец по месец).
fn bn_trial_year_json(db: DrokDB, co: i64, year: str) -> JObj !Net !IO {
    let mut o = jobj_new()
    o = jobj_i64(o, "company", co)
    o = jobj_str(o, "year", year)
    let months: Vec<str> = vec_new()
    vec_push(months, "01")
    vec_push(months, "02")
    vec_push(months, "03")
    vec_push(months, "04")
    vec_push(months, "05")
    vec_push(months, "06")
    vec_push(months, "07")
    vec_push(months, "08")
    vec_push(months, "09")
    vec_push(months, "10")
    vec_push(months, "11")
    vec_push(months, "12")
    let mut a = jarr_new()
    let mut i: i64 = 0
    while i < vec_len(months) {
        let period = concat(year, concat("-", vec_get(months, i)))
        a = jarr_obj(a, bn_trial_json(db, co, period)?)
        i = i + 1
    }
    o = jobj_arr(o, "months", a)
    return o
}
